---
import { faq } from '../data/site.js';
---

<div class="faq" data-stagger="70">
  {faq.map((item, i) => (
    <details class="faq-item" name="faq" data-reveal open={i === 0}>
      <summary>
        <span>{item.q}</span>
        <i class="faq-ic" aria-hidden="true"></i>
      </summary>
      <div class="faq-body"><p>{item.a}</p></div>
    </details>
  ))}
</div>

<style>
  .faq { display: grid; gap: 12px; }

  .faq-item {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: #fff;
    overflow: hidden;
    transition: transform .35s var(--ease-out), border-color .3s var(--ease), box-shadow .3s var(--ease);
  }
  .faq-item:hover { border-color: var(--accent-200); }
  .faq-item[open] { border-color: var(--accent-200); box-shadow: var(--shadow-sm); }

  .faq-item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 20px 22px;
    cursor: pointer;
    list-style: none;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.03rem;
    letter-spacing: -.015em;
    color: var(--text);
  }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item summary:hover { color: var(--black); }

  .faq-ic {
    position: relative;
    flex: none;
    width: 30px; height: 30px;
    border-radius: 50%;
    background: var(--paper);
    border: 1px solid var(--line);
    transition: background .3s var(--ease), border-color .3s var(--ease), transform .4s var(--ease-out);
  }
  .faq-ic::before, .faq-ic::after {
    content: '';
    position: absolute;
    left: 50%; top: 50%;
    width: 12px; height: 2px;
    border-radius: 2px;
    background: var(--text);
    transform: translate(-50%, -50%);
    transition: transform .35s var(--ease-out), opacity .25s var(--ease);
  }
  .faq-ic::after { transform: translate(-50%, -50%) rotate(90deg); }
  .faq-item[open] .faq-ic { background: var(--accent); border-color: var(--accent-600); transform: rotate(180deg); }
  .faq-item[open] .faq-ic::after { opacity: 0; transform: translate(-50%, -50%) rotate(0deg); }

  .faq-body { padding: 0 22px 22px; }
  .faq-body p { color: var(--muted); font-size: .97rem; max-width: 72ch; }
  .faq-item[open] .faq-body { animation: faq-open .45s var(--ease-out) both; }
  @keyframes faq-open {
    from { opacity: 0; transform: translateY(-6px); }
    to   { opacity: 1; transform: none; }
  }
</style>
