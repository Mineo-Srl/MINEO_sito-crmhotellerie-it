---
/* Onde viola/magenta traslucide, in stile bemyguest.it (decorativo). */
interface Props { flip?: boolean; class?: string; }
const { flip = false, class: cls = '' } = Astro.props;
---
<svg class={`waves ${cls}`} class:list={{ flip }} viewBox="0 0 800 900" preserveAspectRatio="xMaxYMid slice" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id="wv1" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#f1c40e"/><stop offset="1" stop-color="#ffd52e"/></linearGradient>
    <linearGradient id="wv2" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#727070" stop-opacity=".45"/><stop offset="1" stop-color="#000000" stop-opacity=".55"/></linearGradient>
    <linearGradient id="wv3" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#f1c40e" stop-opacity=".28"/><stop offset="1" stop-color="#f1c40e" stop-opacity=".1"/></linearGradient>
  </defs>
  <path d="M520 0C470 220 400 380 330 560S210 820 250 900H800V0Z" fill="url(#wv3)"/>
  <path d="M600 0C560 200 500 360 450 540S350 800 380 900H800V0Z" fill="url(#wv2)"/>
  <path d="M690 0C660 180 620 340 580 520S500 790 520 900H800V0Z" fill="url(#wv1)"/>
</svg>
<style>
  .waves { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; z-index: 0; }
  .waves.flip { transform: scaleX(-1); }
</style>
