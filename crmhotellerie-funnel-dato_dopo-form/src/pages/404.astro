---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { site, u } from '../data/site.js';
---

<Base
  title={`Pagina non trovata | ${site.product} — Mineo Srl`}
  description="La pagina che stai cercando non esiste o è stata spostata."
  path="/404"
  noindex={true}
>
  <section class="nf section-dark">
    <div class="grid-lines" aria-hidden="true"></div>
    <div class="container relative nf-in">
      <span class="nf-ic"><Icon name="deskbell" size={34} /></span>
      <p class="eyebrow">Errore 404</p>
      <h1 class="h1">Questa camera non esiste</h1>
      <p class="lead">
        La pagina che cercavi è stata spostata o non è mai esistita. Torna alla home per scoprire come il CRM Hotel riunisce prenotazioni dirette, reparti e adempimenti in un unico sistema Zoho.
      </p>
      <div class="btn-row center mt-4">
        <a href={u('/')} class="btn btn-primary btn-lg">
          Torna alla home
          <Icon name="arrow" size={19} />
        </a>
      </div>
    </div>
  </section>
</Base>

<style>
  .nf {
    display: grid;
    place-items: center;
    min-height: 74vh;
    padding-block: calc(var(--header-h) + 60px) 90px;
    text-align: center;
    overflow: hidden;
  }
  .nf-in { max-width: 640px; }
  .nf-ic {
    display: inline-grid;
    place-items: center;
    width: 76px; height: 76px;
    margin-bottom: 26px;
    border-radius: 22px;
    background: rgba(241,196,14,.12);
    border: 1px solid rgba(241,196,14,.3);
    color: var(--accent);
    animation: float-y 6s ease-in-out infinite;
  }
  .nf .eyebrow { display: flex; justify-content: center; }
  .nf .lead { margin-top: 18px; }
</style>
