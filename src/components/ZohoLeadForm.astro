---
/* Form Zoho Forms (iframe) per sbloccare la demo, nella prima pagina.
   Embed fornito da Zoho: l'iframe e lo script del referrername sono quelli originali. */
---
<div class="zform">
  <iframe id="ziframe_351513" aria-label="Form Hotel Soleluna funnel_1 pagina" frameborder="0" style="height:680px;width:99%;border:none;" src='https://forms.zohopublic.eu/hotelsoleluna1/form/FormHotelSolelunafunnel1pagina/formperma/rdMQBrTx1mdvpEZBTTEHjqjVouaN3IiheFM1_69F9Bs' title="Form per sbloccare la demo" loading="lazy">
  </iframe>
</div>

<style>
  .zform { margin-top: 6px; }
  .zform iframe { display: block; border-radius: var(--radius); }
  @media (max-width: 560px) { .zform iframe { height: 760px !important; } }
</style>

<script type="text/javascript" is:inline>
(function() {
  try {
    var zf_frame = document.getElementById("ziframe_351513");
    var ifrmSrc = zf_frame.src;

        if (!((new RegExp("[?&]referrername=")).test(ifrmSrc))) {
            var rfr = window.location.href;

            try {
                rfr = window.self !== window.top ?
                    window.top.location.href :
                    (/^https?:\/\/[\w.-]+\.[a-zA-Z]{2,}/i.test(rfr) ? rfr : "");
            } catch (e) {}

            if (rfr && rfr !== "") {
                if (rfr.length > 1800) {
                    var queryIndex = rfr.indexOf('?');
                    if (queryIndex > -1) {
                        rfr = rfr.substring(0, queryIndex);
                    }
                    if (rfr.length > 1800) {
                        rfr = rfr.substring(0, 1800);
                    }
                }
                ifrmSrc += ((ifrmSrc.indexOf('?') > 0) ? '&' : '?') + 'referrername=' + encodeURIComponent(rfr);
            }
        }
        if (zf_frame.src !== ifrmSrc) {
            zf_frame.src = ifrmSrc;
        }
  } catch (e) {}
})();
</script>
