---
/* Calcolatore "Quanto vale spostare dieci punti sul diretto?".
   Il risultato principale è subito visibile; il dettaglio arriva con la demo
   (il valore viene ricordato accanto al form e passato a SalesIQ). */
import Icon from './Icon.astro';
import { calcDefaults as d } from '../data/site.js';

const fields = [
  { id: 'rooms', label: 'Camere', min: 5, max: 200, step: 1, value: d.rooms, unit: '' },
  { id: 'occupancy', label: 'Occupazione media annua', min: 20, max: 100, step: 1, value: d.occupancy, unit: '%' },
  { id: 'adr', label: 'Prezzo medio a notte (ADR)', min: 40, max: 600, step: 5, value: d.adr, unit: '€' },
  { id: 'otaShare', label: 'Quota di prenotazioni dai portali', min: 0, max: 100, step: 1, value: d.otaShare, unit: '%' },
  { id: 'commission', label: 'Commissione media dei portali', min: 10, max: 30, step: 1, value: d.commission, unit: '%' },
];
---

<section class="section calc-sec" id="calcolatore">
  <div class="container">
    <div class="section-head center" data-reveal>
      <p class="eyebrow">Fai due conti</p>
      <h2 class="h2">Quanto vale spostare <span class="gradient-text">dieci punti sul diretto?</span></h2>
      <p class="lead">Muovi i cursori con i numeri del tuo hotel. Restano nel tuo browser: non li inviamo a nessuno.</p>
    </div>

    <div class="calc" data-reveal="scale">
      <form class="calc-in" id="calcForm" onsubmit="return false">
        {fields.map((f) => (
          <label class="cf">
            <span class="cf-top">
              <span>{f.label}</span>
              <output id={`o-${f.id}`}>{f.unit === '€' ? `${f.value} €` : `${f.value}${f.unit}`}</output>
            </span>
            <input type="range" id={f.id} name={f.id} min={f.min} max={f.max} step={f.step} value={f.value} data-unit={f.unit} />
          </label>
        ))}
      </form>

      <div class="calc-out" aria-live="polite">
        <p class="co-lbl">Commissioni pagate ai portali ogni anno</p>
        <p class="co-big"><span id="cCommissions">—</span></p>
        <div class="co-bar"><span id="cBar"></span></div>
        <div class="co-save">
          <Icon name="wallet" size={22} />
          <p>Spostando <b>10 punti</b> sul canale diretto risparmieresti circa <b id="cSaving">—</b> l’anno.</p>
        </div>
        <p class="co-note">Stima indicativa: camere × occupazione × 365 × ADR × quota portali × commissione.</p>
        <a href="/demo" class="btn btn-primary btn-lg co-cta" id="calcCta">Vedi come recuperarle nella demo <Icon name="arrow" size={18} /></a>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    var form = document.getElementById('calcForm');
    if (!form) return;
    var eur = new Intl.NumberFormat('it-IT', { style: 'currency', currency: 'EUR', maximumFractionDigits: 0 });
    var $ = function (id) { return document.getElementById(id); };
    var used = false, last = 0;

    function animateTo(el, to) {
      var from = parseFloat(el.dataset.v || '0'), t0 = null;
      el.dataset.v = to;
      var step = function (t) {
        if (!t0) t0 = t;
        var p = Math.min((t - t0) / 500, 1), e = 1 - Math.pow(1 - p, 3);
        el.textContent = eur.format(from + (to - from) * e);
        if (p < 1) requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
    }

    function calc() {
      var v = {};
      ['rooms', 'occupancy', 'adr', 'otaShare', 'commission'].forEach(function (k) {
        var input = $(k);
        v[k] = parseFloat(input.value);
        var u = input.getAttribute('data-unit');
        $('o-' + k).textContent = u === '€' ? v[k] + ' €' : v[k] + u;
        input.style.setProperty('--p', ((input.value - input.min) / (input.max - input.min)) * 100 + '%');
      });
      var revenue = v.rooms * (v.occupancy / 100) * 365 * v.adr;
      var commissions = revenue * (v.otaShare / 100) * (v.commission / 100);
      var saving = revenue * (Math.min(10, v.otaShare) / 100) * (v.commission / 100);
      animateTo($('cCommissions'), commissions);
      animateTo($('cSaving'), saving);
      $('cBar').style.width = Math.min(100, v.otaShare) + '%';
      last = commissions;
      try {
        sessionStorage.setItem('crmh_calc', JSON.stringify({
          rooms: v.rooms, occupancy: v.occupancy, adr: v.adr, otaShare: v.otaShare, commission: v.commission,
          commissions: Math.round(commissions), saving: Math.round(saving), commissionsLabel: eur.format(commissions),
        }));
      } catch (e) {}
      var rc = $('rqCalc');
      if (rc) { $('rqCalcVal').textContent = eur.format(commissions); rc.hidden = false; }
    }

    form.addEventListener('input', function () {
      calc();
      if (!used) {
        used = true;
        if (typeof window.crmhTrack === 'function') window.crmhTrack('calcolatore_usato');
        if (typeof window.crmhSalesiq === 'function') window.crmhSalesiq('calcolatore_usato');
      }
    });
    $('calcCta').addEventListener('click', function () {
      if (typeof window.crmhTrack === 'function') window.crmhTrack('calcolatore_cta', { commissioni: Math.round(last) });
      try { window.$zoho && $zoho.salesiq && $zoho.salesiq.visitor && $zoho.salesiq.visitor.info({ 'Commissioni OTA stimate': eur.format(last) }); } catch (e) {}
    });
    calc();
  })();
</script>

<style>
  .calc {
    display: grid;
    grid-template-columns: 1.1fr .9fr;
    border-radius: var(--radius-xl);
    overflow: hidden;
    border: 1px solid var(--line);
    box-shadow: var(--shadow-lg);
    background: #fff;
  }
  .calc-in { display: grid; gap: 22px; padding: clamp(24px, 4vw, 44px); }
  .cf { display: grid; gap: 10px; }
  .cf-top { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; font-weight: 600; font-size: .95rem; }
  .cf output { font-family: var(--font-display); font-weight: 800; font-size: 1.15rem; font-variant-numeric: tabular-nums; }
  .cf input[type=range] {
    -webkit-appearance: none; appearance: none; width: 100%; height: 8px; border-radius: 8px; cursor: pointer;
    background: linear-gradient(90deg, var(--accent) var(--p, 50%), var(--grey-100) var(--p, 50%));
  }
  .cf input[type=range]::-webkit-slider-thumb {
    -webkit-appearance: none; width: 24px; height: 24px; border-radius: 50%;
    background: #000; border: 4px solid var(--accent); box-shadow: 0 4px 12px rgba(0,0,0,.25);
    transition: transform .2s var(--ease-out);
  }
  .cf input[type=range]::-webkit-slider-thumb:hover { transform: scale(1.15); }
  .cf input[type=range]::-moz-range-thumb { width: 18px; height: 18px; border-radius: 50%; background: #000; border: 4px solid var(--accent); }

  .calc-out {
    position: relative;
    display: flex; flex-direction: column;
    padding: clamp(24px, 4vw, 44px);
    background: radial-gradient(500px 300px at 100% 0%, rgba(176,223,247,.22), transparent 60%), linear-gradient(180deg, #000, var(--ink-2));
    color: #fff;
  }
  .co-lbl { color: var(--muted-dark); font-size: .9rem; font-weight: 600; letter-spacing: .02em; }
  .co-big { margin-top: 6px; font-family: var(--font-display); font-weight: 800; font-size: clamp(2.4rem, 5vw, 3.6rem); line-height: 1; letter-spacing: -.03em; color: var(--accent); font-variant-numeric: tabular-nums; }
  .co-bar { margin-top: 18px; height: 10px; border-radius: 10px; background: rgba(255,255,255,.1); overflow: hidden; }
  .co-bar span { display: block; height: 100%; width: 60%; border-radius: 10px; background: linear-gradient(90deg, #fff, var(--accent)); transition: width .5s var(--ease-out); }
  .co-save { display: flex; gap: 12px; align-items: flex-start; margin-top: 26px; padding: 16px 18px; border-radius: 16px; background: rgba(255,255,255,.06); border: 1px solid rgba(255,255,255,.12); }
  .co-save :global(svg) { color: var(--accent); flex: none; margin-top: 2px; }
  .co-save p { color: #fff; font-size: 1rem; line-height: 1.5; }
  .co-save b { color: var(--accent); }
  .co-note { margin-top: 14px; font-size: .78rem; color: var(--muted-dark); }
  .co-cta { margin-top: auto; align-self: flex-start; }
  .calc-out .co-note { margin-bottom: 24px; }
  @media (max-width: 900px) { .calc { grid-template-columns: 1fr; } }
</style>
