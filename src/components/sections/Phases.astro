---
/* Come funziona: le 7 app raggruppate nei tre momenti del percorso dell'ospite. */
import Icon from '../Icon.astro';
import { apps, phases } from '../../data/apps.js';

interface Props { more?: boolean; paper?: boolean; eyebrow?: string }
const { more = false, paper = true, eyebrow = 'Come funziona' } = Astro.props;
const byPhase = Object.keys(phases).map((k) => ({ key: k, label: phases[k], items: apps.filter((a) => a.phase === k) }));
---

<section class:list={['section', { 'section-paper': paper }]} id="percorso">
  <div class="container">
    <div class="section-head center" data-reveal>
      <p class="eyebrow">{eyebrow}</p>
      <h2 class="h2">Tre momenti, <span class="gradient-text">sette app che lavorano per te</span></h2>
      <p class="lead">Prima che prenoti, quando ti contatta, dopo che è ripartito. Ogni app ha la sua pagina.</p>
    </div>
    <div class="phases" data-stagger="140">
      {byPhase.map((ph, i) => (
        <div class="phase" data-reveal>
          <p class="ph-n"><span>{i + 1}</span> {ph.label}</p>
          <div class="ph-apps">
            {ph.items.map((a) => (
              <a href={`/${a.slug}`} class="ph-app">
                <span class="ph-ic"><Icon name={a.icon} size={18} /></span>
                <span class="ph-txt"><b>{a.name}</b><small>{a.menu}</small></span>
                <Icon name="arrow" size={16} />
              </a>
            ))}
          </div>
        </div>
      ))}
    </div>
    {more && (
      <div class="ph-more" data-reveal>
        <a href="/come-funziona" class="btn btn-dark">Come lavorano insieme <Icon name="arrow" size={17} /></a>
        <a href="/app" class="link-arrow">Tutte le app <Icon name="arrow" size={16} /></a>
      </div>
    )}
  </div>
</section>

<style>
  .phases { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 22px; }
  .phase { position: relative; padding: 24px; border-radius: var(--radius-lg); background: #fff; border: 1px solid var(--line); }
  .phase:not(:last-child)::after { content: ''; position: absolute; right: -22px; top: 40px; width: 22px; height: 2px; background: var(--accent-600); }
  .ph-n { display: flex; align-items: center; gap: 10px; margin-bottom: 16px; font-family: var(--font-display); font-weight: 800; font-size: 1.1rem; }
  .ph-n span { display: grid; place-items: center; width: 32px; height: 32px; border-radius: 50%; background: var(--black); color: var(--accent); font-size: .9rem; }
  .ph-apps { display: grid; gap: 10px; }
  .ph-app { display: flex; align-items: center; gap: 12px; padding: 14px; border-radius: 14px; background: var(--paper); border: 1px solid transparent; transition: border-color .25s var(--ease), background .25s var(--ease), transform .3s var(--ease-out); }
  .ph-app:hover { border-color: var(--accent); background: var(--accent-50); transform: translateX(3px); }
  .ph-ic { display: grid; place-items: center; width: 38px; height: 38px; flex: none; border-radius: 11px; background: var(--accent); }
  .ph-txt { flex: 1; min-width: 0; }
  .ph-txt b { display: block; font-size: .98rem; }
  .ph-txt small { display: block; font-size: .82rem; color: var(--muted); }
  .ph-app > :global(svg:last-child) { color: var(--muted); }
  .ph-more { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 16px 28px; margin-top: 36px; }
  @media (max-width: 960px) { .phases { grid-template-columns: 1fr; } .phase::after { display: none; } }
</style>
