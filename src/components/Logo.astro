---
import { u } from '../data/site.js';

interface Props {
  light?: boolean;
  class?: string;
  height?: number;
}
const { light = false, class: cls = '', height = 38 } = Astro.props;
const src = u(light ? '/img/logo-mineo-light.png' : '/img/logo-mineo.png');
---
<span class={`logo ${cls}`}>
  <img
    src={src}
    alt="Mineo Srl"
    width={Math.round((height * 800) / 300)}
    height={height}
    style={`height:${height}px`}
    class="logo-img"
    loading="eager"
    decoding="async"
  />
</span>

<style>
  .logo { display: inline-flex; align-items: center; }
  .logo-img {
    width: auto;
    transition: transform .5s cubic-bezier(.16,1,.3,1);
  }
  :global(a:hover) > .logo .logo-img { transform: scale(1.035); }
</style>
