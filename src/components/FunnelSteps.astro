---
import Icon from './Icon.astro';
import { funnelSteps } from '../data/site.js';

interface Props {
  /* passo corrente: 2 = demo, 3 = consulenza, 4 = tutto completato */
  current: 2 | 3 | 4;
}
const { current } = Astro.props;
---
<ol class="fs" aria-label="Avanzamento">
  {funnelSteps.map((st) => {
    const done = st.n < current;
    const now = st.n === current;
    return (
      <li class:list={{ done, now }}>
        <span class="fs-n">{done ? <Icon name="check" size={15} stroke={3.4} /> : st.n}</span>
        <span class="fs-l">{st.label}</span>
      </li>
    );
  })}
</ol>

<style>
  .fs { display: flex; align-items: center; gap: 0; max-width: 460px; margin-bottom: 26px; }
  .fs li { display: flex; align-items: center; gap: 9px; flex: 1; color: var(--grey); font-family: var(--font-display); font-weight: 700; letter-spacing: .08em; text-transform: uppercase; font-size: .86rem; }
  .fs li:not(:last-child)::after { content: ''; flex: 1; height: 3px; margin-inline: 12px; border-radius: 3px; background: var(--grey-100); }
  .fs li.done:not(:last-child)::after { background: var(--accent); }
  .fs-n { display: grid; place-items: center; width: 30px; height: 30px; flex: none; border-radius: 50%; background: var(--grey-100); color: var(--grey); font-size: .95rem; }
  .fs li.done .fs-n, .fs li.now .fs-n { background: var(--accent); color: #000; }
  .fs li.now { color: var(--ink); }
  .fs li.done { color: var(--ink); }
  .fs li.now .fs-n { box-shadow: 0 0 0 5px rgba(241,196,14,.3); }
  @media (max-width: 520px) { .fs-l { display: none; } .fs li:last-child .fs-l, .fs li.now .fs-l { display: inline; } }
</style>
