---
import Icon from './Icon.astro';
import { site } from '../data/site.js';

interface Props {
  title: string;
  text?: string;
  label?: string;
  id: string;
  dark?: boolean;
  href?: string;
}
const { title, text, label = 'Sblocca la demo', id, dark = true, href = '#demo' } = Astro.props;
---
<aside class={`ctaband ${dark ? 'is-dark' : ''}`} data-reveal>
  <div>
    <p class="ctaband-t">{title}</p>
    {text && <p class="ctaband-p">{text}</p>}
  </div>
  <div class="ctaband-act">
    <a href={href} class="btn btn-primary btn-lg" data-cta={id} {...(href.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {})}>{label} <Icon name="arrow" size={18} /></a>
  </div>
</aside>

<style>
  .ctaband { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 18px 32px; margin-top: clamp(28px, 4vw, 44px); padding: 24px clamp(22px, 3vw, 36px); border-radius: var(--radius-xl); background: var(--accent-50); border: 1px solid var(--accent-200); }
  .ctaband.is-dark { background: #000; border-color: #000; }
  .ctaband-t { font-family: var(--font-display); font-size: clamp(1.3rem, 2.3vw, 1.75rem); font-weight: 700; line-height: 1.15; color: var(--ink); }
  .ctaband-p { margin-top: 4px; font-size: .96rem; color: var(--muted); }
  .is-dark .ctaband-t { color: #fff; } .is-dark .ctaband-p { color: var(--muted-dark); }
  .ctaband-act { display: flex; flex-wrap: wrap; align-items: center; gap: 14px 22px; }
  .ctaband-tel { display: inline-flex; align-items: center; gap: 8px; font-family: var(--font-display); font-weight: 700; letter-spacing: .04em; color: var(--ink); }
  .is-dark .ctaband-tel { color: #fff; }
  .ctaband-tel:hover { color: var(--accent-700); } .is-dark .ctaband-tel:hover { color: var(--accent); }
  @media (max-width: 640px) { .ctaband-act .btn { width: 100%; white-space: normal; text-align: center; } }
</style>
