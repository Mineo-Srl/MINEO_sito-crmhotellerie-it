const body = art[name] || '';
---
<svg class={`illo ${cls}`} viewBox="0 0 240 200" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={body} />

<style>
  .illo { display: block; width: 100%; height: auto; overflow: visible; }
  .illo :global(.ac) { fill: var(--illo-accent, var(--teal)); fill-opacity: var(--illo-accent-op, .9); }
  .illo :global(.cut) { fill: #fff; }
  .illo :global(.bg) { fill: var(--illo-bg, #fff); }
</style>
