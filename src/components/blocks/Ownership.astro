---
import { dataOwnership } from '../../data/site.js';
interface Props { title?: string }
const { title = 'Chi possiede i dati?' } = Astro.props;
---
<div class="own">
  <h3 class="h3">{title}</h3>
  <div class="table-wrap">
    <table class="data-table">
      <thead><tr><th>Dato</th><th class="hi">CRM Hotellerie</th><th>Booking engine chiuso (di norma)</th></tr></thead>
      <tbody>{dataOwnership.map(([a, b, c]) => <tr><td>{a}</td><td class="hi">{b}</td><td>{c}</td></tr>)}</tbody>
    </table>
  </div>
</div>
<style>.own .h3 { margin-bottom: 18px; }</style>
