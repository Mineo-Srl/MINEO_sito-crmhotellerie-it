---
const steps = [
  ['Richiesta', 'Da sito, telefono, email o di persona: stesso flusso.'],
  ['Opzionata', 'Camera bloccata, con promemoria prima della scadenza.'],
  ['Confermata', 'Mail automatica all’ospite, stato aggiornato in CRM.'],
  ['Prima dell’arrivo', 'Servizi extra proposti e check-in online.'],
  ['Dopo la partenza', 'Survey, segmenti e campagne mirate.'],
];
interface Props { title?: string }
const { title = 'Dalla richiesta al ritorno: le automazioni' } = Astro.props;
---
<div class="auto">
  {title && <h3 class="h3">{title}</h3>}
  <ol class="auto-steps">
    {steps.map(([t, d], i) => (
      <li class:list={['card', { dark: i === steps.length - 1 }]}>
        <span class="auto-n">{i + 1}</span>
        <strong>{t}</strong>
        <p>{d}</p>
      </li>
    ))}
  </ol>
</div>
<style>
  .auto .h3 { margin-bottom: 20px; }
  .auto-steps { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 12px; counter-reset: s; }
  .auto-steps li { padding: 20px; position: relative; }
  .auto-steps li:not(:last-child)::after { content: ''; position: absolute; right: -10px; top: 32px; width: 8px; height: 2px; background: var(--yellow); }
  .auto-n { display: block; font-family: var(--font-head); font-weight: 700; font-size: 1.6rem; color: var(--olive); line-height: 1; margin-bottom: 10px; }
  .card.dark .auto-n { color: #fff; }
  .auto-steps strong { display: block; font-size: 1.02rem; margin-bottom: 6px; }
  .auto-steps p { font-size: .9rem; }
  @media (max-width: 980px) { .auto-steps { grid-template-columns: 1fr 1fr; } .auto-steps li::after { display: none; } }
  @media (max-width: 520px) { .auto-steps { grid-template-columns: 1fr; } }
</style>
