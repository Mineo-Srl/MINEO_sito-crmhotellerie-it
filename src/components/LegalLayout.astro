---
/* Struttura comune di Privacy Policy e Cookie Policy (testi ripresi da crmhotelleriesito). */
import Base from '../layouts/Base.astro';
import PageHero from './PageHero.astro';
interface Props { title: string; description: string; lead: string; updated: string; toc: Array<[string, string]> }
const { title, description, lead, updated, toc } = Astro.props;
---
<Base title={title} description={description}>
  <PageHero eyebrow="Note legali" title={title} lead={lead} crumbs={[{ label: title }]} ctas={false}>
    <p slot="below" class="small muted upd">Ultimo aggiornamento: {updated}</p>
  </PageHero>
  <section class="section-sm">
    <div class="container lgrid">
      <nav class="toc" aria-label="Indice della pagina">
        <p class="label">In questa pagina</p>
        <ul>{toc.map(([id, label]) => <li><a href={`#${id}`}>{label}</a></li>)}</ul>
      </nav>
      <article class="prose"><slot /></article>
    </div>
  </section>
</Base>
<style>
  .upd { margin-top: 16px; }
  .lgrid { display: grid; grid-template-columns: 240px minmax(0, 1fr); gap: clamp(32px, 5vw, 64px); align-items: start; }
  .toc { position: sticky; top: calc(var(--header-h) + 20px); padding: 20px; border-radius: var(--radius); background: var(--paper); }
  .toc ul { display: grid; gap: 8px; }
  .toc a { font-size: .9rem; color: var(--muted); }
  .toc a:hover { color: var(--text); }
  @media (max-width: 900px) { .lgrid { grid-template-columns: 1fr; } .toc { position: static; } }
</style>
