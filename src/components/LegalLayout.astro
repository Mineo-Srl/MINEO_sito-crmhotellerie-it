---
/* Struttura comune di Privacy Policy e Cookie Policy: testata, indice laterale, testo. */
import Base from '../layouts/Base.astro';

interface Props {
  title: string;
  description: string;
  lead: string;
  updated: string;
  toc: Array<[string, string]>;
}
const { title, description, lead, updated, toc } = Astro.props;
---

<Base title={title} description={description} breadcrumbs={[{ name: title }]}>
  <section class="legal-hero section-dark">
    <div class="grid-lines" aria-hidden="true"></div>
    <div class="container relative">
      <p class="eyebrow rise">Note legali</p>
      <h1 class="h1 rise" style="--d:100ms">{title}</h1>
      <p class="lead rise" style="--d:200ms">{lead}</p>
      <p class="updated rise" style="--d:280ms">Ultimo aggiornamento: {updated}</p>
    </div>
  </section>

  <section class="section">
    <div class="container legal-grid">
      <nav class="toc" aria-label="Indice della pagina">
        <p class="toc-title">In questa pagina</p>
        <ul>{toc.map(([id, label]) => <li><a href={`#${id}`}>{label}</a></li>)}</ul>
      </nav>
      <article class="prose"><slot /></article>
    </div>
  </section>
</Base>

<style>
  .legal-hero { padding-block: clamp(56px, 7vw, 96px); }
  .legal-hero .lead { margin-top: 18px; max-width: 70ch; }
  .updated { margin-top: 16px; font-size: .88rem; }
  .legal-grid { display: grid; grid-template-columns: 240px minmax(0, 1fr); gap: clamp(32px, 5vw, 64px); align-items: start; }
  .toc { position: sticky; top: 100px; padding: 20px; border-radius: var(--radius); background: var(--paper); }
  .toc-title { font-size: .76rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; margin-bottom: 12px; }
  .toc ul { display: grid; gap: 8px; }
  .toc a { font-size: .9rem; color: var(--muted); transition: color .2s var(--ease); }
  .toc a:hover { color: var(--text); }
  @media (max-width: 900px) {
    .legal-grid { grid-template-columns: 1fr; }
    .toc { position: static; }
  }
</style>
