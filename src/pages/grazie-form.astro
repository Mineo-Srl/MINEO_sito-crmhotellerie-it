---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Waves from '../components/Waves.astro';
import { site, u, funnelPaths } from '../data/site.js';
---

<Base
  title={`Grazie, richiesta ricevuta | ${site.product}`}
  description="Abbiamo ricevuto i tuoi dati: ti rispondiamo il prima possibile."
  path={funnelPaths.formThanks}
  noindex={true}
  minimal={true}
>
  <section class="ty">
    <Waves />
    <div class="container ty-in">
      <div class="ty-main">
        <span class="ty-check rise"><Icon name="check" size={34} stroke={3} /></span>
        <p class="eyebrow rise" style="--d:80ms">Richiesta ricevuta</p>
        <h1 class="display rise" style="--d:140ms">Grazie<span id="tyName"></span>, <strong>abbiamo i tuoi dati</strong></h1>
        <p class="lead rise" style="--d:220ms">
          Rispondiamo <b>il prima possibile</b> per organizzare la demo e la consulenza gratuita.
        </p>

        <div class="btn-row rise" style="--d:300ms">
          <a href={site.bookingUrl} class="btn btn-primary btn-lg" target="_blank" rel="noopener" data-cta="formthanks-booking">Scegli tu l’orario <Icon name="arrow" size={18} /></a>
        </div>
        <p class="ty-hint rise" style="--d:380ms">Preferisci non aspettare? Prenota tu stesso il momento della consulenza dal nostro calendario.</p>
      </div>
    </div>
  </section>

  <section class="section section-paper" style="padding-block: clamp(36px, 5vw, 60px)">
    <div class="container">
      <div class="ty-contact" data-reveal>
        <p><b>Hai fretta?</b> Scrivici su WhatsApp o per email.</p>
        <div>
          <a href={`https://wa.me/${site.whatsappHref}`} class="btn btn-ghost" target="_blank" rel="noopener noreferrer" data-cta="formthanks-whatsapp"><Icon name="whatsapp" size={17} /> WhatsApp</a>
          <a href={`mailto:${site.email}`} class="btn btn-ghost" data-cta="formthanks-mail"><Icon name="mail" size={17} /> Email</a>
          <a href={u('/')} class="link-arrow">Torna al sito <Icon name="arrow" size={16} /></a>
        </div>
      </div>
    </div>
  </section>
</Base>

<script is:inline>
  /* il form Zoho è in un iframe: se la pagina si carica lì dentro, esce dall'iframe */
  (function () { try { if (window.top !== window.self) window.top.location.href = window.location.href; } catch (e) {} })();
</script>

<style>
  .ty { position: relative; overflow: hidden; padding-block: calc(var(--header-h) + clamp(40px, 6vw, 80px)) clamp(60px, 8vw, 100px); }
  .ty-in { position: relative; z-index: 2; }
  .ty-main { max-width: 700px; }
  .ty-check { display: inline-grid; place-items: center; width: 72px; height: 72px; margin-bottom: 22px; border-radius: 50%; background: var(--accent); color: #000; box-shadow: var(--shadow-accent); }
  .ty .lead { margin-top: 18px; }
  .ty .lead b { color: var(--ink); font-weight: 700; }
  .ty .btn-row { margin-top: 30px; }
  .ty-hint { margin-top: 14px; font-size: .9rem; color: var(--muted); }
  .ty-contact { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px 28px; padding: 22px 28px; border-radius: var(--radius-xl); background: var(--accent-50); border: 1px solid var(--accent-200); }
  .ty-contact p { font-family: var(--font-display); font-size: 1.3rem; }
  .ty-contact > div { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 18px; }
</style>

<script is:inline>
  (function () {
    try {
      var lead = JSON.parse(sessionStorage.getItem('crmhotel_lead') || 'null');
      if (lead && lead.nome) document.getElementById('tyName').textContent = ' ' + String(lead.nome).trim().split(/\s+/)[0];
    } catch (e) {}
    window.dataLayer = window.dataLayer || [];
    window.dataLayer.push({ event: 'form_thank_you' });
  })();
</script>
