---
/* Capitolo 1 · Il problema: perché un hotel perde margine sugli ospiti che ha già. */
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import PageHead from '../components/PageHead.astro';
import Pains from '../components/sections/Pains.astro';
import Calculator from '../components/Calculator.astro';
import NextPage from '../components/NextPage.astro';
import { perche } from '../data/pages.js';
---

<Base
  title="Perché i portali ti costano due volte lo stesso ospite"
  description="L’ospite che torna e riprenota dal portale ti costa una seconda commissione. Ecco perché succede e quanto vale per il tuo hotel recuperarlo sul canale diretto."
  keywords={['commissioni OTA hotel', 'disintermediazione hotel', 'prenotazioni dirette', 'ospiti di ritorno']}
  breadcrumbs={[{ name: 'Perché' }]}
>
  <PageHead
    eyebrow="Il problema"
    crumb="Perché"
    title="Il portale ti porta l’ospite. "
    highlight="Poi se lo tiene."
    lead="Le OTA sono utili per farti trovare. Il problema nasce dopo: l’ospite che hai già conquistato, la volta successiva, prenota di nuovo da loro. E tu paghi di nuovo."
    photo="/img/photos/ombrelloni.webp"
  />

  <!-- I numeri -->
  <section class="section-sm">
    <div class="container">
      <div class="costs" data-stagger="120">
        {perche.costs.map((c) => (
          <div class="cost" data-reveal>
            <b>{c.value}</b>
            <span>{c.label}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- La storia di Giulia -->
  <section class="section section-paper">
    <div class="container">
      <div class="section-head" data-reveal>
        <p class="eyebrow">Una storia che conosci</p>
        <h2 class="h2">Giulia è già tua. <span class="gradient-text">Ma non lo sai.</span></h2>
      </div>
      <ol class="story" data-stagger="160">
        {perche.story.map((s, i) => (
          <li data-reveal class:list={{ last: i === perche.story.length - 1 }}>
            <span class="st-n">{i + 1}</span>
            <b>{s.when}</b>
            <p>{s.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <Pains />

  <div class="section-paper"><Calculator /></div>

  <!-- Cosa cambia -->
  <section class="section">
    <div class="container">
      <div class="section-head center" data-reveal>
        <p class="eyebrow">Cosa cambia</p>
        <h2 class="h2">Quando sei tu a <span class="gradient-text">conoscere l’ospite</span></h2>
      </div>
      <ul class="shift" data-stagger="100">
        {perche.shift.map((s) => (
          <li data-reveal>
            <span class="sh-from">{s.from}</span>
            <span class="sh-arrow" aria-hidden="true"><Icon name="arrow" size={20} stroke={2.2} /></span>
            <span class="sh-to">{s.to}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <NextPage current="/perche" />
</Base>

<style>
  .costs { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; }
  .cost { padding: 28px; border-radius: var(--radius-lg); background: var(--black); color: #fff; }
  .cost b { display: block; font-family: var(--font-display); font-weight: 800; font-size: clamp(2.2rem, 4vw, 3rem); line-height: 1; color: var(--accent); letter-spacing: -.03em; }
  .cost span { display: block; margin-top: 12px; color: var(--muted-dark); }
  @media (max-width: 860px) { .costs { grid-template-columns: 1fr; } }

  .story { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; }
  .story li { position: relative; padding: 28px; border-radius: var(--radius-lg); background: #fff; border: 1px solid var(--line); }
  .story li:not(.last)::after { content: ''; position: absolute; right: -24px; top: 50px; width: 24px; height: 2px; background: var(--accent-600); }
  .story li.last { background: var(--black); border-color: var(--black); }
  .story li.last b { color: var(--accent); }
  .story li.last p { color: var(--muted-dark); }
  .st-n { display: grid; place-items: center; width: 42px; height: 42px; margin-bottom: 16px; border-radius: 50%; background: var(--accent); font-family: var(--font-display); font-weight: 800; }
  .story b { display: block; font-family: var(--font-display); font-size: 1.15rem; }
  .story p { margin-top: 8px; color: var(--muted); }
  @media (max-width: 900px) { .story { grid-template-columns: 1fr; } .story li::after { display: none; } }

  .shift { display: grid; gap: 12px; max-width: 900px; margin-inline: auto; }
  .shift li { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 18px; padding: 18px 22px; border-radius: var(--radius); border: 1px solid var(--line); background: #fff; }
  .sh-from { color: var(--muted); text-decoration: line-through; text-decoration-color: var(--grey-300); }
  .sh-arrow { display: grid; place-items: center; width: 40px; height: 40px; border-radius: 50%; background: var(--black); color: var(--accent); }
  .sh-to { font-weight: 650; }
  @media (max-width: 700px) { .shift li { grid-template-columns: 1fr; gap: 8px; } .sh-arrow { transform: rotate(90deg); } }
</style>
