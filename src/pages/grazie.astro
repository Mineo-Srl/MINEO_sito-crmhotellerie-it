---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { guide, site } from '../data/site.js';
---
<Base title="Grazie" description="La tua guida CRM Hotellerie è pronta." noindex>
  <section class="section section-dark">
    <div class="container ty">
      <span class="ok"><Icon name="check" size={34} /></span>
      <p class="eyebrow">Richiesta ricevuta</p>
      <h1 class="h1">Grazie. <span class="y">La guida è pronta.</span></h1>
      <p class="lead">Scaricala qui sotto. Quando vuoi vederla applicata alla tua struttura, prenota una demo gratuita con il team Mineo.</p>
      <div class="btn-row">
        <a class="btn btn-primary" href={guide.pdf} download><Icon name="download" size={18} /> Scarica il PDF ({guide.size})</a>
        <a class="btn btn-ghost" href="/demo/">Prenota la demo</a>
      </div>
      <p class="small next">Oppure esplora subito <a href={site.demoUrl} target="_blank" rel="noopener">l’hotel dimostrativo</a>.</p>
    </div>
  </section>
</Base>
<style>
  .ty { max-width: 860px; }
  .ok { display: grid; place-items: center; width: 70px; height: 70px; border-radius: 50%; background: var(--yellow); color: #fff; margin-bottom: 26px; }
  .ty .lead { margin-top: 20px; }
  .next { margin-top: 24px; }
  .next a { color: var(--teal); text-decoration: underline; }
</style>
