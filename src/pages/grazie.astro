---
/* Pagina dopo il form (redirect da impostare in Zoho Forms): la promessa
   mantenuta. La demo è sbloccata, la guida è pronta, la consulenza è il
   passo successivo. Non indicizzata. */
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { site, guide, whatsappUrl } from '../data/site.js';
import { apps as appList } from '../data/apps.js';

const tasks = [
  { icon: 'search', title: 'Prenota come un ospite', text: 'Apri Hotel Soleluna, scegli date e camera e usa il widget come farebbe un tuo cliente.' },
  { icon: 'users', title: 'Guarda dall’altra parte', text: 'Quella richiesta arriva nel CRM completa, assegnata e con i consensi. In consulenza te la mostriamo in diretta.' },
  { icon: 'wallet', title: 'Pensa ai tuoi numeri', text: 'Quanti ospiti di ritorno prenotano oggi dai portali? È lì che si recupera il margine.' },
];
---

<Base
  title="La demo è sbloccata"
  description="La demo di CRM Hotellerie è sbloccata: apri Hotel Soleluna, scarica la guida e, se vuoi, prenota una consulenza gratuita."
  noindex={true}
>
  <section class="ty section-dark">
    <div class="grid-lines" aria-hidden="true"></div>
    <div class="confetti" aria-hidden="true">
      {Array.from({ length: 26 }).map((_, i) => (
        <i style={`--x:${(i * 37) % 100}%;--d:${(i % 9) * 0.35}s;--r:${(i * 47) % 360}deg;--s:${0.7 + (i % 4) * 0.2}`}></i>
      ))}
    </div>
    <div class="container relative ty-grid">
      <div>
        <span class="ty-check rise">
          <svg viewBox="0 0 52 52" width="44" height="44" aria-hidden="true">
            <path d="M14 27l8 8 16-17" fill="none" stroke="#000" stroke-width="5" stroke-linecap="round" stroke-linejoin="round" pathLength="1" />
          </svg>
        </span>
        <p class="eyebrow rise" style="--d:80ms">Demo sbloccata</p>
        <h1 class="display rise" style="--d:140ms">La demo è sbloccata<span id="tyNome"></span>: <span class="gradient-text">Hotel Soleluna ti aspetta</span></h1>
        <p class="lead rise" style="--d:220ms">È il nostro hotel dimostrativo: sito, widget di prenotazione e CRM collegati. Si apre in una nuova scheda, questa pagina resta qui ad aspettarti.</p>
        <div class="btn-row rise" style="--d:300ms">
          <a href={site.demoUrl} class="btn btn-primary btn-lg" target="_blank" rel="noopener" id="tyDemo"><Icon name="key" size={18} /> Apri la demo</a>
          <a href={guide.pdf} class="btn btn-ghost btn-lg" download id="tyDownload"><Icon name="document" size={18} /> Scarica anche la guida</a>
        </div>
        <p class="ty-meta rise" style="--d:360ms">Guida PDF · {guide.pages} pagine · {guide.size}</p>
      </div>
      <a href={site.demoUrl} class="ty-demo rise" style="--d:260ms" target="_blank" rel="noopener" aria-label="Apri la demo di Hotel Soleluna">
        <span class="ty-browser"><i></i><i></i><i></i><em>hotelsoleluna.crmhotellerie.it</em></span>
        <img src="/img/photos/davanti-mare.webp" alt="Hotel Soleluna, l’hotel dimostrativo" />
        <span class="ty-open">Apri <Icon name="arrowUpRight" size={16} /></span>
      </a>
    </div>
  </section>

  <section class="section section-paper">
    <div class="container">
      <div class="section-head center" data-reveal>
        <p class="eyebrow">Cosa provare</p>
        <h2 class="h2">Tre cose da guardare <span class="gradient-text">nella demo</span></h2>
      </div>
      <div class="grid grid-3" data-stagger="120">
        {tasks.map((t, i) => (
          <article class="card" data-reveal>
            <span class="icon-chip"><Icon name={t.icon} /></span>
            <h3 class="h4">{i + 1} · {t.title}</h3>
            <p>{t.text}</p>
          </article>
        ))}
      </div>
      <div class="ty-next" data-reveal>
        <div>
          <p class="eyebrow">Il prossimo passo</p>
          <h3 class="h3">Ti è piaciuto? Vediamolo sul tuo hotel</h3>
          <p>Trenta minuti in videochiamata, gratis e senza impegno, sui numeri della tua struttura.</p>
        </div>
        <a href={site.bookings} class="btn btn-primary btn-lg" target="_blank" rel="noopener noreferrer">Prenota la consulenza <Icon name="arrowUpRight" size={18} /></a>
      </div>
      <div class="ty-contact" data-reveal>
        <p><b>Preferisci scriverci?</b> Rispondiamo il prima possibile.</p>
        <div>
          <a href={whatsappUrl} class="btn btn-ghost" target="_blank" rel="noopener noreferrer"><Icon name="whatsapp" size={17} /> WhatsApp</a>
          <a href={`mailto:${site.email}`} class="btn btn-ghost"><Icon name="mail" size={17} /> Email</a>
        </div>
      </div>
    </div>
  </section>


  <section class="section-sm">
    <div class="container">
      <p class="eyebrow" data-reveal>Intanto, scopri le app una per una</p>
      <div class="ty-apps" data-stagger="60">
        {appList.map((a) => (
          <a href={`/${a.slug}`} data-reveal><Icon name={a.icon} size={17} /> {a.name}</a>
        ))}
      </div>
    </div>
  </section>
</Base>

<script is:inline>
  (function () {
    /* Se Zoho Forms apre questa pagina dentro l'iframe del modulo, la porta a pagina intera */
    try { if (window.top !== window.self) { window.top.location.href = window.location.href; return; } } catch (e) {}
    /* Nome passato da Zoho Forms nel redirect (?nome=Laura): personalizza il titolo */
    try {
      var p = new URLSearchParams(location.search);
      var n = (p.get('nome') || p.get('name') || '').trim().split(' ')[0];
      if (n && /^[\p{L}' -]{1,30}$/u.test(n)) document.getElementById('tyNome').textContent = ', ' + n;
    } catch (e) {}
    window.dataLayer = window.dataLayer || [];
    window.dataLayer.push({ event: 'lead_form' }, { event: 'demo_unlocked' });
    try { (window.pagesense = window.pagesense || []).push(['trackEvent', 'lead_form']); } catch (e) {}
    if (typeof window.gtag === 'function') window.gtag('event', 'generate_lead', { form: 'zoho_funnel_hotellerie' });
  })();
</script>

<style>
  .ty { padding-block: clamp(56px, 7vw, 100px); }
  .ty-grid { display: grid; grid-template-columns: 1.3fr .7fr; gap: clamp(32px, 6vw, 80px); align-items: center; }
  @media (max-width: 900px) { .ty-grid { grid-template-columns: 1fr; } }
  .ty-check { display: inline-grid; place-items: center; width: 76px; height: 76px; margin-bottom: 24px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 0 0 rgba(241,196,14,.6); animation: rise-in .95s var(--ease-out) forwards, ring 2.4s ease-out 1s infinite; }
  .ty-check path { stroke-dasharray: 1; stroke-dashoffset: 1; animation: draw-line .6s var(--ease-out) .5s forwards; }
  @keyframes ring { 0% { box-shadow: 0 0 0 0 rgba(241,196,14,.55); } 80%, 100% { box-shadow: 0 0 0 22px rgba(241,196,14,0); } }
  .ty .lead { margin-top: 20px; max-width: 52ch; }
  .ty .btn-row { margin-top: 32px; }
  .ty-meta { margin-top: 14px; font-size: .88rem; }
  .ty-demo { position: relative; justify-self: center; display: block; width: min(440px, 100%); border-radius: 16px; overflow: hidden; background: #fff; box-shadow: 0 34px 70px -22px rgba(0,0,0,.9), 0 0 0 6px rgba(241,196,14,.2); transform: rotate(2deg); transition: transform .5s var(--ease-out); }
  .ty-demo:hover { transform: rotate(0) translateY(-6px); }
  .ty-browser { display: flex; align-items: center; gap: 6px; padding: 10px 14px; background: #f1f1f1; }
  .ty-browser i { width: 9px; height: 9px; border-radius: 50%; background: #ccc; }
  .ty-browser i:first-child { background: var(--accent); }
  .ty-browser em { margin-left: 10px; font-style: normal; font-size: .74rem; color: #777; }
  .ty-demo img { width: 100%; aspect-ratio: 16 / 10; object-fit: cover; }
  .ty-open { position: absolute; right: 16px; bottom: 16px; display: inline-flex; align-items: center; gap: 6px; padding: 9px 16px; border-radius: 100px; background: var(--accent); color: #000; font-weight: 700; font-size: .9rem; box-shadow: var(--shadow-accent); }
  .ty-next { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 20px 32px; margin-top: 40px; padding: 32px; border-radius: var(--radius-xl); background: var(--black); color: #fff; }
  .ty-next h3 { color: #fff; }
  .ty-next p { color: var(--muted-dark); margin-top: 6px; }
  .ty-cover { position: relative; justify-self: center; display: block; width: min(300px, 70%); }
  .ty-cover img { width: 100%; height: auto; border-radius: 8px; transform: rotate(4deg); box-shadow: 0 34px 70px -22px rgba(0,0,0,.9); transition: transform .5s var(--ease-out); }
  .ty-cover:hover img { transform: rotate(0) translateY(-6px) scale(1.03); }
  .ty-dl { position: absolute; right: -14px; bottom: 24px; display: grid; place-items: center; width: 54px; height: 54px; border-radius: 50%; background: var(--accent); color: #000; box-shadow: var(--shadow-accent); }
  .ty-dl :global(svg) { transform: rotate(90deg); animation: bob 1.6s ease-in-out infinite; }
  @keyframes bob { 50% { translate: 0 4px; } }

  .confetti { position: absolute; inset: 0; overflow: hidden; pointer-events: none; }
  .confetti i { position: absolute; top: -20px; left: var(--x); width: 9px; height: 14px; border-radius: 2px; background: var(--accent); opacity: 0; transform: rotate(var(--r)) scale(var(--s)); animation: fall 3.8s cubic-bezier(.3,.6,.5,1) var(--d) 1 forwards; }
  .confetti i:nth-child(3n) { background: #fff; }
  .confetti i:nth-child(4n) { width: 6px; height: 6px; border-radius: 50%; }
  @keyframes fall { 0% { opacity: 0; transform: translateY(0) rotate(var(--r)) scale(var(--s)); } 10% { opacity: 1; } 100% { opacity: 0; transform: translateY(560px) rotate(calc(var(--r) + 540deg)) scale(var(--s)); } }

  .ty-actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 14px; margin-top: 40px; }
  .ty-contact { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px 28px; margin-top: 40px; padding: 22px 28px; border-radius: var(--radius-xl); background: #fff; border: 1px solid var(--accent-200); }
  .ty-contact p { font-family: var(--font-display); font-size: 1.2rem; }
  .ty-contact > div { display: flex; flex-wrap: wrap; gap: 12px; }
  .ty-apps { display: flex; flex-wrap: wrap; gap: 10px; }
  .ty-apps a { display: inline-flex; align-items: center; gap: 8px; padding: 10px 18px; border-radius: 100px; border: 1px solid var(--line); font-weight: 600; font-size: .92rem; transition: border-color .25s var(--ease), background .25s var(--ease), transform .3s var(--ease-out); }
  .ty-apps a:hover { border-color: var(--accent); background: var(--accent-50); transform: translateY(-2px); }
  .ty-apps :global(svg) { color: var(--accent-700); }
</style>
