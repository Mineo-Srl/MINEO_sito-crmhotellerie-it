---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Waves from '../components/Waves.astro';
import FunnelSteps from '../components/FunnelSteps.astro';
import { site, u, funnelPaths } from '../data/site.js';
---

<Base
  title={`Grazie, consulenza richiesta | ${site.product}`}
  description="Consulenza richiesta: ti richiamiamo per confermare giorno e fascia scelti."
  path={funnelPaths.thanks}
  noindex={true}
  minimal={true}
>
  <!-- ============================================ PASSO FINALE · GRAZIE E ATTESA -->
  <section class="ty">
    <Waves />
    <div class="container ty-in">
      <div class="ty-main">
        <FunnelSteps current={4} />
        <span class="ty-check rise"><Icon name="check" size={34} stroke={3} /></span>
        <p class="eyebrow rise" style="--d:80ms">Consulenza richiesta</p>
        <h1 class="display rise" style="--d:140ms">Grazie<span id="tyName"></span>, <strong>ti richiamiamo noi</strong></h1>
        <p class="lead rise" style="--d:220ms">
          Un nostro consulente ti chiama <b>il prima possibile</b> per confermare l’orario.
          Non devi fare altro.
        </p>

        <div class="ty-sum rise" id="tySummary" style="--d:300ms" hidden>
          <p class="ty-sum-t">La tua richiesta</p>
          <dl>
            <div><dt>Giorno preferito</dt><dd id="sumDay">—</dd></div>
            <div><dt>Fascia</dt><dd id="sumSlot">—</dd></div>
            <div id="sumTopicsRow"><dt>Argomenti</dt><dd id="sumTopics">—</dd></div>
            <div><dt>Telefono</dt><dd id="sumPhone">—</dd></div>
          </dl>
          <p class="ty-sum-n">L’orario non è ancora fissato: lo confermiamo noi per telefono.</p>
        </div>

        <div class="btn-row rise" style="--d:380ms">
          <a href={u('/')} class="btn btn-primary btn-lg" data-cta="thanks-home">Vai al sito</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-paper" style="padding-block: clamp(36px, 5vw, 60px)">
    <div class="container">
      <div class="ty-contact" data-reveal>
        <p><b>Hai fretta o vuoi anticipare la chiamata?</b> Scrivici su WhatsApp.</p>
        <div>
          <a href={`https://wa.me/${site.whatsappHref}`} class="btn btn-ghost" target="_blank" rel="noopener noreferrer" data-cta="thanks-whatsapp"><Icon name="whatsapp" size={17} /> WhatsApp</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<script is:inline>
  /* se la pagina viene caricata dentro l'iframe del form Zoho, esce dall'iframe */
  (function () { try { if (window.top !== window.self) window.top.location.href = window.location.href; } catch (e) {} })();
</script>

<style>
  .ty { position: relative; overflow: hidden; padding-block: calc(var(--header-h) + clamp(40px, 6vw, 80px)) clamp(60px, 8vw, 100px); }
  .ty-in { position: relative; z-index: 2; }
  .ty-main { max-width: 700px; }
  .ty-check { display: inline-grid; place-items: center; width: 72px; height: 72px; margin-bottom: 22px; border-radius: 50%; background: var(--accent); color: #000; box-shadow: var(--shadow-accent); }
  .ty .lead { margin-top: 18px; }
  .ty .lead b { color: var(--ink); font-weight: 700; }
  .ty-sum { margin-top: 28px; padding: 22px 26px; border-radius: var(--radius-lg); background: #fff; border: 1px solid var(--line); box-shadow: var(--shadow); }
  .ty-sum-t { font-family: var(--font-display); font-weight: 700; letter-spacing: .12em; text-transform: uppercase; font-size: .9rem; color: var(--accent-700); margin-bottom: 10px; }
  .ty-sum dl { display: grid; gap: 8px; }
  .ty-sum dl div { display: flex; flex-wrap: wrap; gap: 4px 14px; padding-bottom: 8px; border-bottom: 1px solid var(--line); }
  .ty-sum dt { width: 140px; color: var(--muted); font-size: .92rem; }
  .ty-sum dd { margin: 0; flex: 1; font-weight: 500; min-width: 160px; }
  .ty-sum-n { margin-top: 12px; font-size: .86rem; color: var(--muted); }
  .ty .btn-row { margin-top: 30px; }
  .ty-contact { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px 28px; padding: 22px 28px; border-radius: var(--radius-xl); background: var(--accent-50); border: 1px solid var(--accent-200); }
  .ty-contact p { font-family: var(--font-display); font-size: 1.3rem; }
  .ty-contact > div { display: flex; flex-wrap: wrap; gap: 12px 18px; }
</style>

<script is:inline>
  (function () {
    var read = function (k) { try { return JSON.parse(sessionStorage.getItem(k) || 'null'); } catch (e) { return null; } };
    var lead = read('crmhotel_lead'), bk = read('crmhotel_booking');
    var name = (bk && bk.nome) || (lead && lead.nome);
    if (name) document.getElementById('tyName').textContent = ' ' + String(name).trim().split(/\s+/)[0];
    if (bk) {
      document.getElementById('sumDay').textContent = bk.giorno || '—';
      document.getElementById('sumSlot').textContent = bk.fascia || '—';
      document.getElementById('sumPhone').textContent = bk.telefono || '—';
      var t = bk.argomenti || [];
      if (t.length) document.getElementById('sumTopics').textContent = t.join(', ');
      else document.getElementById('sumTopicsRow').hidden = true;
      document.getElementById('tySummary').hidden = false;
    }
    window.dataLayer = window.dataLayer || [];
    window.dataLayer.push({ event: 'lead_thank_you' });
  })();
</script>
