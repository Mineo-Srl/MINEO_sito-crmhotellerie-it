---
/* Pagina di approfondimento di ciascuna app di marketing (/pagesense, /salesiq, …).
   I contenuti stanno in src/data/apps.js. */
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import AppVisual from '../components/AppVisual.astro';
import CTASection from '../components/CTASection.astro';
import RequestForm from '../components/RequestForm.astro';
import { apps, phases } from '../data/apps.js';
import { site } from '../data/site.js';
import { tighten } from '../utils/typo.js';

export function getStaticPaths() {
  return apps.map((app) => ({ params: { slug: app.slug }, props: { app } }));
}

const { app } = Astro.props;
const idx = apps.findIndex((a) => a.slug === app.slug);
const prev = apps[(idx - 1 + apps.length) % apps.length];
const next = apps[(idx + 1) % apps.length];

const schema = [
  {
    '@type': 'Service',
    name: `${app.full} per hotel`,
    serviceType: `Configurazione di ${app.full} per strutture ricettive`,
    description: app.seo.description,
    provider: { '@id': `${site.url}/#organization` },
    areaServed: { '@type': 'Country', name: 'Italia' },
  },
  {
    '@type': 'FAQPage',
    mainEntity: app.faq.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<Base
  title={app.seo.title}
  description={app.seo.description}
  keywords={app.seo.keywords}
  breadcrumbs={[{ name: 'Le app', href: '/app' }, { name: app.name }]}
  schema={schema}
>
  <!-- ============================================ HERO -->
  <section class="app-hero section-dark">
    <div class="grid-lines" aria-hidden="true"></div>
    <div class="blob b1 drifting" aria-hidden="true"></div>
    <div class="container relative ah-grid">
      <div>
        <nav class="crumbs rise" aria-label="Percorso">
          <a href="/">Home</a><span>/</span><a href="/app">Le app</a><span>/</span><b>{app.name}</b>
        </nav>
        <p class="eyebrow rise" style="--d:60ms">{app.full} · {phases[app.phase]}</p>
        <h1 class="h1 rise" style="--d:140ms">
          {tighten(app.title)}<span class="gradient-text">{tighten(app.highlight)}</span>
        </h1>
        <p class="lead rise" style="--d:240ms">{app.lead}</p>
        <div class="btn-row rise" style="--d:340ms">
          <a href="#demo" class="btn btn-primary btn-lg"><Icon name="key" size={18} /> Sblocca la demo gratuita</a>
          <a href={site.bookings} class="btn btn-ghost btn-lg" target="_blank" rel="noopener noreferrer">Prenota una consulenza</a>
        </div>
        <p class="ah-note rise" style="--d:400ms">La demo si apre subito, senza chiamate.</p>
      </div>
      <div class="ah-visual rise" style="--d:300ms">
        <div class="floating"><AppVisual type={app.visual} /></div>
      </div>
    </div>
  </section>

  <!-- ============================================ PRIMA / DOPO -->
  <section class="section">
    <div class="container">
      <div class="section-head center" data-reveal>
        <p class="eyebrow">Il punto di partenza</p>
        <h2 class="h2">Come va oggi, <span class="gradient-text">come va con {app.name}</span></h2>
        <blockquote class="site-quote">“{app.site}”</blockquote>
      </div>
      <div class="vs">
        <div class="vs-col vs-before" data-reveal="left">
          <h3 class="h4"><Icon name="close" size={18} stroke={2.4} /> Senza {app.name}</h3>
          <ul>{app.problem.map((p) => <li>{p}</li>)}</ul>
        </div>
        <div class="vs-arrow" aria-hidden="true"><Icon name="arrow" size={26} stroke={2.2} /></div>
        <div class="vs-col vs-after" data-reveal="right">
          <h3 class="h4"><Icon name="check" size={18} stroke={2.6} /> Con {app.name}</h3>
          <ul class="check-list">{app.solution.map((p) => <li>{p}</li>)}</ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================ SCENARIO -->
  <section class="section-sm">
    <div class="container">
      <figure class="scenario" data-reveal="scale">
        <span class="sc-mark" aria-hidden="true">“</span>
        <p class="eyebrow">{app.scenario.title}</p>
        <blockquote>{app.scenario.text}</blockquote>
        <figcaption>{app.scenario.note}</figcaption>
      </figure>
    </div>
  </section>

  <!-- ============================================ BLOCCO SPECIFICO DELL'APP -->
  {app.triggers && (
    <section class="section section-paper">
      <div class="container">
        <div class="section-head" data-reveal>
          <p class="eyebrow">I tre trigger</p>
          <h2 class="h2">Un messaggio diverso per <span class="gradient-text">ogni momento</span></h2>
        </div>
        <div class="grid grid-3" data-stagger="120">
          {app.triggers.map((t, i) => (
            <article class="card trig" data-reveal data-tilt>
              <span class="trig-n">0{i + 1}</span>
              <span class="icon-chip"><Icon name={t.icon} /></span>
              <h3 class="h4">{t.title}</h3>
              <p class="trig-bubble">{t.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  {app.forms && (
    <section class="section section-paper">
      <div class="container">
        <div class="section-head" data-reveal>
          <p class="eyebrow">I moduli per l’hotel</p>
          <h2 class="h2">Un modulo per <span class="gradient-text">ogni tipo di richiesta</span></h2>
        </div>
        <div class="grid grid-4" data-stagger="100">
          {app.forms.map((f) => (
            <article class="card" data-reveal data-tilt>
              <span class="icon-chip"><Icon name={f.icon} /></span>
              <h3 class="h4">{f.title}</h3>
              <p>{f.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  {app.journey && (
    <section class="section section-paper">
      <div class="container">
        <div class="section-head" data-reveal>
          <p class="eyebrow">Un percorso tipo</p>
          <h2 class="h2">Dal preventivo <span class="gradient-text">al ritorno</span></h2>
        </div>
        <ol class="tl" data-stagger="140">
          {app.journey.map((j) => (
            <li data-reveal>
              <span class="tl-dot"></span>
              <b>{j.when}</b>
              <p>{j.what}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>
  )}

  {app.channels && (
    <section class="section-sm section-paper">
      <div class="container">
        <p class="eyebrow" data-reveal>I canali collegati</p>
      </div>
      <div class="marquee" data-reveal>
        <div class="marquee-track">
          {[...app.channels, ...app.channels].map((c) => <span class="ch-pill">{c}</span>)}
        </div>
      </div>
    </section>
  )}

  {app.tiers && (
    <section class="section section-paper">
      <div class="container">
        <div class="section-head" data-reveal>
          <p class="eyebrow">Un programma tipo</p>
          <h2 class="h2">Tre livelli, <span class="gradient-text">regole chiare</span></h2>
        </div>
        <div class="grid grid-3 tiers" data-stagger="140">
          {app.tiers.map((t, i) => (
            <article class:list={['card', 'tier', `tier-${i}`]} data-reveal data-tilt>
              <span class="tier-n">Livello {i + 1}</span>
              <h3 class="h3">{t.name}</h3>
              <p>{t.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ============================================ FUNZIONI -->
  <section class="section">
    <div class="container">
      <div class="section-head" data-reveal>
        <p class="eyebrow">Cosa fa per il tuo hotel</p>
        <h2 class="h2">{app.full}, <span class="gradient-text">configurato da noi</span></h2>
      </div>
      <div class="grid grid-3" data-stagger="90">
        {app.features.map((f) => (
          <article class="card feat" data-reveal data-tilt>
            <span class="icon-chip"><Icon name={f.icon} /></span>
            <h3 class="h4">{f.title}</h3>
            <p>{f.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ============================================ COLLEGATA AL CRM + SCHERMATE -->
  <section class="section section-dark crm-band">
    <div class="grid-lines" aria-hidden="true"></div>
    <div class="container relative cb-grid">
      <div data-reveal="left">
        <p class="eyebrow">Collegata al CRM</p>
        <h2 class="h2">Un solo dato dell’ospite, <span class="gradient-text">sette app che lo usano</span></h2>
        <p class="lead mt-3">{app.crm}</p>
        <h3 class="h4 mt-4">Cosa misuri</h3>
        <ul class="metrics" data-stagger="80">
          {app.metrics.map((m) => <li data-reveal>{m}</li>)}
        </ul>
      </div>
      <div class="cb-media" data-reveal="right">
        {app.screens ? (
          <div class:list={['shots', { two: app.screens.length > 1 }]}>
            {app.screens.map((s, i) => (
              <figure class="shot" style={`--i:${i}`}>
                <img src={s.src} alt={s.alt} loading="lazy" decoding="async" />
              </figure>
            ))}
            <p class="shot-note">Schermate reali dall’hotel dimostrativo</p>
          </div>
        ) : (
          <figure class="photo">
            <img src={app.photo} alt="" loading="lazy" decoding="async"/>
          </figure>
        )}
      </div>
    </div>
  </section>

  <CTASection
    eyebrow="Provalo"
    title={`Vuoi vedere ${app.name} in un hotel vero?`}
    text="Sblocca la demo di Hotel Soleluna: quattro dati e la apri subito. Se poi vuoi parlarne, la consulenza è gratuita."
    primary={{ href: '#demo', label: 'Sblocca la demo gratuita' }}
    secondary={{ href: site.bookings, label: 'Prenota una consulenza' }}
  />

  <!-- ============================================ COME LO ATTIVIAMO -->
  <section class="section section-paper">
    <div class="container">
      <div class="section-head center" data-reveal>
        <p class="eyebrow">Come lo attiviamo</p>
        <h2 class="h2">Quattro passi, <span class="gradient-text">li facciamo noi</span></h2>
        <p class="lead">Configurazione, collegamento al CRM e formazione del tuo team sono compresi nel lavoro di {site.legal}.</p>
      </div>
      <ol class="steps" data-stagger="150">
        {app.steps.map((s, i) => (
          <li data-reveal>
            <span class="step-num">{i + 1}</span>
            <h3 class="h4">{s.title}</h3>
            <p>{s.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ============================================ FAQ -->
  <section class="section">
    <div class="container container-narrow">
      <div class="section-head center" data-reveal>
        <p class="eyebrow">Domande frequenti</p>
        <h2 class="h2">{app.name}: <span class="gradient-text">le domande che ci fanno</span></h2>
      </div>
      <div class="faq" data-stagger="80">
        {app.faq.map((f, i) => (
          <details data-reveal open={i === 0}>
            <summary>{f.q}<span class="faq-ic" aria-hidden="true"></span></summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <RequestForm topic={app.name} />

  <!-- ============================================ ALTRE APP -->
  <section class="section-sm">
    <div class="container">
      <div class="others-head" data-reveal>
        <p class="eyebrow">Le altre app di marketing</p>
        <div class="pn">
          <a href={`/${prev.slug}`} class="pn-l"><Icon name="arrow" size={16} /> {prev.name}</a>
          <a href={`/${next.slug}`} class="pn-r">{next.name} <Icon name="arrow" size={16} /></a>
        </div>
      </div>
      <div class="others" data-stagger="60">
        {apps.map((a) => (
          <a href={`/${a.slug}`} class:list={['oth', { current: a.slug === app.slug }]} aria-current={a.slug === app.slug ? 'page' : undefined} data-reveal>
            <span class="oth-ic"><Icon name={a.icon} size={18} /></span>
            <span><b>{a.name}</b><small>{a.menu}</small></span>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  /* Hero */
  .app-hero { padding-block: clamp(56px, 7vw, 100px) clamp(64px, 8vw, 110px); }
  .app-hero .b1 { width: 520px; height: 520px; right: -120px; top: -140px; background: rgba(241,196,14,.35); }
  .ah-grid { display: grid; grid-template-columns: 1.05fr .95fr; gap: clamp(36px, 5vw, 72px); align-items: center; }
  .ah-grid .lead { margin-top: 22px; max-width: 56ch; }
  .ah-grid .btn-row { margin-top: 32px; }
  .ah-note { margin-top: 14px; font-size: .88rem; }
  .ah-visual { display: flex; justify-content: center; }
  .ah-visual .floating { width: 100%; display: flex; justify-content: center; animation-duration: 9s; }
  .crumbs { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 22px; font-size: .84rem; color: var(--muted-dark); }
  .crumbs a:hover { color: #fff; }
  .crumbs b { color: #fff; font-weight: 600; }
  @media (max-width: 960px) { .ah-grid { grid-template-columns: 1fr; } }

  /* Prima / dopo */
  .site-quote {
    margin-top: 22px;
    padding: 16px 22px;
    border-left: 4px solid var(--accent);
    background: var(--paper);
    border-radius: 0 14px 14px 0;
    text-align: left;
    font-size: 1.02rem;
    color: var(--text);
    font-style: italic;
  }
  .vs { display: grid; grid-template-columns: 1fr auto 1fr; gap: 24px; align-items: stretch; }
  .vs-col { padding: 32px; border-radius: var(--radius-lg); border: 1px solid var(--line); }
  .vs-col h3 { display: flex; align-items: center; gap: 10px; margin-bottom: 18px; }
  .vs-before { background: var(--grey-50); }
  .vs-before h3 :global(svg) { color: var(--grey); }
  .vs-before ul { display: grid; gap: 13px; }
  .vs-before li { position: relative; padding-left: 26px; color: var(--grey-600); line-height: 1.55; }
  .vs-before li::before { content: ''; position: absolute; left: 4px; top: .7em; width: 12px; height: 2px; background: var(--grey-300); }
  .vs-after { background: #fff; border-color: var(--accent); box-shadow: var(--shadow); }
  .vs-after h3 :global(svg) { padding: 3px; border-radius: 50%; background: var(--accent); width: 24px; height: 24px; }
  .vs-arrow { align-self: center; display: grid; place-items: center; width: 54px; height: 54px; border-radius: 50%; background: var(--black); color: var(--accent); animation: nudge 2.4s var(--ease) infinite; }
  @keyframes nudge { 50% { transform: translateX(6px); } }
  @media (max-width: 860px) {
    .vs { grid-template-columns: 1fr; }
    .vs-arrow { justify-self: center; transform: rotate(90deg); animation: none; }
  }

  /* Trigger SalesIQ */
  .trig { padding-top: 40px; }
  .trig-n { position: absolute; top: 18px; right: 24px; font-family: var(--font-display); font-weight: 800; font-size: 2.6rem; line-height: 1; color: var(--grey-100); }
  .trig-bubble { margin-top: 14px; padding: 14px 16px; border-radius: 16px 16px 16px 4px; background: var(--paper); color: var(--text) !important; font-size: .94rem; }

  /* Timeline Marketing Automation */
  .tl { position: relative; display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 20px; }
  .tl::before { content: ''; position: absolute; left: 0; right: 0; top: 9px; height: 2px; background: linear-gradient(90deg, var(--accent), var(--grey-100)); }
  .tl li { position: relative; padding-top: 34px; }
  .tl-dot { position: absolute; top: 0; left: 0; width: 20px; height: 20px; border-radius: 50%; background: var(--accent); border: 4px solid #fff; box-shadow: 0 0 0 2px var(--accent); }
  .tl b { display: block; font-family: var(--font-display); font-size: 1.05rem; }
  .tl p { margin-top: 6px; color: var(--muted); font-size: .94rem; }
  @media (max-width: 900px) {
    .tl { grid-template-columns: 1fr; gap: 26px; padding-left: 34px; }
    .tl::before { left: 9px; right: auto; top: 0; bottom: 0; width: 2px; height: auto; }
    .tl li { padding-top: 0; }
    .tl-dot { left: -34px; }
  }

  /* Canali Social */
  .ch-pill { padding: 14px 26px; border-radius: 100px; background: #fff; border: 1px solid var(--line); font-family: var(--font-display); font-weight: 700; font-size: 1.1rem; white-space: nowrap; }

  /* Livelli Thrive */
  .tier-n { display: inline-block; margin-bottom: 14px; padding: 4px 12px; border-radius: 100px; font-size: .74rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; background: var(--paper); }
  .tier-1 { border-color: var(--accent); }
  .tier-1 .tier-n { background: var(--accent-100); }
  .tier-2 { background: var(--black); border-color: var(--black); }
  .tier-2 h3 { color: var(--accent); }
  .tier-2 p { color: var(--muted-dark); }
  .tier-2 .tier-n { background: var(--accent); }
  .tier-2 p { margin-top: 10px; }

  /* Card con luce che segue il mouse */
  .card[data-tilt] { transition: transform .25s var(--ease-out), box-shadow .45s var(--ease-out); transform-style: preserve-3d; }
  .card[data-tilt]::before {
    content: ''; position: absolute; inset: 0; border-radius: inherit; pointer-events: none;
    background: radial-gradient(320px circle at var(--mx, 50%) var(--my, 50%), rgba(241,196,14,.16), transparent 60%);
    opacity: 0; transition: opacity .3s var(--ease);
  }
  .card[data-tilt]:hover::before { opacity: 1; }

  /* Banda CRM */
  .cb-grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(36px, 5vw, 72px); align-items: center; }
  .metrics { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 16px; }
  .metrics li { padding: 8px 16px; border-radius: 100px; border: 1px solid rgba(241,196,14,.35); background: rgba(241,196,14,.08); color: #fff !important; font-size: .9rem; }
  .shots { position: relative; display: grid; gap: 16px; }
  .shot { margin: 0; border-radius: 16px; overflow: hidden; border: 1px solid rgba(255,255,255,.14); box-shadow: 0 30px 60px -20px rgba(0,0,0,.8); background: #fff; }
  .shot img { width: 100%; height: auto; transition: transform .8s var(--ease-out); }
  .shot:hover img { transform: scale(1.03); }
  .shots.two .shot:nth-child(2) { width: 82%; margin-left: auto; margin-top: -60px; position: relative; }
  .shot-note { font-size: .82rem; color: var(--muted-dark); }
  .photo { margin: 0; border-radius: var(--radius-lg); overflow: hidden; aspect-ratio: 4 / 3.4; box-shadow: 0 30px 60px -20px rgba(0,0,0,.8); }
  .photo img { width: 100%; height: 115%; object-fit: cover; }
  @media (max-width: 900px) { .cb-grid { grid-template-columns: 1fr; } }

  /* Passi */
  .steps { position: relative; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 28px; counter-reset: s; }
  .steps::before { content: ''; position: absolute; left: 22px; right: 22px; top: 22px; height: 2px; background: repeating-linear-gradient(90deg, var(--accent-600) 0 8px, transparent 8px 16px); animation: dash-move 1.2s linear infinite; }
  @keyframes dash-move { to { background-position: 16px 0; } }
  .steps li { position: relative; }
  .steps .step-num { position: relative; margin-bottom: 18px; }
  .steps p { margin-top: 8px; color: var(--muted); font-size: .96rem; }
  @media (max-width: 900px) {
    .steps { grid-template-columns: 1fr 1fr; }
    .steps::before { display: none; }
  }
  @media (max-width: 560px) { .steps { grid-template-columns: 1fr; } }

  /* Scenario */
  .scenario {
    position: relative;
    margin: 0;
    padding: clamp(32px, 5vw, 56px);
    border-radius: var(--radius-xl);
    background: var(--accent);
    overflow: hidden;
  }
  .sc-mark { position: absolute; right: 28px; top: -40px; font-family: var(--font-display); font-weight: 800; font-size: 16rem; line-height: 1; color: rgba(0,0,0,.08); }
  .scenario .eyebrow::before { background: #000; }
  .scenario blockquote { position: relative; font-family: var(--font-display); font-weight: 700; font-size: clamp(1.15rem, 2vw, 1.45rem); line-height: 1.45; letter-spacing: -.01em; max-width: 64ch; }
  .scenario figcaption { margin-top: 16px; font-size: .84rem; color: rgba(0,0,0,.6); }

  /* FAQ */
  .faq { display: grid; gap: 12px; }
  .faq details { background: #fff; border: 1px solid var(--line); border-radius: var(--radius); transition: border-color .3s var(--ease), box-shadow .3s var(--ease); }
  .faq details[open] { border-color: var(--accent); box-shadow: var(--shadow-sm); }
  .faq summary { display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 20px 24px; font-weight: 650; cursor: pointer; list-style: none; }
  .faq summary::-webkit-details-marker { display: none; }
  .faq-ic { position: relative; width: 28px; height: 28px; flex: none; border-radius: 50%; background: var(--paper); transition: background .3s var(--ease), transform .4s var(--ease-out); }
  .faq-ic::before, .faq-ic::after { content: ''; position: absolute; left: 50%; top: 50%; width: 12px; height: 2px; margin: -1px 0 0 -6px; background: currentColor; border-radius: 2px; }
  .faq-ic::after { transform: rotate(90deg); transition: transform .3s var(--ease); }
  .faq details[open] .faq-ic { background: var(--accent); transform: rotate(180deg); }
  .faq details[open] .faq-ic::after { transform: rotate(0); }
  .faq details p { padding: 0 24px 22px; color: var(--muted); }

  /* Altre app */
  .others-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 16px; margin-bottom: 20px; }
  .others-head .eyebrow { margin: 0; }
  .pn { display: flex; gap: 10px; }
  .pn a { display: inline-flex; align-items: center; gap: 8px; padding: 9px 16px; border-radius: 100px; border: 1px solid var(--line); font-weight: 600; font-size: .9rem; transition: border-color .25s var(--ease), background .25s var(--ease); }
  .pn a:hover { border-color: var(--accent); background: var(--accent-50); }
  .pn-l :global(svg) { transform: rotate(180deg); }
  .others { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 10px; }
