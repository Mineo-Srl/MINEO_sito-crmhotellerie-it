---
/* "Componi la tua soluzione": configuratore in due passi (tipo di struttura →
   esigenze) con riepilogo che si aggiorna. Diverso dalla home, che mostra
   un'esigenza alla volta: qui il visitatore costruisce il proprio set e lo
   porta in demo o su WhatsApp. */
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import { problems, problemCats, segments, site, contactFormUrl } from '../data/site.js';
import { featureHref } from '../data/features.js';
const segData = segments.map((s) => ({ id: s.id, title: s.title, icon: s.icon, links: s.links }));
---
<Base title="Componi la tua soluzione" description="Scegli il tipo di struttura e le esigenze del tuo hotel: componi la tua soluzione CRM Hotellerie, area per area, e portala in demo.">
  <PageHero illo="componi"
    eyebrow="Componi la tua soluzione"
    title="Scegli cosa ti serve: "
    hl="il resto lo aggiungi quando vuoi."
    lead="Due passi e hai la tua soluzione su misura: indica che struttura hai e cosa vuoi migliorare. Ogni area si attiva anche da sola."
    crumbs={[{ label: 'Componi la tua soluzione' }]}
    ctas={false}
  />

  <section class="section-sm section-paper">
    <div class="container cfg" data-cfg data-mail={site.email}>
      <div class="steps">
        <fieldset class="step">
          <legend><h2 class="lg"><span class="n">1</span> Che struttura hai?</h2></legend>
          <p class="hint">Ti proponiamo le esigenze più frequenti per il tuo tipo di struttura. Puoi cambiarle.</p>
          <div class="segs">
            {segData.map((s) => (
              <label class="seg">
                <input type="radio" name="seg" value={s.id} data-links={s.links.join(',')} />
                <span><Icon name={s.icon} size={18} /> {s.title}</span>
              </label>
            ))}
          </div>
        </fieldset>

        <fieldset class="step">
          <legend><h2 class="lg"><span class="n">2</span> Cosa vuoi migliorare?</h2></legend>
          <p class="hint">Seleziona una o più voci.</p>
          {problemCats.map((c) => (
            <div class="grp">
              <p class="label">{c.label}</p>
              <div class="needs">
                {problems.filter((p) => p.cat === c.id).map((p) => (
                  <label class="need">
                    <input type="checkbox" value={p.id} data-slug={p.slug} data-sol={p.sol} data-href={featureHref(p.slug)} data-text={p.text} data-points={JSON.stringify(p.points)} data-pain={p.pain} data-nopreset={(p as any).noPreset ? '1' : undefined} />
                    <span class="nd-ic"><Icon name={p.icon} size={18} /></span>
                    <span class="nd-t">{p.pain}</span>
                    <span class="nd-ck"><Icon name="check" size={14} /></span>
                  </label>
                ))}
              </div>
            </div>
          ))}
        </fieldset>
      </div>

      <aside class="res" aria-live="polite">
        <p class="label">La tua soluzione</p>
        <p class="res-empty" data-empty>Seleziona almeno un’esigenza: qui compare la soluzione su misura.</p>
        <ul class="res-list" data-list></ul>
        <p class="res-sum" data-sum hidden></p>
        <div class="res-cta" data-cta hidden>
          <a class="btn btn-primary" data-demo href="/demo/">Prenota la demo su misura</a>
          <button type="button" class="btn res-mail" data-open-mail><Icon name="mail" size={18} /> Inviala via email</button>
          <button type="button" class="res-pdf" data-pdf><Icon name="download" size={18} /> Scarica il riepilogo PDF</button>
          <div class="res-info">
            <p class="res-info-t"><Icon name="mail" size={16} /> Cosa succede se la invii via email</p>
            <ol>
              <li>Scarichi il <strong>riepilogo in PDF</strong> della tua soluzione.</li>
              <li>Lo alleghi al modulo: la tua richiesta arriva direttamente a noi.</li>
              <li>Il team di <strong>MINEO S.r.l.</strong> ti ricontatta per parlarne insieme.</li>
            </ol>
          </div>
        </div>
        <p class="res-note"><Icon name="spark" size={16} /> Un solo account, gli stessi dati: le altre aree si aggiungono quando servono, senza cambiare piattaforma.</p>
      </aside>
    </div>
  </section>

  <dialog class="mdl" data-mail-dlg aria-labelledby="mdl-t">
    <div class="mdl-f">
      <button type="button" class="mdl-x" data-close aria-label="Chiudi"><Icon name="close" size={20} /></button>
      <h2 class="h3" id="mdl-t">Inviacela via email</h2>
      <p class="mdl-lead">Ti ricontattiamo noi. <button type="button" class="mdl-pdf" data-pdf-mdl><Icon name="download" size={15} /> Scarica il riepilogo PDF</button></p>
      {/* Modulo Zoho Forms "Funnel_hotellerie": il src viene impostato all'apertura,
          con referrername = indirizzo della pagina (contiene struttura ed esigenze scelte). */}
      <iframe id="ziframe_106334" class="mdl-if" aria-label="Form Funnel_hotellerie" title="Modulo di richiesta" data-zf={contactFormUrl}></iframe>
    </div>
  </dialog>
</Base>

<script>
  type Sol = { sol: string; text: string; points: string[]; pain: string[] };
  document.querySelectorAll('[data-cfg]').forEach((root) => {
    const el = root as HTMLElement;
    const needs = [...root.querySelectorAll('.need input')] as HTMLInputElement[];
    const segs = [...root.querySelectorAll('.seg input')] as HTMLInputElement[];
    const list = root.querySelector('[data-list]') as HTMLElement;
    const empty = root.querySelector('[data-empty]') as HTMLElement;
    const sum = root.querySelector('[data-sum]') as HTMLElement;
    const cta = root.querySelector('[data-cta]') as HTMLElement;
    const demo = root.querySelector('[data-demo]') as HTMLAnchorElement;
    const dlg = document.querySelector('[data-mail-dlg]') as HTMLDialogElement;
    let sols: Sol[] = [];
    let segTxt = '';

    const render = () => {
      const on = needs.filter((n) => n.checked);
      const map = new Map<string, Sol>();
      on.forEach((n) => {
        const k = n.dataset.sol!;
        if (!map.has(k)) map.set(k, { sol: k, text: n.dataset.text || '', points: JSON.parse(n.dataset.points || '[]'), pain: [] });
        map.get(k)!.pain.push(n.dataset.pain || '');
      });
      sols = [...map.values()];
      // Voci espandibili: il dettaglio si apre qui, senza lasciare la pagina
      list.innerHTML = '';
      sols.forEach((x) => {
        const li = document.createElement('li');
        const d = document.createElement('details');
        const sm = document.createElement('summary'); sm.textContent = x.sol;
        const p = document.createElement('p'); p.textContent = x.text;
        const ul = document.createElement('ul'); x.points.forEach((t) => { const i = document.createElement('li'); i.textContent = t; ul.append(i); });
        d.append(sm, p, ul); li.append(d); list.append(li);
      });
      const k = sols.length;
      empty.hidden = k > 0; sum.hidden = k === 0; cta.hidden = k === 0;
      sum.textContent = k === 1 ? 'Si attiva anche da sola.' : `${k} soluzioni, un solo software.`;
      const seg = segs.find((s) => s.checked);
      segTxt = seg ? (seg.parentElement!.textContent || '').trim() : '';
      const names = sols.map((x) => x.sol);
      demo.href = '/demo/?soluzioni=' + encodeURIComponent(names.join(' · ')) + (seg ? '&struttura=' + encodeURIComponent(segTxt) : '');
      // La configurazione resta nell'indirizzo: tornando indietro si ritrova uguale
      const q = new URLSearchParams();
      if (seg) q.set('struttura', seg.value);
      if (on.length) q.set('esigenze', on.map((n) => n.value).join(','));
      history.replaceState(null, '', location.pathname + (q.toString() ? '?' + q : ''));
    };

    needs.forEach((n) => n.addEventListener('change', render));
    segs.forEach((s) => s.addEventListener('change', () => {
      const links = (s.dataset.links || '').split(',');
      needs.forEach((n) => (n.checked = !n.dataset.nopreset && links.includes(n.dataset.slug!)));
      render();
    }));
    const params = new URLSearchParams(location.search);
    const sg = params.get('struttura') && segs.find((s) => s.value === params.get('struttura'));
    if (sg) { sg.checked = true; sg.dispatchEvent(new Event('change')); }
    const es = params.get('esigenze');
    if (es) { const ids = es.split(','); needs.forEach((n) => (n.checked = ids.includes(n.value))); }
    const m = location.hash.match(/^#problema-(.+)$/);
    if (m) needs.forEach((n) => { if (n.value === m[1]) n.checked = true; });
    render();

    /* ---- PDF riepilogativo ---- */
    const clean = (t: string) => t.replace(/[’‘]/g, "'").replace(/[“”]/g, '"').replace(/…/g, '...').replace(/–|—/g, '-');
    const makePdf = async (who?: Record<string, string>) => {
      const { jsPDF } = await import('jspdf');
      const doc = new jsPDF({ unit: 'mm', format: 'a4' });
      const W = 210, M = 18, TW = W - M * 2;
      let y = 0;
      const page = () => { doc.addPage(); y = 20; };
      const need = (h: number) => { if (y + h > 280) page(); };
      // testata
      doc.setFillColor(0, 0, 0); doc.rect(0, 0, W, 34, 'F');
      doc.setTextColor(255, 255, 255); doc.setFont('helvetica', 'bold'); doc.setFontSize(18);
      doc.text('CRM Hotellerie', M, 15);
      doc.setFont('helvetica', 'normal'); doc.setFontSize(10);
      doc.text('La tua soluzione su misura', M, 23);
      doc.text(new Date().toLocaleDateString('it-IT'), W - M, 23, { align: 'right' });
      doc.setFillColor(13, 127, 137); doc.rect(0, 34, W, 2, 'F');
      y = 48; doc.setTextColor(0, 0, 0);
      if (segTxt) { doc.setFontSize(9); doc.setTextColor(13, 127, 137); doc.text('STRUTTURA', M, y); y += 6; doc.setTextColor(0, 0, 0); doc.setFontSize(12); doc.setFont('helvetica', 'bold'); doc.text(clean(segTxt), M, y); y += 10; }
      if (who && who.nome) {
        doc.setFont('helvetica', 'normal'); doc.setFontSize(9); doc.setTextColor(13, 127, 137); doc.text('RICHIEDENTE', M, y); y += 6; doc.setTextColor(0, 0, 0); doc.setFontSize(10.5);
        [`${who.nome} ${who.cognome || ''}`.trim(), who.struttura, who.email, who.telefono, who.gestione && 'Oggi: ' + who.gestione].filter(Boolean).forEach((t) => { doc.text(clean(t as string), M, y); y += 5.5; });
        y += 4;
      }
      doc.setFont('helvetica', 'normal'); doc.setFontSize(9); doc.setTextColor(13, 127, 137); doc.text(`LE SOLUZIONI SCELTE (${sols.length})`, M, y); y += 7;
      sols.forEach((x, i) => {
        doc.setFont('helvetica', 'normal'); doc.setFontSize(10);
        const txt = doc.splitTextToSize(clean(x.text), TW - 8);
        const pts = x.points.map((p) => doc.splitTextToSize(clean(p), TW - 14));
        const h = 12 + txt.length * 5 + pts.reduce((a, l) => a + l.length * 5, 0) + 8;
        need(h);
        doc.setFillColor(238, 246, 247); doc.roundedRect(M, y - 5, TW, h, 2, 2, 'F');
        doc.setFillColor(13, 127, 137); doc.rect(M, y - 5, 1.6, h, 'F');
        doc.setTextColor(0, 0, 0); doc.setFont('helvetica', 'bold'); doc.setFontSize(12.5);
        doc.text(`${i + 1}. ${clean(x.sol)}`, M + 6, y + 2); y += 8;
        doc.setFont('helvetica', 'italic'); doc.setFontSize(9); doc.setTextColor(60, 60, 60);
        doc.text(clean('Esigenza: ' + x.pain.join('; ')), M + 6, y, { maxWidth: TW - 10 }); y += 5;
        doc.setFont('helvetica', 'normal'); doc.setFontSize(10); doc.setTextColor(0, 0, 0);
        doc.text(txt, M + 6, y); y += txt.length * 5 + 1;
        pts.forEach((l) => { doc.setFillColor(13, 127, 137); doc.rect(M + 7, y - 2.6, 2, 2, 'F'); doc.text(l, M + 12, y); y += l.length * 5; });
        y += 9;
      });
      need(36);
      doc.setFillColor(0, 0, 0); doc.roundedRect(M, y, TW, 30, 2, 2, 'F');
      doc.setTextColor(255, 255, 255); doc.setFont('helvetica', 'bold'); doc.setFontSize(12);
      doc.text(sols.length > 1 ? `${sols.length} soluzioni, un solo software.` : 'Si attiva anche da sola.', M + 6, y + 9);
      doc.setFont('helvetica', 'normal'); doc.setFontSize(9.5);
      doc.text('Un solo account Zoho, intestato alla struttura: le altre aree si aggiungono quando servono.', M + 6, y + 16);
      doc.text('Prenota la demo gratuita: www.crmhotellerie.it/demo  ·  ' + (el.dataset.mail || ''), M + 6, y + 23);
      doc.setTextColor(120, 120, 120); doc.setFontSize(8);
      doc.text('MINEO S.r.l. · Zoho Authorized Partner · Riepilogo indicativo, da definire insieme in consulenza.', M, 290);
      doc.save('crm-hotellerie-la-tua-soluzione.pdf');
    };
    root.querySelector('[data-pdf]')!.addEventListener('click', () => makePdf());

    /* ---- Invio via email: modulo con gli stessi campi della pagina contatti ---- */
    root.querySelector('[data-open-mail]')!.addEventListener('click', () => {
      // Come nel codice di incorporamento Zoho: referrername = pagina di provenienza,
      // che qui contiene anche la configurazione (?struttura=…&esigenze=…)
      const zf = dlg.querySelector('#ziframe_106334') as HTMLIFrameElement;
      let rfr = location.href;
      if (rfr.length > 1800) rfr = rfr.substring(0, 1800);
      // Precompila "Tipo di struttura" (SingleLine1) con la struttura scelta
      let pre = segTxt ? '&SingleLine1=' + encodeURIComponent(segTxt) : '';
      // Precompila "Soluzioni scelte" (SingleLine2): campo a riga singola, max 255 caratteri
      const solTxt = sols.map((x) => x.sol).join(', ');
      if (solTxt) pre += '&SingleLine2=' + encodeURIComponent(solTxt.length > 255 ? solTxt.slice(0, 252) + '...' : solTxt);
      const src = zf.dataset.zf + (zf.dataset.zf!.includes('?') ? '&' : '?') + 'zf_rszfm=1&referrername=' + encodeURIComponent(rfr) + pre;
      if (zf.src !== src) zf.src = src;
      dlg.showModal();
    });
    dlg.querySelector('[data-pdf-mdl]')!.addEventListener('click', async (e) => {
      const b = e.currentTarget as HTMLButtonElement;
      await makePdf();
      b.textContent = '✓ PDF scaricato';
    });
    window.addEventListener('message', (ev) => {
      const zf = dlg.querySelector('#ziframe_106334') as HTMLIFrameElement;
      if (typeof ev.data !== 'string' || !zf.src.includes('/formperma/')) return;
      const d = ev.data.split('|');
      if ((d.length === 2 || d.length === 3) && zf.src.includes(d[0]) && !isNaN(parseInt(d[1]))) {
        zf.style.height = parseInt(d[1]) + 15 + 'px';
      }
    });
    dlg.querySelector('[data-close]')!.addEventListener('click', () => dlg.close());
    dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
  });
</script>

<style>
  .cfg { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 380px); gap: clamp(24px, 3vw, 44px); align-items: start; }
  .steps { display: grid; gap: 22px; }
  .step { border: 0; padding: clamp(22px, 2.6vw, 32px); margin: 0; background: #fff; border-radius: 28px 0 28px 0; }
  .step legend { float: left; width: 100%; display: flex; align-items: center; gap: 12px; font-weight: 700; font-size: 1.3rem; color: #000; }
  .step legend + * { clear: both; }
  .lg { display: flex; align-items: center; gap: 12px; font: inherit; margin: 0; }
  .n { display: grid; place-items: center; width: 34px; height: 34px; border-radius: 10px 0 10px 0; background: #000; color: #fff; font-size: 1rem; }
  .hint { margin: 6px 0 16px 46px; font-size: .92rem; color: #000; }
  .segs { display: flex; flex-wrap: wrap; gap: 8px; }
  .seg input, .need input { position: absolute; opacity: 0; pointer-events: none; }
  .seg span { display: inline-flex; align-items: center; gap: 8px; padding: 9px 16px; border: 1.5px solid #000; border-radius: 999px; font-weight: 600; font-size: .9rem; cursor: pointer; transition: background .2s, color .2s; }
  .seg input:checked + span { background: #000; color: #fff; }
  .seg input:focus-visible + span, .need:has(input:focus-visible) { outline: 2px solid var(--teal); outline-offset: 2px; }
  .grp + .grp { margin-top: 18px; }
  .needs { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; }
  @media (max-width: 1200px) { .needs { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .need { position: relative; display: grid; grid-template-columns: 34px 1fr 22px; gap: 12px; align-items: center; padding: 10px 12px; border: 1.5px solid var(--line); border-radius: 14px 0 14px 0; cursor: pointer; transition: border-color .2s, background .2s; }
  .need:hover { border-color: #000; }
  .nd-ic { display: grid; place-items: center; width: 34px; height: 34px; border-radius: 10px 0 10px 0; background: var(--yellow-soft); color: #000; }
  .nd-t { font-weight: 600; font-size: .92rem; line-height: 1.3; color: #000; }
  .nd-ck { display: grid; place-items: center; width: 22px; height: 22px; border-radius: 6px; border: 1.5px solid #000; color: transparent; }
  .need:has(input:checked) { border-color: var(--teal); background: var(--yellow-tint); }
  .need:has(input:checked) .nd-ck { background: var(--teal); border-color: var(--teal); color: #fff; }
  .need:has(input:checked) .nd-ic { background: var(--teal); color: #fff; }

  .res { position: sticky; top: calc(var(--header-h) + 20px); padding: clamp(22px, 2.6vw, 32px); background: #111; color: #fff; border-radius: 28px 0 28px 0; }
  .res .label { color: #fff; }
  .res-empty { color: #fff; font-size: .95rem; }
  .res-list { display: grid; gap: 8px; margin-top: 6px; }
  .res-list li { display: flex; }
  .res-list > :global(li) { display: block; }
  .res-list :global(details) { border-radius: 12px 0 12px 0; background: var(--teal); color: #fff; }
  .res-list :global(summary) { display: flex; justify-content: space-between; align-items: center; gap: 10px; padding: 11px 14px; font-weight: 600; cursor: pointer; list-style: none; }
  .res-list :global(summary::-webkit-details-marker) { display: none; }
  .res-list :global(summary)::after { content: '+'; font-size: 1.2rem; line-height: 1; flex: none; }
  .res-list :global(details[open] summary)::after { content: '−'; }
  .res-list :global(details p) { padding: 0 14px 8px; font-size: .86rem; line-height: 1.5; color: #fff; }
  .res-list :global(details ul) { display: grid; gap: 4px; padding: 0 14px 12px 30px; list-style: square; font-size: .84rem; color: #fff; }
  .res-sum { margin-top: 14px; font-weight: 700; color: #fff; }
  .res-cta { display: grid; gap: 12px; margin-top: 16px; }
  .res-cta .btn { justify-content: center; text-align: center; white-space: normal; }
  .res-mail { justify-content: center; gap: 8px; background: #fff; color: #000; border: 0; }
  .res-mail:hover { background: var(--yellow-soft); }
  .res-pdf { display: inline-flex; align-items: center; justify-content: center; gap: 8px; color: #fff; font-weight: 600; text-decoration: underline; text-underline-offset: 3px; background: none; border: 0; cursor: pointer; font: inherit; font-weight: 600; }
  .mdl { margin: auto; inset: 0; position: fixed; overflow: auto; width: min(720px, calc(100% - 32px)); max-height: calc(100dvh - 24px); padding: 0; border: 0; border-radius: 28px 0 28px 0; box-shadow: 0 40px 80px -30px rgba(0,0,0,.6); }
  .mdl::backdrop { background: rgba(0,0,0,.55); }
  .mdl-f { position: relative; padding: clamp(18px, 2.4vw, 28px) clamp(18px, 2.4vw, 28px) 8px; display: grid; gap: 6px; }
  .mdl-pdf { display: inline-flex; align-items: center; gap: 6px; margin-left: 6px; background: none; border: 0; padding: 0; font: inherit; font-weight: 600; color: var(--teal); text-decoration: underline; text-underline-offset: 3px; cursor: pointer; }
  .mdl-x { position: absolute; top: 14px; right: 14px; width: 40px; height: 40px; display: grid; place-items: center; border-radius: 50%; border: 0; background: var(--paper-2); cursor: pointer; }
  .mdl-lead { font-size: .94rem; }
  .mdl-if { width: 100%; height: 900px; border: 0; background: #fff; display: block; margin: 0 -8px; width: calc(100% + 16px); }
  .res-info { margin-top: 4px; padding: 14px 16px; border-radius: 12px 0 12px 0; background: rgba(255,255,255,.08); color: #fff; }
  .res-info-t { display: flex; align-items: center; gap: 8px; font-weight: 700; font-size: .88rem; color: #fff; margin-bottom: 10px; }
  .res-info ol { display: grid; gap: 8px; counter-reset: st; }
  .res-info li { position: relative; padding-left: 30px; font-size: .86rem; line-height: 1.45; color: #fff; counter-increment: st; }
  .res-info li::before { content: counter(st); position: absolute; left: 0; top: 0; display: grid; place-items: center; width: 20px; height: 20px; border-radius: 6px 0 6px 0; background: var(--teal); font-size: .74rem; font-weight: 700; }
  .res-info strong { color: #fff; }
  .res-wa { display: inline-flex; align-items: center; justify-content: center; gap: 8px; color: #fff; font-weight: 600; text-decoration: underline; text-underline-offset: 3px; }
  .res-note { display: flex; gap: 8px; margin-top: 18px; padding-top: 16px; border-top: 1px solid #333; font-size: .86rem; color: #fff; }
  .res-note :global(.icon) { flex: none; margin-top: 2px; }

  @media (max-width: 960px) { .cfg { grid-template-columns: 1fr; } .res { position: static; } }
  @media (max-width: 600px) { .needs { grid-template-columns: 1fr; } .hint { margin-left: 0; } }
</style>
