---
/* Pagina di ritorno dopo la prenotazione su Zoho Bookings.
   In Zoho Bookings → impostazioni del servizio → "Dopo la prenotazione" →
   reindirizza a https://www.crmhotellerie.it/prenotazione-confermata
   Serve a misurare in PageSense/GA4 le consulenze prenotate, che altrimenti
   avvengono su un dominio esterno. Non indicizzata. */
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { site, guide } from '../data/site.js';
---

<Base
  title="Consulenza prenotata"
  description="La tua consulenza gratuita con CRM Hotellerie è prenotata."
  noindex={true}
>
  <section class="pc section-dark">
    <div class="grid-lines" aria-hidden="true"></div>
    <div class="container relative">
      <span class="pc-ic rise"><Icon name="calendar" size={34} stroke={2} /></span>
      <p class="eyebrow rise" style="--d:80ms">Consulenza prenotata</p>
      <h1 class="h1 rise" style="--d:140ms">Ci vediamo presto. <span class="gradient-text">Grazie per il tuo tempo.</span></h1>
      <p class="lead rise" style="--d:220ms">Trovi data, ora e link alla videochiamata nell’email di conferma. Per arrivare preparato, dai un’occhiata alla demo o alla guida.</p>
      <div class="btn-row rise" style="--d:300ms">
        <a href={site.demoUrl} class="btn btn-primary btn-lg" target="_blank" rel="noopener">Apri la demo <Icon name="arrowUpRight" size={18} /></a>
        <a href={guide.pdf} class="btn btn-ghost btn-lg" download>Scarica la guida</a>
      </div>
    </div>
  </section>
</Base>

<script is:inline>
  (function () {
    window.dataLayer = window.dataLayer || [];
    window.dataLayer.push({ event: 'booking_completed' });
    try { (window.pagesense = window.pagesense || []).push(['trackEvent', 'booking_completed']); } catch (e) {}
    if (typeof window.gtag === 'function') window.gtag('event', 'booking_completed');
  })();
</script>

<style>
  .pc { min-height: 70vh; display: flex; align-items: center; padding-block: 80px; }
  .pc .lead { margin-top: 18px; max-width: 58ch; }
  .pc .btn-row { margin-top: 30px; }
  .pc-ic { display: inline-grid; place-items: center; width: 76px; height: 76px; margin-bottom: 24px; border-radius: 50%; background: var(--accent); color: #000; }
</style>
