---
/* Home (versione compatta). Ordine: promessa (hero A) + 3 prove + 1 azione
   principale → esigenza per esigenza → non un pacchetto chiuso → da sei programmi
   a uno + CTA → prezzo e numeri → guida → CTA. */
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import CTA from '../components/CTA.astro';
import GuideBand from '../components/GuideBand.astro';
import ProblemFinder from '../components/ProblemFinder.astro';
import StartOptions from '../components/StartOptions.astro';
import Illo from '../components/Illo.astro';
import { site, segments } from '../data/site.js';
const segIllo: Record<string, string> = { 'hotel-indipendenti': 'hotel', 'resort-e-villaggi': 'resort', 'agriturismi-e-bb': 'agriturismo', 'gruppi-alberghieri': 'gruppi', 'wellness-e-spa': 'spa', 'nuove-aperture': 'bnb' };

const pillars = [
  { icon: 'chart', title: 'Marketing', text: 'Più visite e richieste dal tuo sito, chat e campagne.', href: '/marketing/' },
  { icon: 'calendar', title: 'Prenotazioni', text: 'Booking engine senza commissioni e portali sincronizzati.', href: '/il-software/#booking-engine' },
  { icon: 'users', title: 'Gestione clienti', text: 'Una scheda per ogni ospite, preventivi e fidelizzazione.', href: '/il-software/#crm-e-preventivi' },
  { icon: 'file', title: 'Fatturazione', text: 'Fattura elettronica e adempimenti dai dati che hai già.', href: '/il-software/#fatturazione-e-adempimenti' },
];

/* Promessa (hero A, scelta definitiva). */
const hero = {
  kicker: 'Il software per hotel su Zoho',
  title: 'Prenotazioni dirette, clienti, marketing e fatture ', hl: 'in un unico software.',
  text: 'Parti dall’area che ti serve oggi e aggiungi le altre quando vuoi: lavorano tutte sugli stessi dati.',
};

/* Tre prove a sostegno della promessa (fonti: guida v. definitiva). */
const proofs = [
  { icon: 'euro', t: 'Prenotazioni dirette', d: 'sul tuo sito, senza commissioni.' },
  { icon: 'lock', t: 'I dati restano tuoi:', d: 'l’account è intestato alla struttura.' },
  { icon: 'users', t: 'Ti seguiamo noi:', d: 'formazione e assistenza in italiano.' },
];

const before = ['Gestionale per le prenotazioni', 'Booking engine di un altro fornitore', 'Programma di fatturazione', 'Foglio Excel per i clienti', 'Newsletter con un altro servizio', 'Pulizie coordinate su WhatsApp'];
const after = ['Prenotazioni, planning e check-in', 'Booking engine e channel manager', 'Fattura elettronica e adempimenti', 'Scheda ospite e preventivi', 'Email automatiche e campagne', 'App per pulizie e manutenzione'];
---
<Base title="CRM Hotellerie" description="Un unico software per il tuo hotel: marketing, prenotazioni, gestione clienti e fatturazione in un solo strumento, configurato sulla tua struttura. I dati restano tuoi.">

  <!-- HERO: la promessa in una riga -->
  <section class="hero">
    <div class="container hero-in">
      <div class="hero-txt">
        <div class="promise">
          <p class="kicker">{hero.kicker}</p>
          <h1 class="hero-h">{hero.title}<span class="hl">{hero.hl}</span></h1>
          <p class="hero-p">{hero.text}</p>
        </div>
        {/* PROVE: tre motivi per crederci */}
        <ul class="proofs">
          {proofs.map((p) => <li><span class="pf-ic"><Icon name={p.icon} size={18} /></span><span><strong>{p.t}</strong> {p.d}</span></li>)}
        </ul>
        {/* PULSANTI: una sola azione principale, una alternativa leggera */}
        <div class="hero-cta">
          <a class="btn btn-primary" href="/demo/">Prenota una demo gratuita</a>
          <a class="soft" href="/guida/"><Icon name="download" size={16} /> oppure scarica la guida gratuita</a>
        </div>
        <p class="trust"><Icon name="shield" size={18} /> Mineo, Zoho Authorized Partner da {site.partnerYears} anni</p>
      </div>
      <div class="hero-art" aria-hidden="true">
        <div class="skyline"><Illo name="gruppi" /><Illo name="hotel" /><Illo name="resort" /><Illo name="agriturismo" /></div>
        <div class="app">
          <div class="app-bar"><span></span><span></span><span></span><em>CRM Hotellerie</em></div>
          <div class="app-body">
            <ul class="app-nav">
              <li class="on"><Icon name="calendar" size={16} /> Prenotazioni</li>
              <li><Icon name="users" size={16} /> Clienti</li>
              <li><Icon name="chart" size={16} /> Marketing</li>
              <li><Icon name="file" size={16} /> Fatture</li>
              <li><Icon name="spark" size={16} /> Reparti</li>
            </ul>
            <img src="/img/app/planning.jpg" alt="" />
          </div>
        </div>
        <div class="chip c1"><Icon name="check" size={16} /> Prenotazione diretta confermata</div>
        <div class="chip c2"><Icon name="file" size={16} /> Fattura inviata allo SdI</div>
        <div class="chip c3"><Icon name="users" size={16} /> Giulia R. · ospite abituale</div>
      </div>
    </div>
    <div class="container">
      <ul class="pillars">
        {pillars.map((p) => (
          <li><a href={p.href}>
            <span class="p-ic"><Icon name={p.icon} size={24} /></span>
            <span><strong>{p.title}</strong><span>{p.text}</span></span>
          </a></li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ZOHO: la piattaforma sotto il software, subito dopo la promessa -->
  <section class="zband" aria-labelledby="zb-t">
    <div class="container zb-in">
      <img class="zb-logo" src="/img/zoho-logo.svg" alt="Zoho" width="150" height="66" loading="lazy" />
      <div class="zb-txt">
        <h2 class="zb-t" id="zb-t">Costruito su Zoho, <span class="hl">la piattaforma cloud nata nel 1996</span></h2>
        <ul class="zb-pts">
          <li><Icon name="layers" size={16} /> Oltre 50 app integrate</li>
          <li><Icon name="shield" size={16} /> Data center ISO 27001 e GDPR</li>
          <li><Icon name="lock" size={16} /> Account intestato alla struttura</li>
        </ul>
      </div>
      <div class="zb-side">
        <img class="zb-badge" src="/img/partner-autorizzato-zoho.webp" alt="Zoho Authorized Partner" width="160" height="44" loading="lazy" />
        <a class="zb-link" href="/chi-siamo/#chi-e-zoho">Chi è Zoho <Icon name="arrow" size={15} /></a>
      </div>
    </div>
  </section>

  <!-- PER OGNI STRUTTURA: illustrazioni stilizzate, aprono il configuratore già impostato -->
  <section class="section-sm" id="strutture">
    <div class="container">
      <div class="head center reveal">
        <p class="eyebrow">Per ogni struttura</p>
        <h2 class="h2">Dall’hotel in città <span class="hl">all’agriturismo</span></h2>
        <p class="lead">Scegli la tua struttura: ti proponiamo da dove partire.</p>
      </div>
      <ul class="kinds">
        {segments.map((s, i) => (
          <li class="reveal" style={`--d:${i * 50}ms`}>
            <a href={`/trova-la-soluzione/?struttura=${s.id}`}>
              <span class="k-art"><Illo name={segIllo[s.id] || 'hotel'} /></span>
              <span class="k-t">{s.title}</span>
              <span class="k-go">Componi <Icon name="arrow" size={14} /></span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- TROVA LA SOLUZIONE -->
  <section class="section section-paper" id="trova">
    <div class="container">
      <div class="head center reveal">
        <p class="eyebrow">Trova la tua soluzione</p>
        <h2 class="h2">Qual è la tua priorità <span class="hl">oggi?</span></h2>
        <p class="lead">Scegli quello che ti pesa di più: ti mostriamo come lo risolviamo. Ogni soluzione si attiva anche da sola.</p>
      </div>
      <div class="reveal"><ProblemFinder /></div>
    </div>
  </section>

  <!-- COME VUOI PARTIRE -->
  <section class="section">
    <div class="container">
      <div class="head center reveal">
        <p class="eyebrow">Non un pacchetto unico</p>
        <h2 class="h2">Non vendiamo un pacchetto chiuso: <span class="hl">costruiamo la soluzione sulle esigenze della tua struttura.</span></h2>
        <p class="lead">Prendi solo quello che ti serve. O tutto.</p>
      </div>
      <StartOptions />
    </div>
  </section>

  <!-- PRIMA / DOPO -->
  <section class="section section-dark">
    <div class="container">
      <div class="head center reveal">
        <p class="eyebrow">Quando le unisci</p>
        <h2 class="h2">Da sei programmi <span class="hl">a uno solo</span></h2>
        <p class="lead">Ogni soluzione che aggiungi prende il posto di un programma in più. Meno password, meno copia e incolla, meno errori.</p>
      </div>
      <div class="ba reveal">
        <div class="ba-col">
          <p class="ba-t">Oggi</p>
          <ul>{before.map((b) => <li><Icon name="close" size={16} /> {b}</li>)}</ul>
        </div>
        <div class="ba-mid" aria-hidden="true"><Icon name="arrow" size={30} /></div>
        <div class="ba-col after">
          <p class="ba-t">Con CRM Hotellerie</p>
          <ul>{after.map((a) => <li><Icon name="check" size={16} /> {a}</li>)}</ul>
        </div>
      </div>
      <div class="mid-cta reveal">
        <a class="btn btn-primary" href="/demo/">Prenota una demo gratuita</a>
        <span>Senza impegno, sul tuo hotel.</span>
      </div>
    </div>
  </section>

  <!-- PREZZO + NUMERI: come si compone il costo e quanto si recupera -->
  <section class="section-sm" id="costi">
    <div class="container nums reveal">
      <div class="n-big">
        <p class="label">Esempio sui numeri</p>
        <p class="n-v">19.000 €</p>
        <p>di margine in più in un anno: su ogni notte prenotata dal tuo sito guadagni la commissione che non paghi al portale (18,70 € su una camera da 110 €). Calcolato con 10 prenotazioni su 100 che passano dai portali al sito.</p>
        <p class="small muted">Hotel da 40 camere, 70% di occupazione, camera media 110 €, 60% del venduto dalle OTA con commissioni al 17%. Calcolo illustrativo.</p>
        <a class="link-arrow" href="/calcolatore/">Fai il calcolo con i tuoi numeri</a>
      </div>
      <div class="price">
        <p class="label">Quanto costa</p>
        <h2 class="h3">Quanto costa CRM Hotellerie? Paghi solo le aree che attivi.</h2>
        <ul class="price-list">
          <li><Icon name="check" size={16} /> <span><strong>Licenze Zoho</strong> in abbonamento, a parte: si parte da Zoho CRM Enterprise, inclusa in Zoho One.</span></li>
          <li><Icon name="check" size={16} /> <span><strong>Configurazione e personalizzazione</strong> di Mineo, preventivate sulla tua struttura.</span></li>
          <li><Icon name="check" size={16} /> <span><strong>Formazione e assistenza</strong> in italiano.</span></li>
        </ul>
        <p class="todo price-todo">Prezzo indicativo da inserire, per esempio “a partire da … € al mese”</p>
        <a class="link-arrow" href="/chi-siamo/#costi">Cosa è incluso</a>
      </div>
    </div>
  </section>

  <GuideBand strip={false} />

  <CTA title="Vedilo sul" hl="tuo hotel." />

</Base>


<style>
  /* HERO */
  .hero { position: relative; overflow: hidden; padding: clamp(40px, 5vw, 72px) 0 0; }
  .hero-in { position: relative; display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); gap: clamp(32px, 4vw, 56px); align-items: center; }
  .kicker { display: inline-block; font-weight: 600; font-size: .82rem; letter-spacing: .04em; text-transform: uppercase; background: #111; color: #fff; padding: 7px 14px; border-radius: 10px 0 10px 0; }
  .hero-h { font-weight: 700; font-size: clamp(2.2rem, 4.1vw, 3.6rem); line-height: 1.03; letter-spacing: -.045em; color: #000; margin-top: 22px; }
  .hero-p { margin-top: 22px; font-size: clamp(1.05rem, 1.4vw, 1.22rem); line-height: 1.6; color: #000; max-width: 48ch; }
  .trust { display: flex; align-items: center; gap: 8px; margin-top: 26px; font-size: .9rem; color: var(--muted); }
  .trust :global(.icon) { color: var(--gold); }

  .hero-art { position: relative; min-height: 470px; }
  .app { position: absolute; left: 4%; right: 2%; top: 46px; background: #fff; border-radius: 16px; box-shadow: 0 30px 70px -28px rgba(0,0,0,.45); overflow: hidden; }
  .app-bar { display: flex; align-items: center; gap: 6px; padding: 10px 14px; background: #111; }
  .app-bar span { width: 9px; height: 9px; border-radius: 50%; background: #444; }
  .app-bar em { font-style: normal; color: #fff; font-weight: 600; font-size: .8rem; margin-left: 10px; }
  .app-body { display: grid; grid-template-columns: 128px 1fr; }
  .app-nav { background: #f6f6f6; padding: 12px 8px; display: grid; gap: 4px; align-content: start; font-size: .78rem; font-weight: 600; }
  .app-nav li { display: flex; align-items: center; gap: 8px; padding: 8px; border-radius: 8px; color: #000; }
  .app-nav li.on { background: var(--yellow); color: #fff; }
  .app-body img { width: 100%; height: 100%; object-fit: cover; object-position: left top; }
  .chip { position: absolute; display: flex; align-items: center; gap: 8px; background: #fff; border-radius: 12px 0 12px 0; padding: 10px 14px; font-size: .82rem; font-weight: 600; color: #000; box-shadow: 0 14px 30px -14px rgba(0,0,0,.4); white-space: nowrap; }
  .chip :global(.icon) { color: #fff; background: #111; border-radius: 50%; padding: 3px; width: 22px; height: 22px; }
  .c1 { right: 0; top: 300px; } .c2 { left: 14%; bottom: 0; } .c3 { right: 10%; top: 6px; }

  .pillars { position: relative; display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; margin-top: clamp(40px, 5vw, 64px); padding-bottom: clamp(40px, 5vw, 64px); }
  .pillars a { display: grid; grid-template-columns: 50px 1fr; gap: 14px; align-items: start; padding: 20px; background: #fff; border: 1px solid var(--line); border-radius: 22px 0 22px 0; height: 100%; transition: border-color .2s, transform .2s var(--ease); }
  .pillars a:hover { border-color: #111; transform: translateY(-3px); }
  .p-ic { display: grid; place-items: center; width: 50px; height: 50px; border-radius: 14px 0 14px 0; background: #111; color: #fff; }
  .pillars strong { display: block; font-size: 1.1rem; letter-spacing: -.02em; color: #000; }
  .pillars span span { font-size: .88rem; color: var(--muted); line-height: 1.45; }

  /* PILASTRI */
  .blocks { display: grid; gap: clamp(48px, 6vw, 88px); }
  .block { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); gap: clamp(28px, 5vw, 72px); align-items: center; }
  .block.rev .b-img { order: -1; }
  .b-k { display: inline-flex; align-items: center; gap: 8px; font-weight: 700; font-size: .82rem; text-transform: uppercase; letter-spacing: .04em; color: var(--gold); margin-bottom: 12px; }
  .b-txt .h2 { font-size: clamp(1.7rem, 2.8vw, 2.4rem); margin-bottom: 22px; }
  .b-txt .sq-list li { color: #000; }
  .b-apps { margin: 20px 0 22px; font-size: .84rem; color: var(--muted); }
  .b-img { position: relative; }
  .b-img::before { content: ''; position: absolute; inset: 10% -4% -6% 10%; background: var(--yellow); border-radius: 40px 0 40px 0; z-index: -1; }
  .block.rev .b-img::before { inset: 10% 10% -6% -4%; }
  .more { margin-top: 56px; text-align: center; color: var(--muted); }
  .more a { color: #000; font-weight: 600; text-decoration: underline; text-decoration-color: var(--yellow-600); text-decoration-thickness: 2px; text-underline-offset: 4px; }

  /* PRIMA / DOPO */
  .ba { display: grid; grid-template-columns: 1fr auto 1fr; gap: 28px; align-items: center; max-width: 980px; margin: 0 auto; }
  .ba-col { border-radius: 28px 0 28px 0; padding: 30px; background: #1d1d1d; }
  .ba-col.after { background: var(--yellow); color: #fff; }
  .ba-t { font-weight: 700; font-size: 1.2rem; margin-bottom: 16px; color: #fff; }
  .after .ba-t { color: #fff; }
  .ba-col ul { display: grid; gap: 10px; }
  .ba-col li { display: flex; align-items: center; gap: 10px; color: #fff; }
  .ba-col li :global(.icon) { flex: none; color: #fff; }
  .after li { color: #fff; font-weight: 600; }
  .after li :global(.icon) { color: #fff; }
  .ba-mid { color: var(--teal); }

  /* COME FUNZIONA */
  .steps { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; counter-reset: s; }
  .steps li { position: relative; padding: 28px; border: 1px solid var(--line); border-radius: 24px 0 24px 0; }
  .s-n { display: grid; place-items: center; width: 44px; height: 44px; border-radius: 12px 0 12px 0; background: #111; color: #fff; font-weight: 700; margin-bottom: 16px; }
  .steps .h4 { margin-bottom: 8px; }
  .steps p:not(.h4) { color: var(--muted); }
  .zoho { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-top: 40px; }
  .z-card { padding: clamp(26px, 3vw, 40px); background: var(--yellow-tint); border: 1px solid var(--yellow); border-radius: 32px 0 32px 0; }
  .z-card.dark { background: #111; border-color: #111; }
  .z-card .h3 { margin-bottom: 12px; }
  .z-card p:not(.h3):not(.label) { color: #000; }
  .z-card.dark p:not(.h3):not(.label) { color: #fff; }
  .center-link { text-align: center; margin-top: 32px; }

  /* PER CHI È */
  .segs { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .seg { display: grid; gap: 8px; }
  .seg-img { display: block; aspect-ratio: 16 / 10; border-radius: 999px 999px 18px 18px; overflow: hidden; }
  .seg-img img { width: 100%; height: 100%; object-fit: cover; transition: transform .5s var(--ease); }
  .seg:hover .seg-img img { transform: scale(1.05); }
  .seg-t { font-weight: 700; font-size: 1.15rem; letter-spacing: -.02em; color: #000; margin-top: 6px; }
  .seg-d { font-size: .9rem; color: var(--muted); }

  /* NUMERI */
  .nums { display: grid; grid-template-columns: 1.2fr 1fr; gap: 28px; align-items: stretch; }
  .n-big { background: #111; color: #fff; border-radius: 32px 0 32px 0; padding: clamp(28px, 4vw, 48px); display: grid; gap: 10px; justify-items: start; }
  .n-big p { color: #fff; }
  .n-v { font-weight: 700; font-size: clamp(3rem, 7vw, 5rem); letter-spacing: -.05em; line-height: 1; color: #fff !important; }
  .n-big .link-arrow { color: #fff; margin-top: 8px; }
  .n-big .link-arrow:hover { background: #fff; color: #000; }
  .n-list { display: grid; gap: 12px; align-content: center; }
  .n-list li { padding: 18px 22px; border: 1px solid var(--line); border-radius: 18px 0 18px 0; color: var(--muted); }
  .n-list strong { display: inline-block; min-width: 92px; font-size: 1.5rem; letter-spacing: -.03em; color: #000; }

  @media (max-width: 1080px) {
    .hero-in, .block, .nums { grid-template-columns: 1fr; }
    .block.rev .b-img { order: 0; }
    .pillars { grid-template-columns: repeat(2, 1fr); }
    .segs { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 760px) {
    .pillars, .segs, .steps, .zoho { grid-template-columns: 1fr; }
    .ba { grid-template-columns: 1fr; }
    .ba-mid { transform: rotate(90deg); justify-self: center; }
    .hero-art { min-height: 360px; }
    .app-body { grid-template-columns: 1fr; }
    .app-nav { display: none; }
    .chip { font-size: .74rem; }
    .c1 { top: 240px; }
  }
  /* CTA a metà pagina */
  .mid-cta { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 16px; margin-top: 44px; }
  .mid-cta span { color: #fff; font-size: .95rem; }
  /* In breve */
  .brief { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .br-card { display: flex; flex-direction: column; gap: 14px; padding: clamp(24px, 2.6vw, 34px); background: var(--paper); border-radius: 28px 0 28px 0; border: 1.5px solid transparent; transition: border-color .2s; color: #000; }
  .br-card:hover { border-color: var(--teal); }
  .br-card.dark { background: #111; color: #fff; }
  .br-card.dark .label { color: #fff; }
  .br-card .link-arrow { margin-top: auto; align-self: flex-start; }
  .br-card.dark .link-arrow { color: #fff; }
  .br-steps { display: grid; gap: 10px; }
  .br-steps li { display: flex; align-items: center; gap: 12px; font-weight: 600; }
  .br-steps span { display: grid; place-items: center; width: 30px; height: 30px; flex: none; border-radius: 9px 0 9px 0; background: #000; color: #fff; font-size: .85rem; }
  .br-q { color: #fff; }
  .br-q strong { color: #fff; }
  .br-segs { display: flex; flex-wrap: wrap; gap: 8px; }
  .br-segs li { padding: 6px 12px; border-radius: 999px; background: #fff; font-size: .85rem; font-weight: 600; }
  @media (max-width: 900px) { .brief { grid-template-columns: 1fr; } }
  /* Hero: skyline di strutture stilizzate dietro il gestionale */
  .skyline { position: absolute; left: -4%; right: -4%; bottom: 0; display: grid; grid-template-columns: 1.1fr 1fr 1fr 1fr; align-items: end; gap: 0; color: var(--teal); opacity: .5; --illo-accent: var(--teal); --illo-accent-op: .35; }
  .skyline :global(.cut) { fill: #fff; }

  /* Per ogni struttura */
  .kinds { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 14px; }
  .kinds a { display: flex; flex-direction: column; gap: 10px; height: 100%; padding: 18px 16px 16px; background: var(--paper); border: 1.5px solid transparent; border-radius: 22px 0 22px 0; color: #000; transition: border-color .2s, transform .2s var(--ease); }
  .kinds a:hover { border-color: var(--teal); transform: translateY(-3px); }
  .k-art { display: block; color: #000; --illo-accent: var(--teal); }
  .k-t { font-weight: 700; font-size: .95rem; line-height: 1.25; }
  .k-go { margin-top: auto; display: inline-flex; align-items: center; gap: 6px; font-weight: 700; font-size: .78rem; text-transform: uppercase; letter-spacing: .03em; color: var(--teal); }
  @media (max-width: 1100px) { .kinds { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
