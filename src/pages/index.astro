---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import AppVisual from '../components/AppVisual.astro';
import CTASection from '../components/CTASection.astro';
import RequestForm from '../components/RequestForm.astro';
import {
  site, heroPoints, propertyTypes, reasons, guestFacts, insights, zohoStats, paths, steps, faq,
} from '../data/site.js';
import { apps, phases } from '../data/apps.js';

const schema = [
  {
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<Base
  title="CRM Hotellerie | CRM e marketing per hotel su Zoho"
  description="CRM Hotellerie è il CRM per hotel costruito su Zoho da MINEO S.r.l.: scheda ospite, sette app di marketing, prenotazioni dirette, reparti e dashboard in un unico sistema."
  keywords={['CRM hotel', 'CRM alberghiero', 'marketing hotel', 'Zoho hotel', 'prenotazioni dirette']}
  schema={schema}
>
  <!-- ============================================ HERO -->
  <section class="hero section-dark">
    <div class="grid-lines" aria-hidden="true"></div>
    <div class="blob b1 drifting" aria-hidden="true"></div>
    <div class="blob b2 drifting" aria-hidden="true"></div>
    <div class="container relative hero-grid">
      <div>
        <p class="badge rise"><span class="dot"></span> CRM e marketing per hotel su Zoho</p>
        <h1 class="display rise" style="--d:100ms">
          <span class="gradient-text">Tutto Zoho</span>, cucito sul tuo hotel
        </h1>
        <p class="lead rise" style="--d:200ms">
          CRM Hotellerie mette nello stesso sistema la scheda di ogni ospite, sette app di marketing,
          il widget di prenotazione e i reparti. Lo configuriamo noi di {site.legal}, Zoho Authorized
          Partner da {site.partnerYears} anni.
        </p>
        <div class="btn-row rise" style="--d:300ms">
          <a href={site.bookings} class="btn btn-primary btn-lg" target="_blank" rel="noopener noreferrer">
            Prenota una consulenza gratuita <Icon name="arrowUpRight" size={18} />
          </a>
          <a href="/guida" class="btn btn-ghost btn-lg"><Icon name="document" size={18} /> Scarica la guida</a>
        </div>
        <ul class="hero-points rise" style="--d:420ms">
          {heroPoints.map((p) => <li><Icon name="check" size={15} stroke={3} /> {p}</li>)}
        </ul>
      </div>

      <!-- Orbita: la scheda ospite al centro, le 7 app intorno -->
      <div class="orbit-wrap rise" style="--d:260ms" aria-hidden="true">
        <div class="orbit">
          <span class="ring r1"></span><span class="ring r2"></span>
          <div class="guest">
            <div class="g-head">
              <span class="g-av">GR</span>
              <div><b>Giulia R.</b><small>Ospite abituale · 4 soggiorni</small></div>
            </div>
            <div class="g-stats">
              <div><small>Spesa totale</small><b>€ <span data-count="3860">3860</span></b></div>
              <div><small>NPS</small><b>10</b></div>
            </div>
            <div class="g-tags"><span>Coppia</span><span>Vista mare</span><span>Spa</span></div>
            <div class="g-row"><Icon name="shield" size={14} stroke={2} /> Consenso marketing · sì</div>
          </div>
          <ul class="planets">
            {apps.map((a, i) => (
              <li style={`--a:${(360 / apps.length) * i}deg`}>
                <span class="planet"><Icon name={a.icon} size={16} stroke={2} /> {a.name}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================ TIPI DI STRUTTURA -->
  <section class="types" aria-label="Per chi è">
    <div class="marquee">
      <div class="marquee-track">
        {[...propertyTypes, ...propertyTypes].map((t) => <span class="type"><Icon name="building" size={16} /> {t}</span>)}
      </div>
    </div>
  </section>

  <!-- ============================================ PERCHÉ -->
  <section class="section section-paper" id="perche-crm">
    <div class="container">
      <div class="section-head" data-reveal>
        <p class="eyebrow">Perché CRM Hotellerie</p>
        <h2 class="h2">Meno commissioni, meno fogli Excel, <span class="gradient-text">più ospiti che tornano</span></h2>
        <p class="lead">
          Oggi l’ospite prenota dal portale, i dati restano sparsi tra gestionale, email e social e
          la volta dopo ripaghi la commissione. CRM Hotellerie rimette l’ospite nelle tue mani.
        </p>
      </div>
      <div class="grid grid-3" data-stagger="120">
        {reasons.map((r) => (
          <article class="card" data-reveal data-tilt>
            <span class="icon-chip"><Icon name={r.icon} /></span>
            <h3 class="h4">{r.title}</h3>
            <p>{r.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ============================================ L'OSPITE AL CENTRO -->
  <section class="section" id="ospite">
    <div class="container guest-grid">
      <div data-reveal="left">
        <p class="eyebrow">L’ospite al centro</p>
        <h2 class="h2">Una scheda per ogni ospite, <span class="gradient-text">sempre aggiornata</span></h2>
        <p class="lead mt-3">
          Ogni app scrive nella stessa scheda: il modulo di preventivo, la chat, le email aperte, il voto
          del questionario, i punti fedeltà. Chi è alla reception sa con chi sta parlando.
        </p>
        <div class="grid grid-2 mt-4" data-stagger="100">
          {guestFacts.map((g) => (
            <div class="gf" data-reveal>
              <span class="gf-ic"><Icon name={g.icon} size={20} /></span>
              <div><h3 class="h4">{g.title}</h3><p>{g.text}</p></div>
            </div>
          ))}
        </div>
      </div>
      <div class="guest-visual" data-reveal="right">
        <img src="/img/photos/camera-deluxe.webp" alt="Camera deluxe dell’hotel dimostrativo" loading="lazy" decoding="async" />
        <div class="feed" data-play>
          {[
            ['inbox', 'Forms', 'Richiesta preventivo · agosto'],
            ['chat', 'SalesIQ', 'Chat · “accettate cani?”'],
            ['mail', 'Marketing Automation', 'Email pre-arrivo aperta'],
            ['star', 'Survey', 'NPS 10 · “torneremo”'],
            ['gift', 'Thrive', '+120 punti · livello Habitué'],
          ].map(([ic, app, t], i) => (
            <div class="feed-item" style={`--i:${i}`}>
              <span><Icon name={ic} size={15} stroke={2} /></span>
              <div><b>{app}</b><small>{t}</small></div>
            </div>
          ))}
        </div>
        <p class="demo-note">Dati dimostrativi</p>
      </div>
    </div>
  </section>

  <!-- ============================================ LE 7 APP DI MARKETING -->
  <section class="section section-paper" id="marketing">
    <div class="container">
      <div class="section-head center" data-reveal>
        <p class="eyebrow">Marketing alberghiero</p>
        <h2 class="h2">Sette app Zoho, <span class="gradient-text">un solo percorso dell’ospite</span></h2>
        <p class="lead">Dalla prima visita al sito al ritorno l’anno dopo. Ogni app ha la sua pagina: aprila per vedere cosa fa nel tuo hotel.</p>
      </div>

      <div class="apps" data-stagger="80">
        {apps.map((a, i) => (
          <a href={`/${a.slug}`} class:list={['app-card', { wide: i === 0 }]} data-reveal data-tilt>
            <span class="app-top">
              <span class="icon-chip"><Icon name={a.icon} /></span>
              <span class="app-n">0{i + 1}</span>
            </span>
            <span class="app-phase">{phases[a.phase]}</span>
            <h3 class="h3">{a.name}</h3>
            <p>{a.site}</p>
            <span class="app-more">Scopri {a.name} <Icon name="arrow" size={16} /></span>
            {i === 0 && <span class="app-mock"><AppVisual type="funnel" compact /></span>}
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ============================================ DASHBOARD -->
  <section class="section section-dark" id="dashboard">
    <div class="grid-lines" aria-hidden="true"></div>
    <div class="container relative">
      <div class="section-head" data-reveal>
        <p class="eyebrow">Dashboard</p>
        <h2 class="h2">I numeri che servono, <span class="gradient-text">a chi servono</span></h2>
      </div>
      <div class="grid grid-4" data-stagger="100">
        {insights.map((s) => (
          <article class="card card-dark" data-reveal>
            <span class="icon-chip"><Icon name={s.icon} /></span>
            <h3 class="h4">{s.title}</h3>
            <p>{s.text}</p>
          </article>
        ))}
      </div>
      <div class="dash" data-reveal data-play aria-hidden="true">
        <div class="dash-bars">
          {[42, 58, 51, 66, 72, 61, 80, 88, 76, 92, 84, 97].map((v, i) => (
            <span style={`--v:${v}%;--i:${i}`}><i></i></span>
          ))}
        </div>
        <div class="dash-legend">
          <span><i class="k1"></i> Prenotazioni dirette</span>
          <span>Dati dimostrativi · 12 mesi</span>
        </div>
      </div>
    </div>
  </section>

  <CTASection
    title="Vediamo insieme come lavora il tuo hotel"
    text="Trenta minuti in videochiamata, sui numeri della tua struttura: ti mostriamo CRM Hotellerie in funzione e cosa attivare per primo."
    primary={{ href: site.bookings, label: 'Prenota una consulenza gratuita' }}
    secondary={{ href: '/guida', label: 'Scarica la guida gratuita' }}
  />

  <!-- ============================================ PERCHÉ ZOHO -->
  <section class="section" id="perche-zoho">
    <div class="container">
      <div class="section-head" data-reveal>
        <p class="eyebrow">Perché Zoho</p>
        <h2 class="h2">Una piattaforma sola, <span class="gradient-text">i dati restano tuoi</span></h2>
        <p class="lead">
          Zoho fornisce la piattaforma e le licenze, noi la configurazione sul tuo hotel, la formazione
          e l’assistenza in italiano. L’account è della struttura: i dati li esporti quando vuoi.
        </p>
      </div>
      <div class="stats" data-stagger="100">
        {zohoStats.map((s) => (
          <div class="stat" data-reveal>
            <b><span data-count={s.value}>{s.value}</span>{s.suffix}</b>
            <small>{s.label}</small>
          </div>
        ))}
      </div>

      <div class="grid grid-2 mt-5" data-stagger="140">
        {paths.map((p, i) => (
          <article class:list={['card', 'path', { dark: i === 1 }]} data-reveal data-tilt>
            <span class="path-n">Strada {i + 1}</span>
            <h3 class="h3">{p.title}</h3>
            <p>{p.text}</p>
            <ul class="check-list mt-3">{p.points.map((x) => <li>{x}</li>)}</ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ============================================ COME SI PARTE -->
  <section class="section section-paper" id="come-si-parte">
    <div class="container">
      <div class="section-head center" data-reveal>
        <p class="eyebrow">Come si parte</p>
        <h2 class="h2">Tre passi, <span class="gradient-text">nessun impegno</span></h2>
      </div>
      <ol class="go" data-stagger="150">
        {steps.map((s, i) => (
          <li data-reveal>
            <span class="step-num">{i + 1}</span>
            <h3 class="h4">{s.title}</h3>
            <p>{s.text}</p>
            {i === 0 && <a href="/guida" class="link-arrow">Scarica la guida <Icon name="arrow" size={16} /></a>}
            {i === 1 && <a href={site.demoUrl} class="link-arrow" target="_blank" rel="noopener noreferrer">Apri l’hotel demo <Icon name="arrowUpRight" size={16} /></a>}
            {i === 2 && <a href={site.bookings} class="link-arrow" target="_blank" rel="noopener noreferrer">Scegli giorno e ora <Icon name="arrowUpRight" size={16} /></a>}
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ============================================ FAQ -->
  <section class="section" id="faq">
    <div class="container container-narrow">
      <div class="section-head center" data-reveal>
        <p class="eyebrow">Domande frequenti</p>
        <h2 class="h2">Prima di <span class="gradient-text">iniziare</span></h2>
      </div>
      <div class="faq" data-stagger="80">
        {faq.map((f, i) => (
          <details data-reveal open={i === 0}>
            <summary>{f.q}<span class="faq-ic" aria-hidden="true"></span></summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <RequestForm />
</Base>

<style>
  /* ---------- Hero ---------- */
  .hero { padding-block: clamp(56px, 7vw, 96px) clamp(72px, 9vw, 120px); }
  .hero .b1 { width: 560px; height: 560px; left: -200px; top: -200px; background: rgba(241,196,14,.3); }
  .hero .b2 { width: 420px; height: 420px; right: -120px; bottom: -160px; background: rgba(241,196,14,.18); animation-delay: -8s; }
  .hero-grid { display: grid; grid-template-columns: 1.05fr .95fr; gap: clamp(32px, 5vw, 64px); align-items: center; }
  .hero .badge { margin-bottom: 26px; }
  .hero .lead { margin-top: 24px; max-width: 56ch; }
  .hero .btn-row { margin-top: 34px; }
  .hero-points { display: grid; grid-template-columns: 1fr 1fr; gap: 10px 22px; margin-top: 36px; }
  .hero-points li { display: flex; align-items: flex-start; gap: 9px; color: #fff !important; font-size: .92rem; line-height: 1.4; }
  .hero-points :global(svg) { flex: none; margin-top: 2px; padding: 2px; width: 18px; height: 18px; border-radius: 50%; background: var(--accent); color: #000; }
  @media (max-width: 1000px) { .hero-grid { grid-template-columns: 1fr; } }
  @media (max-width: 560px) { .hero-points { grid-template-columns: 1fr; } }

  /* Orbita */
  .orbit-wrap { display: flex; justify-content: center; }
  .orbit { position: relative; width: min(500px, 92vw); aspect-ratio: 1; display: grid; place-items: center; --r: min(225px, 36vw); }
  .ring { position: absolute; inset: 0; border-radius: 50%; border: 1px dashed rgba(255,255,255,.18); }
  .r1 { inset: 0; animation: spin 60s linear infinite; }
  .r2 { inset: 22%; border-style: solid; border-color: rgba(241,196,14,.22); box-shadow: 0 0 80px -10px rgba(241,196,14,.3) inset; }
  .planets { position: absolute; inset: 0; animation: spin 48s linear infinite; }
  .planets li { position: absolute; left: 50%; top: 50%; transform: rotate(var(--a)) translateY(calc(var(--r) * -1)) rotate(calc(var(--a) * -1)); }
  .planet {
    display: inline-flex; align-items: center; gap: 7px;
    padding: 8px 14px; border-radius: 100px;
    background: #161616; border: 1px solid rgba(255,255,255,.16);
    color: #fff; font-size: .8rem; font-weight: 600; white-space: nowrap;
    transform: translate(-50%, -50%);
    animation: spin-rev 48s linear infinite;
    box-shadow: 0 10px 30px -10px rgba(0,0,0,.8);
  }
  .planet :global(svg) { color: var(--accent); }
  .planets li:nth-child(odd) .planet { background: var(--accent); color: #000; border-color: var(--accent); }
  .planets li:nth-child(odd) .planet :global(svg) { color: #000; }
  @keyframes spin { to { transform: rotate(360deg); } }
  @keyframes spin-rev { from { transform: translate(-50%, -50%) rotate(0); } to { transform: translate(-50%, -50%) rotate(-360deg); } }
  .orbit:hover .planets, .orbit:hover .planet, .orbit:hover .r1 { animation-play-state: paused; }

  .guest {
    position: relative; z-index: 2;
    width: min(260px, 60%);
    padding: 18px;
    border-radius: 20px;
    background: #fff; color: #111;
    box-shadow: 0 30px 70px -20px rgba(0,0,0,.9), 0 0 0 6px rgba(241,196,14,.15);
    animation: float-y 7s ease-in-out infinite;
  }
  .g-head { display: flex; align-items: center; gap: 10px; }
  .g-av { display: grid; place-items: center; width: 40px; height: 40px; border-radius: 50%; background: var(--accent); font-weight: 800; font-size: .85rem; }
  .guest b { display: block; font-weight: 700; }
  .guest small { display: block; font-size: .72rem; color: var(--muted); }
  .g-stats { display: grid; grid-template-columns: 1fr auto; gap: 10px; margin-top: 14px; padding: 10px 12px; border-radius: 12px; background: var(--paper); }
  .g-stats b { font-family: var(--font-display); font-size: 1.1rem; font-weight: 800; }
  .g-tags { display: flex; flex-wrap: wrap; gap: 5px; margin-top: 12px; }
  .g-tags span { padding: 3px 9px; border-radius: 100px; background: var(--accent-100); font-size: .7rem; font-weight: 600; }
  .g-row { display: flex; align-items: center; gap: 6px; margin-top: 12px; font-size: .74rem; color: var(--muted); }
  .g-row :global(svg) { color: var(--accent-700); }
  @media (max-width: 560px) {
    .planet { padding: 6px 10px; font-size: .7rem; }
    .planet :global(svg) { display: none; }
    .guest { padding: 14px; }
  }

  /* ---------- Tipi di struttura ---------- */
  .types { padding-block: 22px; border-bottom: 1px solid var(--line); background: #fff; }
  .type { display: inline-flex; align-items: center; gap: 9px; padding: 10px 18px; border-radius: 100px; background: var(--paper); font-weight: 600; font-size: .92rem; white-space: nowrap; }
  .type :global(svg) { color: var(--accent-700); }

  /* ---------- Card con luce che segue il mouse ---------- */
  :global([data-tilt]) { transition: transform .25s var(--ease-out), box-shadow .45s var(--ease-out), border-color .3s var(--ease); }
  .card[data-tilt]::before, .app-card::before {
    content: ''; position: absolute; inset: 0; border-radius: inherit; pointer-events: none;
    background: radial-gradient(320px circle at var(--mx, 50%) var(--my, 50%), rgba(241,196,14,.18), transparent 60%);
    opacity: 0; transition: opacity .3s var(--ease);
  }
  .card[data-tilt]:hover::before, .app-card:hover::before { opacity: 1; }

  /* ---------- App ---------- */
  .apps { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; }
  .app-card {
    position: relative;
    display: flex; flex-direction: column;
    padding: 28px;
    border-radius: var(--radius-lg);
    background: #fff;
    border: 1px solid var(--line);
    overflow: hidden;
  }
  .app-card:hover { border-color: var(--accent); box-shadow: var(--shadow-lg); }
  .app-card.wide { grid-column: span 2; grid-row: span 2; display: grid; grid-template-columns: 1fr 1fr; grid-template-rows: auto auto auto 1fr auto; column-gap: 28px; background: var(--black); border-color: var(--black); color: #fff; }
  .app-card.wide > :not(.app-mock) { grid-column: 1; }
  .app-card.wide p { color: var(--muted-dark); }
  .app-card.wide .app-n { color: rgba(255,255,255,.15); }
  .app-card.wide .app-more { color: #fff; }
  .app-card.wide .app-phase { background: rgba(241,196,14,.14); color: var(--accent); }
  .app-mock { grid-column: 2; grid-row: 1 / -1; align-self: center; }
  .app-top { display: flex; justify-content: space-between; align-items: flex-start; }
  .app-top .icon-chip { margin-bottom: 18px; }
  .app-card:hover .icon-chip { transform: translateY(-3px) rotate(-6deg); }
  .app-n { font-family: var(--font-display); font-weight: 800; font-size: 2.4rem; line-height: 1; color: var(--grey-100); }
  .app-phase { align-self: flex-start; padding: 4px 11px; border-radius: 100px; background: var(--paper); font-size: .72rem; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: var(--muted); }
  .app-card h3 { margin-top: 12px; }
  .app-card p { margin-top: 10px; color: var(--muted); font-size: .96rem; flex: 1; }
  .app-more { display: inline-flex; align-items: center; gap: 8px; margin-top: 20px; font-weight: 650; font-size: .93rem; border-bottom: 2px solid var(--accent); align-self: flex-start; padding-bottom: 2px; }
  .app-more :global(svg) { transition: transform .35s var(--ease-out); }
  .app-card:hover .app-more :global(svg) { transform: translateX(5px); }
  @media (max-width: 1000px) {
    .apps { grid-template-columns: 1fr 1fr; }
    .app-card.wide { grid-template-columns: 1fr; grid-row: auto; }
    .app-mock { grid-column: 1; grid-row: auto; margin-top: 24px; }
  }
  @media (max-width: 640px) {
    .apps { grid-template-columns: 1fr; }
    .app-card.wide { grid-column: auto; }
  }

  /* ---------- Ospite ---------- */
  .guest-grid { display: grid; grid-template-columns: 1.1fr .9fr; gap: clamp(36px, 5vw, 72px); align-items: center; }
  .gf { display: flex; gap: 14px; }
  .gf-ic { display: grid; place-items: center; width: 42px; height: 42px; flex: none; border-radius: 12px; background: var(--accent); }
  .gf p { margin-top: 4px; color: var(--muted); font-size: .94rem; }
  .guest-visual { position: relative; }
  .guest-visual img { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; border-radius: var(--radius-xl); }
  .feed { position: absolute; left: -28px; bottom: 28px; display: grid; gap: 8px; width: min(300px, 80%); }
  .feed-item { display: flex; align-items: center; gap: 10px; padding: 10px 14px; border-radius: 14px; background: rgba(255,255,255,.96); box-shadow: var(--shadow-lg); backdrop-filter: blur(8px); }
  .feed-item > span { display: grid; place-items: center; width: 30px; height: 30px; flex: none; border-radius: 9px; background: var(--black); color: var(--accent); }
  .feed-item b { display: block; font-size: .82rem; }
  .feed-item small { display: block; font-size: .76rem; color: var(--muted); }
  :global(html.js) .feed:not(.playing) .feed-item { opacity: 0; }
  .feed.playing .feed-item { animation: feed-in .6s var(--ease-out) calc(.2s + var(--i) * .45s) both; }
  @keyframes feed-in { from { opacity: 0; transform: translateX(-24px); } to { opacity: 1; transform: none; } }
  .demo-note { position: absolute; top: 16px; right: 16px; padding: 4px 10px; border-radius: 100px; background: rgba(0,0,0,.6); color: #fff; font-size: .72rem; }
  @media (max-width: 900px) {
    .guest-grid { grid-template-columns: 1fr; }
    .feed { left: 16px; }
  }

  /* ---------- Dashboard ---------- */
  .dash { margin-top: 40px; padding: 28px; border-radius: var(--radius-lg); background: rgba(255,255,255,.04); border: 1px solid var(--line-dark); }
  .dash-bars { display: grid; grid-template-columns: repeat(12, 1fr); align-items: end; gap: 10px; height: 180px; }
  .dash-bars span { display: flex; align-items: flex-end; height: 100%; }
