---
/* Home: la sintesi del sito, nell'ordine in cui si convince una persona.
   1 Promessa · 2 Per chi · 3 Problema · 4 Quanto ti costa · 5 Soluzione ·
   6 Come funziona · 7 Prove · 8 Prezzi · 9 Chi siamo · 10 Azione (demo) ·
   11 Dubbi · 12 Chiusura. Ogni capitolo rimanda alla sua pagina completa. */
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import CTASection from '../components/CTASection.astro';
import RequestForm from '../components/RequestForm.astro';
import Calculator from '../components/Calculator.astro';
import FaqList from '../components/FaqList.astro';
import Pains from '../components/sections/Pains.astro';
import GuestIdea from '../components/sections/GuestIdea.astro';
import Phases from '../components/sections/Phases.astro';
import Cases from '../components/sections/Cases.astro';
import Pricing from '../components/sections/Pricing.astro';
import { site, propertyTypes, faq } from '../data/site.js';
import { chiSiamo } from '../data/pages.js';

const schema = [
  {
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<Base
  title="CRM Hotellerie | Più conosci l’ospite, meno paghi per riaverlo"
  description="Porta gli ospiti dai portali al tuo sito e falli tornare. Sblocca gratis la demo di Hotel Soleluna e scopri CRM Hotellerie, costruito su Zoho da MINEO S.r.l."
  keywords={['CRM hotel', 'prenotazioni dirette hotel', 'fidelizzazione ospiti', 'commissioni OTA', 'marketing hotel', 'Zoho hotel']}
  schema={schema}
>
  <!-- 1 · LA PROMESSA -->
  <section class="hero section-dark">
    <div class="hero-photo" aria-hidden="true">
      <img src="/img/photos/davanti-mare.webp" alt="" fetchpriority="high" />
    </div>
    <div class="grid-lines" aria-hidden="true"></div>
    <div class="container relative hero-grid">
      <div>
        <p class="badge rise"><span class="dot"></span> Per hotel che vogliono più ospiti diretti</p>
        <h1 class="display rise" style="--d:100ms">
          Più conosci l’ospite, <span class="gradient-text">meno paghi per riaverlo</span>
        </h1>
        <p class="lead rise" style="--d:200ms">
          CRM Hotellerie porta gli ospiti dai portali al tuo sito e li fa tornare, anno dopo anno,
          senza commissioni. È costruito su Zoho e configurato sul tuo hotel da {site.legal},
          Zoho Authorized Partner da {site.partnerYears} anni.
        </p>
        <div class="btn-row rise" style="--d:300ms">
          <a href="/demo" class="btn btn-primary btn-lg"><Icon name="key" size={18} /> Sblocca la demo gratuita</a>
          <a href="#calcolatore" class="btn btn-ghost btn-lg">Quanto paghi ai portali?</a>
        </div>
        <p class="hero-note rise" style="--d:380ms">
          Si apre subito, senza chiamate.
          <a href={site.bookings} target="_blank" rel="noopener noreferrer">Preferisci parlarne? Prenota una consulenza</a>
        </p>
      </div>

      <!-- Il momento: l'ospite torna, e prenota da te -->
      <div class="moment rise" style="--d:260ms" aria-hidden="true">
        <div class="guest">
          <div class="g-head">
            <span class="g-av">GR</span>
            <div><b>Giulia R.</b><small>4° soggiorno · ospite abituale</small></div>
          </div>
          <div class="g-tags"><span>Vista mare</span><span>Spa</span><span>Anniversario a giugno</span></div>
        </div>
        <div class="notes">
          <div class="note n1"><Icon name="mail" size={15} stroke={2} /><span><b>“Il vostro anniversario si avvicina”</b><small>email aperta · 2 clic</small></span></div>
          <div class="note n2"><Icon name="key" size={15} stroke={2} /><span><b>Prenotazione diretta</b><small>3 notti · Deluxe vista mare</small></span></div>
          <div class="note n3 hl"><Icon name="wallet" size={15} stroke={2} /><span><b>€ 97 di commissione risparmiata</b><small>questa volta non è passata dal portale</small></span></div>
        </div>
        <p class="moment-cap">Esempio dimostrativo</p>
      </div>
    </div>
  </section>

  <!-- 2 · PER CHI -->
  <section class="types" aria-label="Per chi è">
    <div class="marquee">
      <div class="marquee-track">
        {[...propertyTypes, ...propertyTypes].map((t) => <span class="type"><Icon name="building" size={16} /> {t}</span>)}
      </div>
    </div>
  </section>


  <!-- 3 · IL PROBLEMA -->
  <Pains more />

  <!-- 4 · QUANTO TI COSTA -->
  <div class="section-paper"><Calculator /></div>

  <!-- 5 · LA SOLUZIONE -->
  <GuestIdea more />

  <!-- 6 · COME FUNZIONA -->
  <Phases more />

  <!-- 7 · LE PROVE -->
  <Cases more />

  <!-- 8 · I PREZZI -->
  <div class="section-paper"><Pricing more /></div>

  <!-- 9 · CHI SIAMO -->
  <section class="section-sm">
    <div class="container">
      <div class="who" data-reveal>
        <div class="who-txt">
          <p class="eyebrow">Chi ti segue</p>
          <h2 class="h3">{site.legal}, Zoho Authorized Partner da {site.partnerYears} anni</h2>
          <p>Da Lainate (Milano) configuriamo Zoho per aziende e hotel. Prima ascoltiamo come lavori, poi costruiamo il sistema intorno a te, e restiamo al tuo fianco dopo.</p>
          <ul class="who-vals">{chiSiamo.values.map((v) => <li><Icon name={v.icon} size={16} /> {v.title}</li>)}</ul>
        </div>
        <div class="who-side">
          <img src="/img/partner-autorizzato-zoho.webp" alt="Zoho Authorized Partner" width="700" height="195" loading="lazy" />
          <a href="/chi-siamo" class="link-arrow">Conosci Mineo <Icon name="arrow" size={16} /></a>
        </div>
      </div>
    </div>
  </section>

  <!-- 10 · L'AZIONE -->
  <RequestForm />

  <!-- 11 · I DUBBI -->
  <section class="section section-paper" id="faq">
    <div class="container container-narrow">
      <div class="section-head center" data-reveal>
        <p class="eyebrow">Domande frequenti</p>
        <h2 class="h2">Prima di <span class="gradient-text">iniziare</span></h2>
      </div>
      <FaqList items={faq} />
      <p class="faq-more" data-reveal><a href="/faq" class="link-arrow">Tutte le domande <Icon name="arrow" size={16} /></a></p>
    </div>
  </section>

  <!-- 12 · CHIUSURA -->
  <CTASection
    eyebrow="L’ultima cosa"
    title="Il prossimo ospite che torna, fallo prenotare da te"
    text="Apri Hotel Soleluna e guarda con i tuoi occhi come un ospite diventa un ospite di ritorno."
    primary={{ href: '/demo', label: 'Sblocca la demo gratuita' }}
  />
</Base>

<style>
  /* ---------- Hero ---------- */
  .hero { padding-block: clamp(56px, 7vw, 100px) clamp(72px, 9vw, 120px); }
  .hero-photo { position: absolute; inset: 0; overflow: hidden; }
  .hero-photo img { width: 100%; height: 120%; object-fit: cover; opacity: .32; animation: kenburns 24s ease-in-out infinite alternate; }
  .hero-photo::after { content: ''; position: absolute; inset: 0; background: linear-gradient(90deg, #000 18%, rgba(0,0,0,.72) 55%, rgba(0,0,0,.35)), linear-gradient(0deg, #0b0b0b, transparent 40%); }
  @keyframes kenburns { from { transform: scale(1); } to { transform: scale(1.12) translateX(-2%); } }
  .hero-grid { display: grid; grid-template-columns: 1.1fr .9fr; gap: clamp(32px, 5vw, 64px); align-items: center; }
  .hero .badge { margin-bottom: 26px; }
  .hero .lead { margin-top: 24px; max-width: 56ch; color: #d6d3cf; }
  .hero .btn-row { margin-top: 34px; }
  .hero-note { margin-top: 18px; font-size: .9rem; }
  .hero-note a { margin-left: 6px; color: #fff; border-bottom: 2px solid var(--accent); }
  @media (max-width: 1000px) { .hero-grid { grid-template-columns: 1fr; } }

  /* Il momento */
  .moment { position: relative; display: grid; gap: 14px; max-width: 420px; justify-self: center; width: 100%; }
  .guest { padding: 18px; border-radius: 20px; background: #fff; color: #111; box-shadow: 0 30px 70px -20px rgba(0,0,0,.9), 0 0 0 6px rgba(176,223,247,.15); animation: float-y 7s ease-in-out infinite; }
  .g-head { display: flex; align-items: center; gap: 10px; }
  .g-av { display: grid; place-items: center; width: 44px; height: 44px; border-radius: 50%; background: var(--accent); font-weight: 800; }
  .guest b { display: block; font-weight: 700; }
  .guest small { display: block; font-size: .76rem; color: var(--muted); }
  .g-tags { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 12px; }
  .g-tags span { padding: 4px 10px; border-radius: 100px; background: var(--accent-100); font-size: .72rem; font-weight: 600; }
  .notes { display: grid; gap: 10px; padding-left: 28px; border-left: 2px dashed rgba(176,223,247,.4); margin-left: 22px; }
  .note { display: flex; align-items: center; gap: 12px; padding: 12px 14px; border-radius: 14px; background: rgba(20,20,20,.88); border: 1px solid rgba(255,255,255,.12); backdrop-filter: blur(8px); opacity: 0; animation: note-in .7s var(--ease-out) both; }
  .note > :global(svg) { color: var(--accent); flex: none; }
  .note b { display: block; font-size: .86rem; color: #fff; font-weight: 650; }
  .note small { display: block; font-size: .74rem; color: var(--muted-dark); }
  .note.hl { background: var(--accent); border-color: var(--accent); }
  .note.hl b, .note.hl small, .note.hl > :global(svg) { color: #000; }
  .n1 { animation-delay: 1s; } .n2 { animation-delay: 1.9s; } .n3 { animation-delay: 2.8s; }
  @keyframes note-in { from { opacity: 0; transform: translateX(-16px); } to { opacity: 1; transform: none; } }
  .moment-cap { font-size: .72rem; color: var(--muted-dark); text-align: right; }

  /* ---------- Per chi ---------- */
  .types { padding-block: 22px; border-bottom: 1px solid var(--line); background: #fff; }
  .type { display: inline-flex; align-items: center; gap: 9px; padding: 10px 18px; border-radius: 100px; background: var(--paper); font-weight: 600; font-size: .92rem; white-space: nowrap; }
  .type :global(svg) { color: var(--accent-700); }


  /* ---------- Chi siamo (anteprima) ---------- */
  .who { display: grid; grid-template-columns: 1.5fr .7fr; gap: 32px 48px; align-items: center; padding: clamp(28px, 4vw, 44px); border-radius: var(--radius-xl); background: var(--paper); border: 1px solid var(--line); }
  .who-txt p:not(.eyebrow) { margin-top: 10px; color: var(--muted); }
  .who-vals { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 18px; }
  .who-vals li { display: inline-flex; align-items: center; gap: 7px; padding: 7px 14px; border-radius: 100px; background: #fff; border: 1px solid var(--line); font-size: .86rem; font-weight: 600; }
  .who-vals :global(svg) { color: var(--accent-700); }
  .who-side { display: grid; gap: 18px; justify-items: start; }
  .who-side img { width: 220px; height: auto; border-radius: 8px; }
  .faq-more { margin-top: 28px; text-align: center; }
  @media (max-width: 860px) { .who { grid-template-columns: 1fr; } }
</style>
