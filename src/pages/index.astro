---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Waves from '../components/Waves.astro';
import LeadForm from '../components/LeadForm.astro';
import ZohoLeadForm from '../components/ZohoLeadForm.astro';
import ZohoLeadFormFull from '../components/ZohoLeadFormFull.astro';
import CtaBand from '../components/CtaBand.astro';
import WidgetShowcase from '../components/WidgetShowcase.astro';
import Faq from '../components/Faq.astro';
import {
  site, u, seo, photo, heroPhases, benefits, marketing, tailor, zohoStats, insights,
  modules, pmsPoints, steps, consultPoints, faq, demoUnlock,
  guestRecord, guestCard, guestUses, zohoRoles, payItems, zohoApps,
} from '../data/site.js';

const heroImg = photo('struttura-hero');

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: site.product,
    applicationCategory: 'BusinessApplication',
    applicationSubCategory: 'CRM e marketing per hotel',
    operatingSystem: 'Web',
    url: site.url,
    description: seo.description,
    inLanguage: 'it-IT',
    audience: { '@type': 'BusinessAudience', audienceType: 'Proprietari e direttori di hotel e strutture ricettive' },
    featureList: [
      'Scheda ospite e segmentazione', 'Marketing automation', 'Chat sul sito e analisi del funnel',
      'Booking engine collegato al sito', 'Channel manager Channex', 'Planning camere anti-overbooking',
      'Housekeeping e manutenzione', 'Alloggiati Web e ISTAT', 'Fatturazione elettronica SdI', 'Dashboard RevPAR e ADR',
    ],
    provider: { '@id': `${site.url}/#org` },
    offers: { '@type': 'Offer', description: 'Consulenza gratuita sui numeri reali della struttura', price: '0', priceCurrency: 'EUR', availability: 'https://schema.org/InStock' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': `${site.url}/#org`,
    name: site.legal,
    url: site.mainSite,
    email: site.email,
    vatID: site.vatNumber,
    sameAs: [site.linkedin],
    address: { '@type': 'PostalAddress', streetAddress: site.addressStreet, postalCode: site.addressZip, addressLocality: site.addressCity, addressRegion: site.addressRegion, addressCountry: 'IT' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: site.brand,
    url: site.url,
    inLanguage: 'it-IT',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];
---

<Base title={seo.title} description={seo.description} path="/" home={true} schema={schema}>
  <!-- ============================================ STEP 1 · HERO: SI CAPISCE IN 3 SECONDI + STEP 2 · LEAD -->
  <section class="hero" aria-labelledby="h1">
    <Waves />
    <div class="container hero-in">
      <div class="hero-copy">
        <p class="badge rise" style="--d:40ms"><span class="dot"></span> Marketing + CRM per hotel · su Zoho</p>
        <h1 class="display rise" id="h1" style="--d:120ms">
          <span class="mark">Tutto Zoho</span>, cucito sul tuo hotel
        </h1>
        <p class="lead rise" style="--d:200ms">
          Chat sul sito, registrazione di ogni evento e storico completo di clienti e servizi.
          Analizzi i dati, riparti da lì con le app di marketing Zoho e <b>tieni traccia di tutto</b>:
          i dati restano tuoi.
        </p>

        <div class="htailor rise" style="--d:260ms" aria-label="Come lo cuciamo sul tuo hotel">
          {tailor.map((t) => (
            <article class="ht-card">
              <span class="ht-ic"><Icon name={t.icon} size={20} /></span>
              <div><h3>{t.title}</h3><p>{t.text}</p></div>
            </article>
          ))}
        </div>

        <p class="punch rise" style="--d:380ms"><b>Tieni traccia di tutto.</b> Più conosci l’ospite, meno paghi per riaverlo.</p>

        <div class="hero-trust rise" style="--d:440ms">
          <img src={u('/img/zoho-authorized-partner.png')} alt="Zoho Authorized Partner" width="900" height="251" />
          <span>Zoho CRM e marketing, personalizzati per l’hotel.<br />Zoho Authorized Partner da {site.partnerYears} anni.</span>
        </div>
      </div>

      <div class="lead-card rise" id="hero-lead" style="--d:240ms">
        <span class="lead-tag">Demo gratuita</span>
        <h2>Scopri come seguire ogni ospite dall’inizio alla fine</h2>
        <p class="lead-sub">Sblocca la demo gratuita: chat, eventi e storico in funzione sull’hotel dimostrativo, poi ti richiamiamo per la consulenza.</p>
        <ol class="lead-steps" aria-label="Come funziona">
          <li><b>1</b> Dati</li>
          <li><b>2</b> Demo</li>
          <li><b>3</b> Consulenza</li>
        </ol>
        <ZohoLeadForm />
      </div>
    </div>
  </section>

  <!-- ============================================ L'OSPITE AL CENTRO: LA SCHEDA OSPITE (CRM) -->
  <section class="section section-paper" id="ospite">
    <div class="container">
      <div class="split">
        <div data-reveal="left">
          <p class="eyebrow">L’ospite al centro</p>
          <h2 class="h2">Una scheda per ogni ospite, <strong>che il gestionale non ti dà</strong></h2>
          <p class="lead mt-2">Il gestionale registra soggiorni e conti. CRM Hotellerie ricorda chi è l’ospite: da dove arriva, cosa spende, cosa gli piace e cosa ha accettato di ricevere. Da qui partono le campagne che lo riportano sul tuo sito.</p>
          <ul class="check-list mt-3">{guestRecord.map((g) => <li><b>{g.title}</b>: {g.text}</li>)}</ul>
        </div>
        <div class="gcard" data-reveal="right" aria-label="Esempio di scheda ospite con dati dimostrativi">
          <div class="gcard-head">
            <span class="gcard-av" aria-hidden="true">{guestCard.initials}</span>
            <div><b>{guestCard.name}</b><span>{guestCard.sub}</span></div>
            <span class="gcard-seg">{guestCard.segment}</span>
          </div>
          <dl class="gcard-grid">
            {guestCard.rows.map((r) => <div><dt>{r.k}</dt><dd>{r.v}</dd></div>)}
          </dl>
          <div class="gcard-next"><Icon name="bolt" size={16} /><span><b>Prossima azione</b>{guestCard.next}</span></div>
          <p class="gcard-note">Esempio con dati dimostrativi</p>
        </div>
      </div>

      <div class="grid grid-3 uses" data-stagger="90">
        {guestUses.map((g) => (
          <article class="card" data-reveal>
            <span class="icon-chip"><Icon name={g.icon} /></span>
            <h3 class="h4">{g.title}</h3>
            <p>{g.text}</p>
          </article>
        ))}
      </div>

      <CtaBand id="cta-ospite" dark={false} title="Quanti dei tuoi ospiti sono tornati l’anno scorso?" text="Nella consulenza lo misuriamo sui tuoi dati e vediamo quanti potresti riportare sul canale diretto." label="Prenota una consulenza gratuita" href={site.bookingUrl} />
    </div>
  </section>

  <!-- ============================================ MARKETING ALBERGHIERO -->
  <section class="section section-dark" id="marketing">
    <Waves flip class="waves-soft" />
    <div class="container relative">
      <div class="section-head" data-reveal>
        <p class="eyebrow">Marketing alberghiero</p>
        <h2 class="h2">Dal widget alla fidelizzazione: <strong>recupera la domanda che il tuo sito oggi perde</strong></h2>
        <p class="lead">Un gestionale sa dire quanto hai venduto. Il nostro stack sa dire anche quanto ti è stato chiesto e non hai potuto vendere: sessioni, ricerche senza esito e abbandoni, dati che un booking engine chiuso non restituisce mai.</p>
      </div>
      <div class="grid grid-4" data-stagger="70">
        {marketing.map((m) => (
          <article class="card card-dark" data-reveal>
            <span class="icon-chip"><Icon name={m.icon} /></span>
            <h3 class="h4">{m.tool}</h3>
            <p>{m.text}</p>
          </article>
        ))}
        <article class="card cta-card" data-reveal>
          <h3 class="h4">Vuoi vedere dove perdi prenotazioni?</h3>
          <a href={site.bookingUrl} target="_blank" rel="noopener" class="btn btn-white btn-sm" data-cta="marketing-card">Prenota una consulenza gratuita <Icon name="arrow" size={16} /></a>
        </article>
      </div>
    </div>
  </section>

  <!-- ============================================ DASHBOARD -->
  <section class="section" id="dashboard">
    <div class="container">
      <div class="split">
        <div data-reveal="left">
          <p class="eyebrow">Dashboard</p>
          <h2 class="h2">I numeri che un gestionale da solo <strong>non mostra</strong></h2>
          <p class="lead mt-2">Occupazione e fatturato li sa dire chiunque. Qui si legge anche la domanda che la struttura ha respinto: scoprire di aver respinto quattrocento richieste in agosto fa capire in un secondo quanti soldi restano sul tavolo.</p>
          <ul class="check-list mt-3">{insights.map((i) => <li><b>{i.title}</b> — {i.text}</li>)}</ul>
        </div>
        <div class="cfg" data-reveal="right">
          <div class="cfg-glow" aria-hidden="true"></div>
          <figure class="cfg-main">
            <div class="cfg-chrome" aria-hidden="true"><i></i><i></i><i></i><span>Configurazione Hotel · Tariffe</span></div>
            <img src={u('/img/widget/config-tariffe.jpg')} alt="Configurazione Hotel: periodi di stagione, regole per giorno della settimana e calendario tariffe" width="1800" height="880" loading="lazy" decoding="async" />
          </figure>
          <figure class="cfg-side">
            <div class="cfg-chrome" aria-hidden="true"><i></i><i></i><i></i><span>Configurazione · Hotel</span></div>
            <img src={u('/img/widget/config-menu.jpg')} alt="Menu di configurazione con le aree Hotel - Prenotazioni e Hotel - Interventi" width="1800" height="880" loading="lazy" decoding="async" />
          </figure>
          <span class="cfg-badge cfg-b1"><Icon name="sun" size={15} /> Stagioni e tariffe</span>
          <span class="cfg-badge cfg-b2"><Icon name="cog" size={15} /> Tutto configurabile</span>
          <p class="cfg-note">Schermate reali del CRM Hotellerie · dati dimostrativi</p>
        </div>
      </div>
      <CtaBand id="cta-dashboard" dark={false} title="Scopri quanto margine resta sul tavolo" text="Nella consulenza leggiamo insieme i numeri della tua struttura." label="Prenota una consulenza gratuita" href={site.bookingUrl} />
    </div>
  </section>

  <!-- ============================================ PERCHÉ CRM HOTEL (compatto) -->
  <section class="section section-paper" id="perche-crm">
    <div class="container">
      <div class="section-head center" data-reveal>
        <p class="eyebrow">Perché CRM Hotellerie</p>
        <h2 class="h2">Tre risultati, <strong>un solo sistema</strong></h2>
        <p class="lead">Vendi di più sul canale diretto, coordini i reparti su un unico calendario e lasci che gli adempimenti partano da soli.</p>
      </div>

      <div class="why3" data-stagger="110">
        {benefits.map((b) => (
          <article class="why-card" id={b.id} data-reveal>
            <div class="photo why-photo"><img src={photo(b.img)} alt={b.alt} width="1400" height="1050" loading="lazy" decoding="async" style={b.pos ? `--pos:${b.pos}` : undefined} /></div>
            <div class="why-body">
              <p class={`kick kick-${b.color}`}><i class={`pdot pdot-${b.color}`}></i>{b.kicker}</p>
              <h3 class="h3">{b.title}</h3>
              <p class="why-text">{b.text}</p>
              <ul class="check-list">{b.bullets.map((x) => <li>{x}</li>)}</ul>
            </div>
          </article>
        ))}
      </div>

      <CtaBand id="cta-why" title="Scopri quanto vale riprenderti i tuoi dati" text="Prenota la consulenza: vedi come il dato dell’ospite resta tuo, dal primo clic al ritorno." label="Prenota una consulenza gratuita" href={site.bookingUrl} />
    </div>
  </section>

  <!-- ============================================ IL WIDGET DAL VIVO: SCHERMATE REALI -->
  <section class="section" id="widget">
    <div class="container">
      <div class="section-head center" data-reveal>
        <p class="eyebrow">Il widget dal vivo</p>
        <h2 class="h2">Guarda cosa succede dentro: <strong>dalla prima visita al check-out</strong></h2>
        <p class="lead">Schermate reali del CRM Hotellerie e delle app Zoho di marketing: ogni passaggio dell’ospite, dalla visita al sito al check-out, è registrato e consultabile da tutti i reparti.</p>
      </div>
      <div data-reveal="none"><WidgetShowcase /></div>
      <CtaBand id="cta-widget" dark={false} title="Vuoi vederlo con i dati del tuo hotel?" text="Nella consulenza ti mostriamo il widget in funzione sulla tua struttura." label="Prenota una consulenza gratuita" href={site.bookingUrl} />
    </div>
  </section>

  <!-- ============================================ CHI FA COSA: LA COLLABORAZIONE CON ZOHO -->
  <section class="section section-paper" id="perche-zoho">
    <div class="container">
      <div class="section-head center" data-reveal>
        <p class="eyebrow">Perché Zoho</p>
        <h2 class="h2">Non un software preconfezionato: <strong>un sistema cucito su misura</strong> sul tuo hotel</h2>
        <p class="lead">Zoho è una piattaforma, non una scatola chiusa. La modelliamo su come lavora la tua struttura — widget, pipeline, reparti, automazioni, dashboard — e la facciamo crescere con te, senza cambiare sistema.</p>
      </div>

      <div class="grid grid-3" data-stagger="100">
        {zohoRoles.map((r) => (
          <article class="card role-card" data-reveal>
            <span class="role-who">{r.who}</span>
            <span class="icon-chip"><Icon name={r.icon} /></span>
            <h3 class="h4">{r.title}</h3>
            <p>{r.text}</p>
            <ul class="check-list role-list">{r.items.map((x) => <li>{x}</li>)}</ul>
          </article>
        ))}
      </div>

      <ul class="zstats" data-stagger="90">
        {zohoStats.map((s) => <li data-reveal="scale"><b>{s.value}</b><span>{s.label}</span></li>)}
      </ul>

      <div class="apps" data-reveal>
        <p class="apps-t">Le app Zoho su cui lavoriamo ogni giorno</p>
        <ul>{zohoApps.map((a) => <li>{a}</li>)}</ul>
      </div>

      <div class="pay" data-reveal>
        <p class="pay-t"><Icon name="wallet" size={18} /> Cosa paghi</p>
        <ul>{payItems.map((x) => <li><b>{x.title}</b>{x.text}</li>)}</ul>
        <p class="pay-note">Le cifre le vediamo in consulenza, sui numeri reali della tua struttura.</p>
      </div>

      <CtaBand id="cta-zoho" dark={false} title="Raccontaci come lavora il tuo hotel" text="Lo cuciamo su di te, a partire dal gestionale che usi oggi." label="Prenota una consulenza gratuita" href={site.bookingUrl} />
    </div>
  </section>

  <!-- ============================================ LA DEMO: LEAD MAGNET -->
  <section class="section demo-site" id="demo-hotel">
    <div class="demo-site-bg" aria-hidden="true"><img src={photo('prenota-ora')} alt="" width="1800" height="1125" loading="lazy" decoding="async" /></div>
    <div class="container relative demo-site-in">
      <div data-reveal>
        <p class="eyebrow">La demo</p>
        <h2 class="h2">Visita l’hotel dimostrativo con il <strong>widget di prenotazione attivo</strong></h2>
        <p class="lead mt-2">Hotel Soleluna è la nostra struttura di prova: sito, widget e CRM collegati. L’accesso si sblocca lasciando i tuoi dati, e subito dopo ti richiamiamo per la consulenza.</p>
        <div class="btn-row mt-4">
          <a href={site.bookingUrl} target="_blank" rel="noopener" class="btn btn-primary btn-lg" data-cta="demo-unlock">Prenota una consulenza gratuita <Icon name="arrow" size={19} /></a>
        </div>
        <p class="lockline"><Icon name="lock" size={16} /> Accesso riservato: lo ricevi subito dopo l’invio dei dati.</p>
      </div>
      <div class="unlock" data-stagger="90">
        {demoUnlock.map((d) => (
          <article class="card card-dark" data-reveal>
            <span class="icon-chip"><Icon name={d.icon} /></span>
            <h3 class="h4">{d.title}</h3>
            <p>{d.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ============================================ DA DOVE PARTI TU -->
  <section class="section" id="percorsi">
    <div class="container">
      <div class="section-head center" data-reveal>
        <p class="eyebrow">Da dove parti tu</p>
        <h2 class="h2">Due strade, <strong>un solo obiettivo</strong></h2>
        <p class="lead">Tutti i dati dell’ospite in un posto solo, qualunque sia il punto di partenza.</p>
      </div>
      <div class="paths" data-stagger="120">
        <article class="path path-a" data-reveal="left">
          <span class="path-tag">Strada A</span>
          <h3 class="h3">Affiancare il PMS che hai già</h3>
          <p>Non devi scegliere: il CRM aggiunge ciò che manca (marketing, fidelizzazione, reparti) e il tuo gestionale resta al suo posto.</p>
          <ul class="check-list mt-3 on-dark">{pmsPoints.map((p) => <li><b>{p.title}</b> — {p.text}</li>)}</ul>
        </article>
        <article class="path path-b" data-reveal="right">
          <span class="path-tag path-tag-alt">Strada B</span>
          <h3 class="h3">Ripartire da zero</h3>
          <p>Per chi apre una nuova struttura o vuole lasciare fogli Excel e messaggi WhatsApp: un solo fornitore, un solo numero da chiamare, un solo conto da pagare.</p>
          <ul class="check-list mt-3">{modules.map((m) => <li><b>{m.title}</b> — {m.text}</li>)}</ul>
        </article>
      </div>
    </div>
  </section>

  <!-- ============================================ COME SI PARTE -->
  <section class="section section-paper" id="come-si-parte">
    <div class="container">
      <div class="section-head center" data-reveal>
        <p class="eyebrow">Come si parte</p>
        <h2 class="h2">Tre passi, <strong>nessun impegno</strong></h2>
      </div>
      <ol class="steps" data-stagger="110">
        {steps.map((s) => (
          <li class="step" data-reveal><span class="step-n">{s.n}</span><div><h3 class="h4">{s.title}</h3><p>{s.text}</p></div></li>
        ))}
      </ol>
      <p class="text-center mt-4"><a href={site.bookingUrl} target="_blank" rel="noopener" class="btn btn-primary btn-lg" data-cta="steps">Prenota una consulenza gratuita <Icon name="arrow" size={19} /></a></p>
    </div>
  </section>

  <!-- ============================================ FORM FINALE (stesso lead magnet) -->
  <section class="section demo" id="demo">
    <Waves class="waves-soft" />
    <div class="container relative">
      <div class="demo-grid">
        <div class="demo-copy" data-reveal="left">
          <p class="eyebrow">Demo gratuita</p>
          <h2 class="h2">Più conosci l’ospite, <strong>meno paghi per riaverlo</strong></h2>
          <p class="lead mt-2">Lasci i dati, ricevi subito l’accesso all’hotel dimostrativo e ti richiamiamo per un confronto sui numeri reali del tuo hotel. Il gestionale che usi oggi resta al suo posto.</p>
          <ul class="demo-points mt-4" data-stagger="90">
            {consultPoints.map((d) => (
              <li data-reveal>
                <span class="demo-ic"><Icon name={d.icon} size={20} /></span>
                <span><b>{d.title}</b><em>{d.text}</em></span>
              </li>
            ))}
          </ul>
          <div class="contact-card mt-4">
            <a href={`https://wa.me/${site.whatsappHref}`} target="_blank" rel="noopener noreferrer" data-cta="form-whatsapp"><Icon name="whatsapp" size={18} /> WhatsApp</a>
            <a href={`mailto:${site.email}`}><Icon name="mail" size={18} /> {site.email}</a>
          </div>
        </div>
        <div class="demo-form" id="form" data-reveal="right"><ZohoLeadFormFull /></div>
      </div>
    </div>
  </section>

  <!-- ============================================ FAQ -->
  <section class="section section-paper" id="faq">
    <div class="container container-narrow">
      <div class="section-head center" data-reveal>
        <p class="eyebrow">Domande frequenti</p>
        <h2 class="h2">Le domande che ci fanno <strong>i proprietari di hotel</strong></h2>
      </div>
      <Faq />
      <CtaBand id="cta-faq" title="Hai ancora un dubbio?" text="Prenota la consulenza o scrivici: rispondiamo noi, in italiano." label="Prenota una consulenza gratuita" href={site.bookingUrl} />
    </div>
  </section>

</Base>

<style>
  /* ---------- Hero ---------- */
  .hero { position: relative; overflow: hidden; padding-block: calc(var(--header-h) + clamp(40px, 6vw, 80px)) clamp(60px, 8vw, 100px); background: #fff; }
  .hero-in { position: relative; z-index: 2; display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, .95fr); gap: clamp(28px, 4.5vw, 60px); align-items: center; }
  @media (max-width: 1000px) { .hero-in { grid-template-columns: minmax(0, 1fr); } }
  .hero-copy .badge { margin-bottom: 22px; }
  .hero-copy .lead { margin-top: 20px; max-width: 54ch; }
  .pillars { display: flex; flex-wrap: wrap; gap: 12px 30px; margin-top: 26px; }
  .pillars li { display: inline-flex; align-items: center; gap: 12px; font-family: var(--font-display); font-weight: 700; font-size: 1.1rem; letter-spacing: .02em; }
  .pdot { display: inline-block; width: 26px; height: 26px; border-radius: 50%; flex: none; }
  .pdot-magenta { background: var(--magenta); } .pdot-teal { background: var(--teal); } .pdot-orange { background: var(--orange); }
  .hero-copy .btn-row { margin-top: 32px; }
  .hero-fine { display: flex; align-items: center; gap: 8px; margin-top: 18px; font-size: .9rem; color: var(--muted); }
  .hero-fine :global(svg) { color: var(--accent-700); }

  /* ---------- Trust ---------- */
  .trust { background: #000; color: #fff; padding-block: 30px; }
  .trust-in { display: grid; grid-template-columns: repeat(4, 1fr); gap: 18px; text-align: center; }
  .trust-in b { color: var(--accent); display: block; font-family: var(--font-display); font-weight: 700; font-size: clamp(1.7rem, 3vw, 2.4rem); line-height: 1.1; }
  .trust-in span { font-size: .86rem; color: var(--muted-dark); font-weight: 300; }
  @media (max-width: 720px) { .trust-in { grid-template-columns: 1fr 1fr; } }

  .strip { background: #fff; padding-block: 28px; border-bottom: 1px solid var(--line); }
  .chip { display: inline-flex; align-items: center; gap: 9px; padding: 10px 20px; border-radius: 100px; border: 1px solid var(--accent-200); background: var(--accent-50); font-family: var(--font-display); font-size: 1rem; color: var(--ink); white-space: nowrap; }

  /* ---------- Zigzag vantaggi ---------- */
  .zig { display: grid; gap: clamp(54px, 7vw, 96px); }
  .zig-row { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(28px, 5vw, 70px); align-items: center; }
  .zig-row.rev .zig-media { order: 2; }
  .zig-media { position: relative; }
  .zig-photo { aspect-ratio: 4 / 3; box-shadow: var(--shadow-lg); border-radius: 28px; }
  .zig-tag { position: absolute; left: 18px; bottom: 18px; padding: 8px 16px; border-radius: 100px; color: #fff; font-family: var(--font-display); font-weight: 700; letter-spacing: .1em; text-transform: uppercase; font-size: .82rem; }
  .tag-magenta { background: var(--accent); color: #000; } .tag-teal { background: var(--grey); } .tag-orange { background: #000; }
  .kick { display: inline-flex; align-items: center; gap: 10px; font-family: var(--font-display); font-weight: 700; letter-spacing: .14em; text-transform: uppercase; font-size: .9rem; margin-bottom: 12px; }
  .kick .pdot { width: 14px; height: 14px; }
  .kick-magenta { color: var(--accent-700); } .kick-teal { color: var(--grey); } .kick-orange { color: #000; }
  .zig-copy .h2 { margin-bottom: 14px; }
  .zig-copy .mt-3 { margin-top: 22px; }
  @media (max-width: 860px) { .zig-row { grid-template-columns: minmax(0, 1fr); } .zig-row.rev .zig-media { order: 0; } }

  /* ---------- Calcolatore ---------- */
  .calc-wrap { display: grid; grid-template-columns: .85fr 1.15fr; gap: clamp(28px, 4vw, 56px); align-items: center; }
  @media (max-width: 1000px) { .calc-wrap { grid-template-columns: minmax(0, 1fr); } }

  /* ---------- Funzioni ---------- */
  .band { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 18px 30px; margin-top: 36px; padding: 24px 32px; border-radius: var(--radius-lg); background: var(--accent-50); border: 1px solid var(--accent-200); }
  .band p { font-family: var(--font-display); font-size: 1.25rem; font-weight: 300; }
  .band b { font-weight: 700; color: var(--ink); }

  /* ---------- Percorsi ---------- */
  .paths { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
  @media (max-width: 900px) { .paths { grid-template-columns: minmax(0, 1fr); } }
  .path { padding: clamp(26px, 3vw, 38px); border-radius: var(--radius-xl); background: #fff; border: 1px solid var(--line); display: flex; flex-direction: column; align-items: flex-start; }
  .path p { color: var(--muted); margin-top: 10px; }
  .path-a { background: #000; border: 0; color: #fff; box-shadow: var(--shadow-lg); }
  .path-a h3 { color: #fff; font-weight: 700; } .path-a p { color: rgba(255,255,255,.88); }
  .path-tag { padding: 5px 14px; border-radius: 100px; background: var(--accent); color: #000; font-family: var(--font-display); font-weight: 700; font-size: .8rem; letter-spacing: .14em; text-transform: uppercase; margin-bottom: 14px; }
  .path-tag-alt { background: var(--paper-2); }
  .path .check-list li { font-size: .95rem; } .path b { font-weight: 700; color: var(--ink); }
  .path-a .check-list li { color: rgba(255,255,255,.9); } .path-a .check-list b { color: #fff; }
  
  /* ---------- Reparti ---------- */
  .shots { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
  .shot { aspect-ratio: 3 / 4; margin: 0; }
  .shot figcaption { position: absolute; inset: auto 0 0 0; padding: 40px 16px 16px; background: linear-gradient(transparent, rgba(0,0,0,.88)); color: #fff; font-family: var(--font-display); font-size: 1.05rem; line-height: 1.25; }
  @media (max-width: 900px) { .shots { grid-template-columns: 1fr 1fr; } }

  /* ---------- Marketing ---------- */
  .section-dark { overflow: hidden; }
  :global(.waves-soft) { opacity: .14; }
  @media (max-width: 760px) { :global(.hero .waves) { opacity: .3; } }
  .demo :global(.waves-soft) { opacity: .5; }
  .cta-card .btn { white-space: normal; text-align: center; line-height: 1.2; }
  .cta-card { background: #fff; display: flex; flex-direction: column; justify-content: space-between; gap: 18px; border: 0; }
  .cta-card h3 { color: var(--ink) !important; font-weight: 700; }
  .cta-card-grad { background: var(--accent); justify-content: center; align-items: flex-start; }
  .cta-card-grad h3, .cta-card-grad p { color: #000 !important; }
