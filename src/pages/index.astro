  /* ---------- Numeri ---------- */
  .split { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(28px, 5vw, 64px); align-items: center; }
  @media (max-width: 900px) { .split { grid-template-columns: minmax(0, 1fr); } }
  .check-list b { color: var(--ink); font-weight: 700; }
  .dash { padding: 24px; border-radius: var(--radius-xl); background: #fff; border: 1px solid var(--line); box-shadow: var(--shadow-lg); }
  .dash-top { display: flex; align-items: center; gap: 6px; margin-bottom: 18px; }
  .dash-top i { width: 10px; height: 10px; border-radius: 50%; background: var(--grey-100); } .dash-top i:first-child { background: var(--accent); } .dash-top i:nth-child(2) { background: var(--grey); } .dash-top i:nth-child(3) { background: #000; }
  .dash-top span { margin-left: auto; font-size: .8rem; color: var(--muted); }
  .dash-kpis { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; }
  .dash-kpis div { padding: 14px 16px; border-radius: 14px; background: var(--paper); }
  .dash-kpis small { display: block; font-family: var(--font-display); font-size: .78rem; letter-spacing: .1em; text-transform: uppercase; color: var(--grey); }
  .dash-kpis b { font-family: var(--font-display); font-size: 1.7rem; color: var(--ink); }
  .dash-h { margin: 22px 0 10px; font-family: var(--font-display); font-weight: 700; letter-spacing: .1em; text-transform: uppercase; font-size: .82rem; color: var(--grey); }
  .dash-bars { display: grid; gap: 12px; }
  .dash-bars li { display: grid; grid-template-columns: 110px 1fr; gap: 12px; align-items: center; font-size: .9rem; }
  .dash-bars div { height: 14px; border-radius: 8px; background: var(--paper-2); overflow: hidden; }
  .dash-bars i { display: block; height: 100%; width: var(--v); border-radius: 8px; }
  .b-m { background: var(--accent); } .b-t { background: var(--grey); } .b-o { background: #000; } .b-p { background: #000; } .b-g { background: var(--grey-300); }
  .dash-stack { display: flex; gap: 4px; height: 38px; }
  .dash-stack i { display: grid; place-items: center; border-radius: 8px; font-style: normal; font-size: .78rem; font-weight: 700; color: #fff; }
  .dash-stack .b-m { color: #000; } .dash-stack .b-g { color: var(--ink); }
  .dash-note { margin-top: 14px; text-align: right; font-size: .72rem; color: var(--grey-300); }

  /* ---------- Demo hotel ---------- */
  .demo-site { position: relative; color: #fff; overflow: hidden; padding-block: clamp(80px, 11vw, 150px); }
  .demo-site-bg, .demo-site-bg img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .demo-site-bg::after { content: ''; position: absolute; inset: 0; background: linear-gradient(100deg, rgba(0,0,0,.92) 0%, rgba(0,0,0,.76) 55%, rgba(0,0,0,.4) 100%); }
  .demo-site-in > div:first-child { max-width: 720px; }
  .demo-site h2, .demo-site .lead { color: #fff; } .demo-site .eyebrow { color: var(--accent); }
  .demo-site .lead { color: rgba(255,255,255,.88); }
  .demo-site .btn-ghost { border-color: rgba(255,255,255,.7); color: #fff; } .demo-site .btn-ghost:hover { background: #fff; color: #000; }

  /* ---------- Steps ---------- */
  .steps { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; counter-reset: s; }
  @media (max-width: 860px) { .steps { grid-template-columns: minmax(0, 1fr); } }
  .step { display: flex; gap: 18px; padding: 28px; border-radius: var(--radius-lg); border: 1px solid var(--line); background: #fff; }
  .step p { color: var(--muted); font-size: .96rem; margin-top: 6px; }
  .step-n { flex: none; display: grid; place-items: center; width: 48px; height: 48px; border-radius: 50%; background: var(--accent); color: #000; font-family: var(--font-display); font-weight: 700; font-size: 1.4rem; }

  /* ---------- Form ---------- */
  .demo { position: relative; overflow: hidden; background: #fff; }
  .demo-grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(30px, 4.5vw, 62px); align-items: start; }
  @media (max-width: 1000px) { .demo-grid { grid-template-columns: minmax(0, 1fr); } }
  .demo-points { display: grid; gap: 18px; }
  .demo-points li { display: flex; gap: 14px; }
  .demo-ic { display: grid; place-items: center; width: 44px; height: 44px; flex: none; border-radius: 50%; background: var(--accent); color: #000; }
  .demo-points b { display: block; font-family: var(--font-display); font-size: 1.15rem; font-weight: 700; }
  .demo-points em { display: block; font-style: normal; font-size: .93rem; color: var(--muted); margin-top: 2px; }
  .contact-card { display: flex; flex-wrap: wrap; gap: 10px 22px; padding: 18px 22px; border-radius: var(--radius); background: var(--accent-50); border: 1px solid var(--accent-200); }
  .contact-card a { display: inline-flex; align-items: center; gap: 8px; font-weight: 500; color: var(--ink); }
  .contact-card a:hover { color: var(--accent-700); }
  .demo-form { position: relative; }
  @media (min-width: 1001px) { .demo-form { position: sticky; top: calc(var(--header-h) + 24px); } }


  /* ---------- Partner ufficiale Zoho ---------- */
  .partner { display: grid; grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr); gap: clamp(28px, 5vw, 70px); align-items: center; }
  @media (max-width: 900px) { .partner { grid-template-columns: minmax(0, 1fr); } }
  .partner-badge { padding: clamp(22px, 3vw, 36px); border-radius: var(--radius-xl); background: #fff; border: 1px solid var(--line); box-shadow: var(--shadow-lg); text-align: center; }
  .partner-badge img { width: 100%; height: auto; border-radius: 18px; }
  .partner-badge p { margin-top: 16px; font-family: var(--font-display); font-size: 1rem; letter-spacing: .08em; text-transform: uppercase; color: var(--muted); }
  .partner-badge b { color: var(--ink); }
  .promises { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px 28px; margin-top: 36px; padding: 20px 26px; border-radius: 100px; background: #000; }
  .promises li { display: inline-flex; align-items: center; gap: 9px; font-size: .94rem; color: #fff; }
  .promises :global(svg) { color: var(--accent); flex: none; }
  @media (max-width: 760px) { .promises { border-radius: var(--radius-lg); flex-direction: column; } }

  /* ---------- Hero lead magnet ---------- */
  .hero { background: #000; color: #fff; }
  .hero::after { content: ''; position: absolute; inset: 0; background: radial-gradient(900px 520px at 8% 0%, rgba(241,196,14,.14), transparent 62%); pointer-events: none; z-index: 1; }
  .hero h1, .hero .display { color: #fff; }
  .hero .mark { color: var(--accent); background-image: none; padding: 0; }
  .hero-copy .lead { color: rgba(255,255,255,.8); }
  .hero .badge { background: rgba(255,255,255,.08); border-color: rgba(255,255,255,.2); color: #fff; }
  .hero-copy .lead b { color: #fff; font-weight: 700; }
  .compare { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-top: 24px; max-width: 620px; }
  @media (max-width: 560px) { .compare { grid-template-columns: minmax(0, 1fr); } }
  .cmp { padding: 14px 16px; border-radius: var(--radius); border: 1px solid rgba(255,255,255,.16); background: rgba(255,255,255,.05); }
  .cmp p { margin-top: 6px; font-size: .9rem; line-height: 1.4; color: rgba(255,255,255,.72); }
  .cmp-t { display: inline-flex; align-items: center; gap: 8px; font-family: var(--font-display); font-weight: 700; letter-spacing: .1em; text-transform: uppercase; font-size: .86rem; color: rgba(255,255,255,.6); }
  .cmp-t :global(svg) { padding: 2px; border-radius: 50%; background: rgba(255,255,255,.18); width: 20px; height: 20px; }
  .cmp-new { background: var(--accent); border-color: var(--accent-600); box-shadow: var(--shadow-accent); }
  .cmp-new .cmp-t { color: #000; } .cmp-new .cmp-t :global(svg) { background: #000; color: var(--accent); }
  .cmp-new p { color: #000; font-weight: 500; }
  .phases { position: relative; display: grid; gap: 16px; margin-top: 26px; max-width: 600px; }
  .phases::before { content: ''; position: absolute; left: 21px; top: 26px; bottom: 26px; width: 3px; border-radius: 3px; background: linear-gradient(var(--accent), rgba(241,196,14,.15)); }
  .phases li { position: relative; display: flex; gap: 16px; align-items: flex-start; }
  .ph-n { position: relative; z-index: 1; display: grid; place-items: center; width: 44px; height: 44px; flex: none; border-radius: 50%; background: var(--accent); color: #000; box-shadow: 0 0 0 4px #000; }
  .ph-t b { display: block; font-family: var(--font-display); font-size: 1.22rem; line-height: 1.2; color: #fff; }
  .ph-t em { display: block; font-style: normal; font-size: .93rem; line-height: 1.45; color: rgba(255,255,255,.72); margin-top: 2px; }
  .ph-tags { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 8px; }
  .ph-tags i { font-style: normal; padding: 3px 11px; border-radius: 100px; border: 1px solid rgba(241,196,14,.5); color: var(--accent); font-family: var(--font-display); font-size: .82rem; letter-spacing: .06em; text-transform: uppercase; }
  .punch { margin-top: 24px; padding-left: 18px; border-left: 4px solid var(--accent); font-family: var(--font-display); font-size: clamp(1.35rem, 2.4vw, 1.8rem); font-weight: 300; line-height: 1.2; color: #fff; }
  .punch b { font-weight: 700; color: var(--accent); }
  .hero-trust { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 20px; margin-top: 26px; font-size: .9rem; color: rgba(255,255,255,.7); }
  .hero-trust img { width: 150px; height: auto; border-radius: 10px; box-shadow: var(--shadow-sm); }
  .lead-card { padding: clamp(20px, 2.6vw, 30px); border-radius: var(--radius-xl); background: #fff; border: 1px solid var(--line); box-shadow: var(--shadow-lg); }
  .lead-tag { display: inline-block; padding: 5px 14px; border-radius: 100px; background: #000; color: var(--accent); font-family: var(--font-display); font-weight: 700; font-size: .8rem; letter-spacing: .14em; text-transform: uppercase; }
  .lead-card { color: var(--ink); }
  .lead-card h2 { color: var(--ink); margin-top: 12px; font-size: clamp(1.5rem, 2.4vw, 1.9rem); font-weight: 700; line-height: 1.1; }
  .lead-card .lead-sub { margin-top: 8px; font-size: .95rem; color: var(--muted); }
  .lead-steps { display: flex; gap: 8px; margin: 16px 0 6px; font-family: var(--font-display); font-size: .88rem; letter-spacing: .06em; text-transform: uppercase; }
  .lead-steps li { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: flex-start; gap: 5px; line-height: 1.2; padding: 10px 6px; border-radius: 10px; background: var(--paper); text-align: center; color: var(--muted); }
  @media (max-width: 420px) { .lead-steps { font-size: .76rem; letter-spacing: .02em; gap: 6px; } .lead-steps li { padding-inline: 2px; } }
  .lead-steps li b { display: grid; place-items: center; width: 22px; height: 22px; margin: 0; border-radius: 50%; background: var(--accent); color: #000; font-size: .78rem; }
  .lead-card :global(.df) { padding: 0; border: 0; box-shadow: none; background: transparent; }

  /* ---------- Perché CRM Hotellerie: tre blocchi orizzontali ---------- */
  .why3 { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; align-items: stretch; }
  @media (max-width: 980px) { .why3 { grid-template-columns: minmax(0, 1fr); max-width: 560px; margin-inline: auto; } }
  .why-card { display: flex; flex-direction: column; border-radius: var(--radius-xl); background: #fff; border: 1px solid var(--line); overflow: hidden; }
  .why-photo { aspect-ratio: 4 / 3; border-radius: 0; }
  .why-photo img { object-position: var(--pos, 50% 50%); }
  .why-body { display: flex; flex-direction: column; gap: 14px; padding: 26px 26px 30px; flex: 1; }
  .why-body .h3 { font-weight: 700; font-size: 1.5rem; line-height: 1.15; }
  .why-text { color: var(--muted); font-size: .98rem; }
  .why-body .check-list li { font-size: .93rem; }
  .why-body .link-arrow { margin-top: auto; align-self: flex-start; }

  /* ---------- La demo (lead magnet) ---------- */
  .unlock { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; margin-top: 34px; }
  @media (max-width: 980px) { .unlock { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 560px) { .unlock { grid-template-columns: minmax(0, 1fr); } }
  .unlock .card { padding: 22px; }
  .lockline { display: inline-flex; align-items: center; gap: 10px; margin-top: 22px; font-size: .92rem; color: rgba(255,255,255,.85); }
  .lockline :global(svg) { color: var(--accent); }

  /* ---------- Dashboard: schermate di configurazione ---------- */
  .cfg { position: relative; padding: 38px 24px 74px 18px; max-width: 100%; }
  .cfg-glow { position: absolute; inset: 0 -3% 4% 6%; border-radius: 36px; background: linear-gradient(140deg, var(--accent), #ffd52e 50%, rgba(114,112,112,.5)); transform: rotate(2.5deg); }
  .cfg figure { margin: 0; border-radius: 14px; overflow: hidden; background: #fff; border: 1px solid rgba(0,0,0,.14); box-shadow: 0 34px 70px -26px rgba(0,0,0,.55); }
  .cfg img { display: block; width: 100%; height: auto; }
  .cfg-main { position: relative; z-index: 1; width: 92%; transform: perspective(1800px) rotateY(3deg); transition: transform .5s var(--ease-out); }
  .cfg-side { position: absolute; z-index: 2; right: 0; bottom: 44px; width: 60%; transform: rotate(-2deg); border: 4px solid #fff !important; transition: transform .5s var(--ease-out); animation: cfg-float 6.5s ease-in-out infinite; }
  .cfg:hover .cfg-main { transform: perspective(1800px) rotateY(0); }
  .cfg-side:hover { transform: rotate(0) scale(1.05); animation-play-state: paused; }
  @keyframes cfg-float { 0%,100% { translate: 0 0; } 50% { translate: 0 -9px; } }
  .cfg-chrome { display: flex; align-items: center; gap: 6px; padding: 7px 12px; background: #1b1b1b; }
  .cfg-chrome i { width: 9px; height: 9px; border-radius: 50%; background: #444; } .cfg-chrome i:first-child { background: var(--accent); }
  .cfg-chrome span { margin-left: 8px; padding: 2px 12px; border-radius: 100px; background: #2c2c2c; color: rgba(255,255,255,.7); font-size: .68rem; }
  .cfg-badge { position: absolute; z-index: 3; display: inline-flex; align-items: center; gap: 7px; padding: 8px 14px; border-radius: 100px; background: #000; color: #fff; font-family: var(--font-display); font-size: .98rem; box-shadow: var(--shadow-lg); }
  .cfg-badge :global(svg) { color: var(--accent); }
  .cfg-b1 { left: 0; top: 6px; } .cfg-b2 { left: 6px; bottom: 40px; }
  .cfg-note { position: absolute; right: 24px; bottom: 14px; font-size: .72rem; color: var(--grey); }
  @media (max-width: 900px) {
    .cfg-badge { display: none; }
    .cfg { padding: 14px 0 6px; overflow: clip; }
    .cfg-main { transform: none; width: 100%; }
    .cfg .cfg-side { position: relative; right: auto; bottom: auto; width: 68%; margin: -30px 0 0 auto; transform: rotate(-1.5deg); animation: none; }
    .cfg .cfg-note { position: static; margin-top: 14px; text-align: center; }
    .cfg-glow { inset: 0 0 10% 4%; }
  }
  @media (prefers-reduced-motion: reduce) { .cfg-side { animation: none; } .cfg-main { transform: none; } }
  /* ---------- L'ospite al centro: scheda ospite d'esempio ---------- */
  .gcard { background: #fff; border: 1px solid var(--line); border-radius: var(--radius-xl); box-shadow: var(--shadow-lg); padding: clamp(20px, 2.6vw, 30px); }
  .gcard-head { display: flex; align-items: center; gap: 14px; padding-bottom: 16px; border-bottom: 1px solid var(--line); }
  .gcard-av { flex: none; width: 48px; height: 48px; border-radius: 50%; display: grid; place-items: center; background: #000; color: var(--accent); font-family: var(--font-display); font-weight: 700; letter-spacing: .04em; }
  .gcard-head div { display: grid; gap: 2px; min-width: 0; }
  .gcard-head b { font-size: 1.1rem; color: var(--ink); }
  .gcard-head div span { font-size: .88rem; color: var(--muted); }
  .gcard-seg { margin-left: auto; padding: 4px 12px; border-radius: 100px; background: var(--accent); color: #000; font-family: var(--font-display); font-weight: 700; font-size: .75rem; letter-spacing: .1em; text-transform: uppercase; }
  .gcard-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px 22px; margin-top: 18px; }
  .gcard-grid dt { font-family: var(--font-display); font-size: .74rem; letter-spacing: .1em; text-transform: uppercase; color: var(--muted); }
  .gcard-grid dd { margin: 3px 0 0; font-size: .95rem; line-height: 1.4; color: var(--ink); }
  .gcard-next { display: flex; gap: 10px; align-items: flex-start; margin-top: 18px; padding: 14px 16px; border-radius: var(--radius); background: var(--paper); font-size: .92rem; line-height: 1.45; color: var(--muted); }
  .gcard-next :global(svg) { flex: none; margin-top: 2px; color: var(--accent-700); }
  .gcard-next b { color: var(--ink); margin-right: 6px; }
  .gcard-note { margin-top: 12px; font-size: .8rem; color: var(--muted); text-align: right; }
  .uses { margin-top: clamp(36px, 5vw, 56px); }
  @media (max-width: 560px) { .gcard-grid { grid-template-columns: minmax(0, 1fr); } .gcard-seg { display: none; } }

  /* ---------- Chi fa cosa: ruoli, app della suite e voci di costo ---------- */
  .apps { margin-top: 32px; text-align: center; }
